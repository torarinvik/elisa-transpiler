# Minimal compiler capability probe: a custom Index result remains an
# assignable place when a field is projected from it.
include "../../elisa-transpiler-worktrees/transpiler/elisacore_std/elisacore_runtime.elisa"
include "../../elisa-transpiler-worktrees/transpiler/elisacore_std/collections.elisa"

struct Entry:
    value: mutable i64

struct Box[V]:
    entries: mutable Entry[4]

impl[V] Index for Box[V]:
    type Key = i64
    type Elem = Entry

    def __index__[@r](self: mutable Box[V]& @r, index: i64) -> Entry& @r:
        return &self.entries[index]

def main() -> i64:
    box: mutable Box[i64] = zeroed
    box[1].value <- 42
    return 0 if box[1].value == 42 else 1
