def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

struct Cell:
    value: mutable i64

def write_through(value: mutable Cell&?) -> void:
    elisa_nonnull(value).value <- 42

def main() -> i64:
    cell: mutable Cell = zeroed
    write_through(&cell)
    return cell.value
