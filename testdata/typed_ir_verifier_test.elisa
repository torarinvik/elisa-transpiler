include "../../elisa-transpiler-worktrees/transpiler/elisacore_std/elisacore_json.elisa"

module CTranslator:
    struct TypedIRVerifierTestModule:
        _unused: u8

include "../src/typed_source_map_types.elisa"
include "../src/clang_argv_options.elisa"
include "../src/clang_fp_options.elisa"
include "../src/typed_ir.elisa"
