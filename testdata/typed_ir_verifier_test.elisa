    def run_verifier_checks() -> i32 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        region verifier_arena(65536):
            parsed_null: JsonParseResult = json_parse_checked(&verifier_arena, sview("null", 0, -1))
