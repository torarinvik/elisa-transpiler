extend CTranslator:
    def typed_dump_test_contains(bytes: darray[u8], needle: sview) -> bool:
        return true if needle.len == 0
        return false if bytes.count.i64() < needle.len
        for start in 0..<(bytes.count.i64() - needle.len + 1) |bytes, needle|:
            same: mutable bool = true
            for offset in 0..<needle.len |bytes, needle, start, same|:
                same <- false if bytes[(start + offset).usize()] != string_view_index(needle, offset).u8()
            return true if same
        return false

    def typed_dump_test_equal(left: darray[u8], right: darray[u8]) -> bool:
        return false if left.count != right.count
        for index in 0..<left.count.i64() |left, right|:
            return false if left[index.usize()] != right[index.usize()]
        return true

    def typed_abi_test_append(output: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
        for index in 0..<text.len |output, text|:
            output.push(string_view_index(text, index).u8())

    def typed_fp_test_argv(arguments: sview, text: mutable darray[u8]&, offsets: mutable darray[usize]&) -> void can[Abort.Panic, Memory.Allocate]:
        offsets.push(0.usize()) can Memory.Allocate, Abort.Panic
        typed_abi_test_append(&text, sview("clang", 0, -1)) can Memory.Allocate, Abort.Panic
        text.push(0.u8()) can Memory.Allocate, Abort.Panic
        cursor: mutable i64 = 0
        while cursor < arguments.len |text, offsets, arguments, cursor|:
            while cursor < arguments.len and string_view_index(arguments, cursor) == 32 |cursor, arguments|:
                cursor <- cursor + 1
            break if cursor >= arguments.len
            offsets.push(text.count) can Memory.Allocate, Abort.Panic
            while cursor < arguments.len and string_view_index(arguments, cursor) != 32 |text, arguments, cursor|:
                text.push(string_view_index(arguments, cursor).u8()) can Memory.Allocate, Abort.Panic
                cursor <- cursor + 1
            text.push(0.u8()) can Memory.Allocate, Abort.Panic

    def typed_fp_test_options(arguments: sview) -> ClangFPOptionVector can[Abort.Panic, Memory.Allocate]:
        text: mutable darray[u8] = []
        offsets: mutable darray[usize] = []
        typed_fp_test_argv(arguments, &text, &offsets) can Abort.Panic, Memory.Allocate
        return clang_fp_options_from_argv(text, offsets)

    def typed_fp_test_normalized_options(normalized_arguments: sview, original_arguments: sview) -> ClangFPOptionVector can[Abort.Panic, Memory.Allocate]:
        normalized_text: mutable darray[u8] = []
        normalized_offsets: mutable darray[usize] = []
        original_text: mutable darray[u8] = []
        original_offsets: mutable darray[usize] = []
        typed_fp_test_argv(normalized_arguments, &normalized_text, &normalized_offsets) can Abort.Panic, Memory.Allocate
        typed_fp_test_argv(original_arguments, &original_text, &original_offsets) can Abort.Panic, Memory.Allocate
        return clang_fp_options_from_normalized_argv(normalized_text, normalized_offsets, original_text, original_offsets)

    def typed_fp_test_mode(arguments: sview) -> ClangFloatingPointMode can[Abort.Panic, Memory.Allocate]:
        options: ClangFPOptionVector = typed_fp_test_options(arguments)
        return options.mode

    def test_context[@r](root: JsonValueHandle[r]) -> TypedContext[r]:
        return test_context_with_language(root, false)

    def test_context_with_language[@r](root: JsonValueHandle[r], source_is_cxx: bool) -> TypedContext[r]:
        return TypedContext{
            exprs: [], expr_source_origins: [], expr_children: [], effect_expr_seen: [], effect_expr_pending: [], effect_expr_generation: 0,
            stmts: [], stmt_source_origins: [], generated_source_spans: [], stmt_children: [], params: [], current_name_aliases: [],
            type_aliases: [], current_declared_names: [], current_declared_scope_starts: [], current_nonnull_names: [], current_nonnull_exprs: [],
            extern_params: [], globals: [], functions: [], user_function_names: [], user_function_signatures: [],
            externs: [], extern_globals: [], fields: [], records: [], record_layouts: [], record_layout_field_offsets: [],
            specialized_types: [], packed_record_names: [], layout_unsupported_record_names: [], enums: [],
            enum_consts: [], labels: [], switch_cases: [], decl_infos: [], declaration_index: [], declaration_index_count: 0,
            break_scopes: [], switch_depth: 0,
            current_for_increment: -1, current_return_type: sview("", 0, 0), current_function_name: sview("", 0, 0), current_has_goto: false,
            current_emit_has_goto: false, current_structured_break_label: -1,
            current_emit_goto_name: sview("", 0, 0), current_switch_done_name: sview("", 0, 0),
            current_switch_done_index: -1, current_function_body: -1, current_trusted_depth: 0,
            needs_cpp_unordered_map: false, source_mapping_enabled: false, project_mode: false, initializer_name: sview("", 0, 0),
            mode: TypedTranslationMode.Idiomatic, floating_point_options: clang_fp_options_default(), target_abi: clang_target_abi_unknown(), source_language_is_cxx: source_is_cxx, source: "typed_ir_verifier_test",
            source_working_directory: sview("", 0, 0), canonical_source: sview("", 0, 0),
            root: root,
            diagnostics: []
        }

    def typed_ir_test_switch_context[@r](root: JsonValueHandle[r], mode: i64) -> TypedContext[r] can[Memory.Allocate, Abort.Panic]:
        context: mutable TypedContext = test_context(root)
        context.exprs.push(TypedExpr{
            kind: TypedExprKind.Integer, text: sview("0", 0, -1), type_name: sview("i32", 0, -1),
            lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0
        }) can Memory.Allocate, Abort.Panic
        context.stmts.push(TypedStmt{
            kind: TypedStmtKind.Null, expr: -1, aux: -1, aux2: -1, children_start: -1,
            children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)
        }) can Memory.Allocate, Abort.Panic
        case_count: i64 = 2 if mode == 0 or mode == 1 else 1
        context.stmts.push(TypedStmt{
            kind: TypedStmtKind.Switch, expr: 0, aux: -1, aux2: -1, children_start: 0,
            children_count: case_count, name: sview("", 0, 0), type_name: sview("", 0, 0)
        }) can Memory.Allocate, Abort.Panic
        if mode == 0:
            context.switch_cases.push(TypedSwitchCase{value: 0, body: 0, is_default: false, is_constant: true, constant_value: 0}) can Memory.Allocate, Abort.Panic
            context.switch_cases.push(TypedSwitchCase{value: -1, body: 0, is_default: true, is_constant: false, constant_value: 0}) can Memory.Allocate, Abort.Panic
        elif mode == 1:
            context.switch_cases.push(TypedSwitchCase{value: -1, body: 0, is_default: true, is_constant: false, constant_value: 0}) can Memory.Allocate, Abort.Panic
            context.switch_cases.push(TypedSwitchCase{value: -1, body: 0, is_default: true, is_constant: false, constant_value: 0}) can Memory.Allocate, Abort.Panic
        elif mode == 2:
            context.switch_cases.push(TypedSwitchCase{value: 0, body: 0, is_default: true, is_constant: false, constant_value: 0}) can Memory.Allocate, Abort.Panic
        else:
            context.switch_cases.push(TypedSwitchCase{value: -1, body: 0, is_default: false, is_constant: false, constant_value: 0}) can Memory.Allocate, Abort.Panic
        context.functions.push(TypedFunction{
            name: sview("switch_root", 0, -1), declaration_id: sview("", 0, 0), internal_linkage: false, link_name: sview("", 0, 0), return_type: sview("void", 0, -1),
            params_start: 0, params_count: 0, body: 1, variadic: false, has_global_effect: false,
            has_unsafe_effect: false, has_goto: false, label_count: 0, comment: sview("", 0, 0)
        }) can Memory.Allocate, Abort.Panic
        return context

    def typed_ir_test_call_context[@r](root: JsonValueHandle[r], call_mode: i64, callee: i64, signature_count: i64, external_count: i64) -> TypedContext[r] can[Memory.Allocate, Abort.Panic]:
        return typed_ir_test_call_context_with_language(root, call_mode, callee, signature_count, external_count, false) can Memory.Allocate, Abort.Panic

    def typed_ir_test_call_context_with_language[@r](root: JsonValueHandle[r], call_mode: i64, callee: i64, signature_count: i64, external_count: i64, source_is_cxx: bool) -> TypedContext[r] can[Memory.Allocate, Abort.Panic]:
        context: mutable TypedContext = test_context_with_language(root, source_is_cxx)
        if callee >= 0:
            context.exprs.push(TypedExpr{
                kind: TypedExprKind.Name, text: sview("callback", 0, -1), type_name: sview("i32 (*)(i32)", 0, -1),
                lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0
            }) can Memory.Allocate, Abort.Panic
        call_index: i64 = context.exprs.count.i64()
        context.exprs.push(TypedExpr{
            kind: TypedExprKind.Call, text: sview("target", 0, -1), type_name: sview("i32", 0, -1),
            lhs: callee, rhs: -1, third: -1, args_start: -1, args_count: 0, value: call_mode
        }) can Memory.Allocate, Abort.Panic
        context.stmts.push(TypedStmt{
            kind: TypedStmtKind.Expression, expr: call_index, aux: -1, aux2: -1, children_start: -1,
            children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)
        }) can Memory.Allocate, Abort.Panic
        context.functions.push(TypedFunction{
            name: sview("call_root", 0, -1), declaration_id: sview("", 0, 0), internal_linkage: false, link_name: sview("", 0, 0), return_type: sview("void", 0, -1),
            params_start: 0, params_count: 0, body: 0, variadic: false, has_global_effect: false,
            has_unsafe_effect: false, has_goto: false, label_count: 0, comment: sview("", 0, 0)
        }) can Memory.Allocate, Abort.Panic
        for signature_index in 0..<signature_count |context|:
            target_id: sview = sview("target-id-1", 0, -1) if signature_index == 1 else sview("target-id-0", 0, -1)
            target_body: i64 = context.stmts.count.i64()
            context.stmts.push(TypedStmt{
                kind: TypedStmtKind.Null, expr: -1, aux: -1, aux2: -1, children_start: -1,
                children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)
            }) can Memory.Allocate, Abort.Panic
            target_function_index: i64 = context.functions.count.i64()
            context.functions.push(TypedFunction{
                name: sview("target", 0, -1), declaration_id: target_id, internal_linkage: false, link_name: sview("", 0, 0),
                return_type: sview("i32 (void)", 0, -1), params_start: 0, params_count: 0, body: target_body,
                variadic: false, has_global_effect: false, has_unsafe_effect: false, has_goto: false,
                label_count: 0, comment: sview("", 0, 0)
            }) can Memory.Allocate, Abort.Panic
            context.user_function_signatures.push(TypedUserFunctionSignature{
                name: sview("target", 0, -1), type_name: sview("i32 (void)", 0, -1), result_type: sview("i32", 0, -1), declaration_id: target_id,
                function_index: target_function_index, params_count: 0, variadic: false
            }) can Memory.Allocate, Abort.Panic
        for external_index in 0..<external_count |context|:
            context.externs.push(TypedExtern{
                name: sview("target", 0, -1), link_name: sview("target", 0, -1), declaration_id: sview("", 0, 0), return_type: sview("i32 (void)", 0, -1), result_type: sview("i32", 0, -1),
                params_start: 0, params_count: 0, variadic: false
            }) can Memory.Allocate, Abort.Panic
        return context

    def typed_ir_test_configure_user_arity[@r](context: mutable TypedContext[r]&, parameter_count: i64, variadic: bool) -> void can[Memory.Allocate, Abort.Panic]:
        signature: TypedUserFunctionSignature = context.user_function_signatures[0]
        function_index: i64 = signature.function_index
        function: TypedFunction = context.functions[function_index.usize()]
        updated_function: TypedFunction = TypedFunction{
            name: function.name, declaration_id: function.declaration_id, internal_linkage: function.internal_linkage,
            link_name: function.link_name, return_type: function.return_type, params_start: context.params.count.i64(),
            params_count: parameter_count, body: function.body, variadic: variadic,
            has_global_effect: function.has_global_effect, has_unsafe_effect: function.has_unsafe_effect,
            has_goto: function.has_goto, label_count: function.label_count, comment: function.comment
        }
        for parameter_index in 0..<parameter_count |context|:
            context.params.push(TypedParam{name: sview("p", 0, -1), type_name: sview("i32", 0, -1), is_mutable: false}) can Memory.Allocate, Abort.Panic
        context.functions[function_index.usize()] <- updated_function
        context.user_function_signatures[0] <- TypedUserFunctionSignature{
            name: signature.name, type_name: signature.type_name, result_type: signature.result_type, declaration_id: signature.declaration_id,
            function_index: signature.function_index, params_count: parameter_count, variadic: variadic
        }

    def typed_ir_test_set_call_argument_count[@r](context: mutable TypedContext[r]&, argument_count: i64) -> void can[Memory.Allocate, Abort.Panic]:
        call_index: mutable i64 = -1
        for index in 0..<context.exprs.count.i64() |context, call_index|:
            if context.exprs[index.usize()].kind == TypedExprKind.Call:
                call_index <- index
                break
        return if call_index < 0
        args_start: i64 = context.expr_children.count.i64()
        for _index in 0..<argument_count |context|:
            argument_index: i64 = context.exprs.count.i64()
            context.exprs.push(TypedExpr{
                kind: TypedExprKind.Integer, text: sview("1", 0, -1), type_name: sview("i32", 0, -1),
                lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 1
            }) can Memory.Allocate, Abort.Panic
            context.expr_children.push(argument_index) can Memory.Allocate, Abort.Panic
        context.exprs[call_index.usize()].args_start <- args_start if argument_count > 0
        context.exprs[call_index.usize()].args_start <- -1 if argument_count == 0
        context.exprs[call_index.usize()].args_count <- argument_count

    def typed_ir_test_set_indirect_signature[@r](context: mutable TypedContext[r]&, function_type: sview, argument_count: i64) -> void can[Memory.Allocate, Abort.Panic]:
        for index in 0..<context.exprs.count.i64() |context, function_type|:
            if context.exprs[index.usize()].kind == TypedExprKind.Name:
                context.exprs[index.usize()].type_name <- function_type
                break
        typed_ir_test_set_call_argument_count(context, argument_count) can Memory.Allocate, Abort.Panic

