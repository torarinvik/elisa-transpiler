include "../src/.compiler_std/elisacore_runtime.elisa"

module CTranslator:
    struct ClangTypeShapeTestModule:
        _unused: u8

include "../src/clang_type_shape.elisa"

extend CTranslator:
    def clang_type_shape_expect(spelling: sview, pointer_count: i64, first_pointer_operator: i64, is_function_pointer: bool, is_pointer_to_array: bool, qualifier_depth: i64, qualifier_mask: i64) -> bool:
        shape: ClangTypeSpellingShape = clang_type_spelling_shape(spelling)
        return shape.pointer_count == pointer_count and shape.first_pointer_operator == first_pointer_operator and shape.is_function_pointer == is_function_pointer and shape.is_pointer_to_array == is_pointer_to_array and shape.delimiters_balanced and clang_type_pointer_qualifiers_at_depth(spelling, shape, qualifier_depth) == qualifier_mask

    def run_clang_type_shape_checks() -> i32 can[Console]:
        return 1 if not clang_type_shape_expect(sview("const Widget *", 0, -1), 1, 13, false, false, 0, 1)
        return 2 if not clang_type_shape_expect(sview("std::unordered_map<int, Widget *>", 0, -1), 0, -1, false, false, 0, 0)
        return 3 if not clang_type_shape_expect(sview("std::vector<Widget *> * const", 0, -1), 1, 22, false, false, 1, 1)
        return 8 if not sview_eq(clang_type_pointer_base(sview("std::vector<Widget *> * const", 0, -1)), sview("std::vector<Widget *> ", 0, -1))
        return 9 if not sview_eq(clang_type_pointer_base(sview("std::unordered_map<int, Widget *>", 0, -1)), sview("std::unordered_map<int, Widget *>", 0, -1))
        return 4 if not clang_type_shape_expect(sview("void (Widget *)", 0, -1), 0, -1, false, false, 0, 0)
        return 5 if not clang_type_shape_expect(sview("void *(* const)(Widget *)", 0, -1), 2, 5, true, false, 2, 1)
        return 6 if not clang_type_shape_expect(sview("int (* const *)[4]", 0, -1), 2, 5, false, true, 1, 1)
        return 7 if not clang_type_shape_expect(sview("void (**)(Widget *)", 0, -1), 2, 6, true, false, 0, 0)
        print("Clang declarator-shape checks passed\n")
        return 0

def main() -> i32 can[Console]:
    return CTranslator::run_clang_type_shape_checks() can Console
