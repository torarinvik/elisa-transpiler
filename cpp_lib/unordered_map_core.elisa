# Translator-owned compatibility layer for the subset of C++ unordered_map
# currently lowered by the C++ frontend. This file intentionally has no
# compiler-worktree includes. The translator emits explicit runtime and
# collections dependencies before including this core when relocatable support
# directories are selected.

module cpp:
    struct unordered_map_entry[V]:
        value: mutable V

    struct unordered_map[K, V]:
        storage: mutable dict[K, unordered_map_entry[V]]

    struct unordered_map_iterator[K, V]:
        owner: mutable unordered_map[K, V]&
        key_value: K?
        is_end: bool

    def nonnull[T](value: mutable T&?) -> mutable T&:
        if value == null:
            can Abort.Panic:
                panic("unordered_map: expected an existing entry")
        return value

    impl[K, V] Index for unordered_map[K, V]:
        type Key = K
        type Elem = unordered_map_entry[V]

        def __index__(self: mutable unordered_map[K, V]&, key: K) -> unordered_map_entry[V]&:
            # The translator permits this adapter only for scalar/nullable
            # pointer V, where C++ value-initialization is exactly all-zero.
            # Store V inside a non-null entry wrapper so nullable pointers are
            # ordinary fields instead of optional dictionary element refs.
            existing: mutable unordered_map_entry[V]&? = arena_dict_get_mut(self.storage, key)
            return nonnull(existing) if existing != null
            can Memory.Allocate, Abort.Panic:
                # The C++ frontend only instantiates operator[] for mapped types
                # whose value-initialized representation is all-zero. Read the
                # value from the zeroed heap slot: arena_box_zeroed[V] returns a
                # reference to storage, not a zero-valued V. Keeping the index
                # operation explicit also prevents a niche optional V from being
                # mistaken for that storage pointer by reference-return lowering.
                initial_value: V = arena_box_zeroed[V](&perm_arena)[0]
                initial_entry: unordered_map_entry[V] = unordered_map_entry[V]{value: initial_value}
                entry: mutable unordered_map_entry[V]&? = arena_dict_put_or_panic(&perm_arena, self.storage, key, initial_entry)
                return nonnull(entry)

    def clear[K, V](self: mutable unordered_map[K, V]&):
        self.storage.clear()

    def size[K, V](self: unordered_map[K, V]&) -> usize:
        return self.storage.count

    def empty[K, V](self: unordered_map[K, V]&) -> bool:
        return self.storage.count == 0.usize()

    def contains[K, V](self: unordered_map[K, V]&, key: K) -> bool:
        return arena_dict_contains(self.storage, key)

    def count[K, V](self: unordered_map[K, V]&, key: K) -> usize:
        return 1.usize() if contains(self, key) else 0.usize()

    def erase[K, V](self: mutable unordered_map[K, V]&, key: K) -> usize:
        return 1.usize() if arena_dict_remove(self.storage, key) else 0.usize()

    # The adapter keeps the map and key, rather than an address into the
    # dictionary's open-addressed storage. A dictionary growth can therefore
    # relocate slots without leaving an iterator with a stale slot pointer.
    # As in C++, erasing the pointed-to element invalidates that iterator.
    def find[K, V](self: mutable unordered_map[K, V]&, key: K) -> unordered_map_iterator[K, V]:
        found: bool = contains(self, key)
        return unordered_map_iterator[K, V]{owner: self, key_value: key, is_end: not found}

    def end[K, V](self: mutable unordered_map[K, V]&) -> unordered_map_iterator[K, V]:
        return unordered_map_iterator[K, V]{owner: self, key_value: null, is_end: true}

    def first[K, V](self: unordered_map_iterator[K, V]&) -> K:
        match self.key_value:
            null:
                can Abort.Panic:
                    panic("unordered_map: dereferenced end iterator")
            key:
                return key

    # Reads return a value so generated comparisons never expose an interior
    # dictionary reference. The translator lowers C++ `it->second = value` to
    # `set_second`, retaining writes without depending on reference-valued call
    # results in the stage-1 backend.
    def second[K, V](self: unordered_map_iterator[K, V]&) -> V:
        key: K = first(self)
        entry: unordered_map_entry[V]&? = arena_dict_get(self.owner.storage, key)
        return nonnull(entry).value

    def set_second[K, V](self: mutable unordered_map_iterator[K, V]&, value: V) -> V:
        key: K = first(self)
        entry: mutable unordered_map_entry[V]& = nonnull(arena_dict_get_mut(self.owner.storage, key))
        entry.value <- value
        return value

    impl[K, V] Eq for unordered_map_iterator[K, V]:
        def __eq__(self: unordered_map_iterator[K, V], other: unordered_map_iterator[K, V]) -> bool:
            if self.is_end or other.is_end:
                return self.is_end and other.is_end
            self_key: K = first(self)
            other_key: K = first(other)
            return self_key == other_key
