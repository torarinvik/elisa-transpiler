# Translator-owned compatibility layer for the subset of C++ unordered_map
# currently lowered by the C++ frontend. This file intentionally has no
# compiler-worktree includes. The translator emits explicit runtime and
# collections dependencies before including this core when relocatable support
# directories are selected.

module cpp:
    struct unordered_map_value_slot[V]:
        # Erased slots stay in value_arena until clear. A later insertion gets
        # a fresh zero-initialized slot instead of trying to assign `zeroed`
        # to unconstrained V, which may be a non-null reference type according
        # to the language's generic type checker even when this adapter's
        # supported source values are zero-initializable scalars or pointers.
        value: mutable V

    struct unordered_map_entry[V]:
        # Dictionary buckets move when the table grows. Keep mapped objects in
        # arena-owned storage so operator[] references survive rehashing, as
        # required by std::unordered_map.
        slot: mutable heap unordered_map_value_slot[V]&

    struct unordered_map[K, V]:
        storage: mutable dict[K, unordered_map_entry[V]]
        value_arena: mutable Arena

    struct unordered_map_iterator[K, V]:
        owner: mutable unordered_map[K, V]&
        key_value: K?
        is_end: bool

    struct unordered_map_const_iterator[K, V]:
        owner: unordered_map[K, V]&
        key_value: K?
        is_end: bool

    def nonnull[T](value: mutable T&?) -> mutable T&:
        if value == null:
            can Abort.Panic:
                panic("unordered_map: expected an existing entry")
        return value

    def nonnull_readonly[T](value: T&?) -> T&:
        if value == null:
            can Abort.Panic:
                panic("unordered_map: expected an existing entry")
        return value

    impl[K, V] Index for unordered_map[K, V]:
        type Key = K
        type Elem = unordered_map_entry[V]

        def __index__(self: mutable unordered_map[K, V]&, key: K) -> unordered_map_entry[V]&:
            # The translator permits this adapter only for scalar/nullable
            # pointer V, where C++ value-initialization is exactly all-zero.
            # Store V inside a non-null entry wrapper so nullable pointers are
            # ordinary fields instead of optional dictionary element refs.
            existing: mutable unordered_map_entry[V]&? = arena_dict_get_mut(self.storage, key)
            return nonnull(existing) if existing != null
            can Memory.Allocate, Abort.Panic:
                # `operator[]` returns V&, and that address must remain stable
                # when dictionary buckets rehash. Erase invalidates the C++
                # reference, so keep old slots arena-owned until clear and
                # allocate a fresh zero-initialized slot for a later insert.
                initial_value: mutable heap unordered_map_value_slot[V]& = arena_box_zeroed[unordered_map_value_slot[V]](&self.value_arena)
                initial_entry: unordered_map_entry[V] = unordered_map_entry[V]{slot: initial_value}
                entry: mutable unordered_map_entry[V]&? = arena_dict_put_or_panic(&perm_arena, self.storage, key, initial_entry)
                return nonnull(entry)

    def clear[K, V](self: mutable unordered_map[K, V]&):
        self.storage.clear()
        arena_reset(&self.value_arena)

    def size[K, V](self: unordered_map[K, V]&) -> usize:
        return self.storage.count

    def empty[K, V](self: unordered_map[K, V]&) -> bool:
        return self.storage.count == 0.usize()

    def contains[K, V](self: unordered_map[K, V]&, key: K) -> bool:
        return arena_dict_contains(self.storage, key)

    def count[K, V](self: unordered_map[K, V]&, key: K) -> usize:
        return 1.usize() if contains(self, key) else 0.usize()

    def erase[K, V](self: mutable unordered_map[K, V]&, key: K) -> usize:
        entry: mutable unordered_map_entry[V]&? = arena_dict_get_mut(self.storage, key)
        return 0.usize() if entry == null
        arena_dict_remove(self.storage, key)
        return 1.usize()

    # The adapter keeps the map and key, rather than an address into the
    # dictionary's open-addressed storage. A dictionary growth can therefore
    # relocate slots without leaving an iterator with a stale slot pointer.
    # As in C++, erasing the pointed-to element invalidates that iterator.
    def find[K, V](self: mutable unordered_map[K, V]&, key: K) -> unordered_map_iterator[K, V]:
        found: bool = contains(self, key)
        return unordered_map_iterator[K, V]{owner: self, key_value: key, is_end: not found}

    def end[K, V](self: mutable unordered_map[K, V]&) -> unordered_map_iterator[K, V]:
        return unordered_map_iterator[K, V]{owner: self, key_value: null, is_end: true}

    # Read-only overloads preserve std::unordered_map's const_iterator result
    # instead of weakening a const receiver into the mutable iterator above.
    def find[K, V](self: unordered_map[K, V]&, key: K) -> unordered_map_const_iterator[K, V]:
        found: bool = contains(self, key)
        return unordered_map_const_iterator[K, V]{owner: self, key_value: key, is_end: not found}

    def end[K, V](self: unordered_map[K, V]&) -> unordered_map_const_iterator[K, V]:
        return unordered_map_const_iterator[K, V]{owner: self, key_value: null, is_end: true}

    # The C++ frontend calls these uniquely named overloads directly. Elisa's
    # overloaded member selection does not always preserve a const receiver
    # after C++ lvalue-to-rvalue casts, so lowering selects the return type
    # from Clang's canonical receiver type.
    def unordered_map_find_mutable[K, V](self: mutable unordered_map[K, V]&, key: K) -> unordered_map_iterator[K, V]:
        found: bool = contains(self, key)
        return unordered_map_iterator[K, V]{owner: self, key_value: key, is_end: not found}

    def unordered_map_find_const[K, V](self: unordered_map[K, V]&, key: K) -> unordered_map_const_iterator[K, V]:
        found: bool = contains(self, key)
        return unordered_map_const_iterator[K, V]{owner: self, key_value: key, is_end: not found}

    def unordered_map_end_mutable[K, V](self: mutable unordered_map[K, V]&) -> unordered_map_iterator[K, V]:
        return unordered_map_iterator[K, V]{owner: self, key_value: null, is_end: true}

    def unordered_map_end_const[K, V](self: unordered_map[K, V]&) -> unordered_map_const_iterator[K, V]:
        return unordered_map_const_iterator[K, V]{owner: self, key_value: null, is_end: true}

    def first[K, V](self: unordered_map_iterator[K, V]&) -> K:
        match self.key_value:
            null:
                can Abort.Panic:
                    panic("unordered_map: dereferenced end iterator")
            key:
                return key

    # Reads return a value so generated comparisons never expose an interior
    # dictionary reference. The translator lowers C++ `it->second = value` to
    # `set_second`, retaining writes without depending on reference-valued call
    # results in the stage-1 backend.
    def second[K, V](self: unordered_map_iterator[K, V]&) -> V:
        match self.key_value:
            null:
                can Abort.Panic:
                    panic("unordered_map: dereferenced end iterator")
            key:
                entry: unordered_map_entry[V]&? = arena_dict_get(self.owner.storage, key)
                return nonnull(entry).slot.value

    def first[K, V](self: unordered_map_const_iterator[K, V]&) -> K:
        match self.key_value:
            null:
                can Abort.Panic:
                    panic("unordered_map: dereferenced end iterator")
            key:
                return key

    def second[K, V](self: unordered_map_const_iterator[K, V]&) -> V:
        match self.key_value:
            null:
                can Abort.Panic:
                    panic("unordered_map: dereferenced end iterator")
            key:
                entry: unordered_map_entry[V]&? = arena_dict_get(self.owner.storage, key)
                return nonnull_readonly(entry).slot.value

    # The C++ frontend lowers iterator comparisons to these explicitly named
    # helpers. Keeping the four operand shapes separate avoids relying on
    # overloaded Eq methods for the two distinct mutable/const iterator types.
    def unordered_map_iter_equal_fields[K](left_key: K?, left_end: bool, right_key: K?, right_end: bool) -> bool:
        if left_end or right_end:
            return left_end and right_end
        match left_key:
            null:
                return false
            left:
                match right_key:
                    null:
                        return false
                    right:
                        return left == right

    def unordered_map_iter_equal_mut_mut[K, V](left: unordered_map_iterator[K, V], right: unordered_map_iterator[K, V]) -> bool:
        return unordered_map_iter_equal_fields(left.key_value, left.is_end, right.key_value, right.is_end)

    def unordered_map_iter_equal_mut_const[K, V](left: unordered_map_iterator[K, V], right: unordered_map_const_iterator[K, V]) -> bool:
        return unordered_map_iter_equal_fields(left.key_value, left.is_end, right.key_value, right.is_end)

    def unordered_map_iter_equal_const_mut[K, V](left: unordered_map_const_iterator[K, V], right: unordered_map_iterator[K, V]) -> bool:
        return unordered_map_iter_equal_fields(left.key_value, left.is_end, right.key_value, right.is_end)

    def unordered_map_iter_equal_const_const[K, V](left: unordered_map_const_iterator[K, V], right: unordered_map_const_iterator[K, V]) -> bool:
        return unordered_map_iter_equal_fields(left.key_value, left.is_end, right.key_value, right.is_end)

    def set_second[K, V](self: mutable unordered_map_iterator[K, V]&, value: V) -> V:
        key: K = first(self)
        entry: mutable unordered_map_entry[V]& = nonnull(arena_dict_get_mut(self.owner.storage, key))
        entry.slot.value <- value
        return value

    impl[K, V] Eq for unordered_map_iterator[K, V]:
        def __eq__(self: unordered_map_iterator[K, V], other: unordered_map_iterator[K, V]) -> bool:
            if self.is_end or other.is_end:
                return self.is_end and other.is_end
            match self.key_value:
                null:
                    return false
                self_key:
                    match other.key_value:
                        null:
                            return false
                        other_key:
                            return self_key == other_key

        # C++ permits comparing iterator and const_iterator values from the
        # same container. Keep both operand orders explicit because Elisa
        # overload resolution does not synthesize a converting constructor.
        def __eq__(self: unordered_map_iterator[K, V], other: unordered_map_const_iterator[K, V]) -> bool:
            if self.is_end or other.is_end:
                return self.is_end and other.is_end
            match self.key_value:
                null:
                    return false
                self_key:
                    match other.key_value:
                        null:
                            return false
                        other_key:
                            return self_key == other_key

    impl[K, V] Eq for unordered_map_const_iterator[K, V]:
        def __eq__(self: unordered_map_const_iterator[K, V], other: unordered_map_const_iterator[K, V]) -> bool:
            if self.is_end or other.is_end:
                return self.is_end and other.is_end
            match self.key_value:
                null:
                    return false
                self_key:
                    match other.key_value:
                        null:
                            return false
                        other_key:
                            return self_key == other_key

        def __eq__(self: unordered_map_const_iterator[K, V], other: unordered_map_iterator[K, V]) -> bool:
            if self.is_end or other.is_end:
                return self.is_end and other.is_end
            match self.key_value:
                null:
                    return false
                self_key:
                    match other.key_value:
                        null:
                            return false
                        other_key:
                            return self_key == other_key
