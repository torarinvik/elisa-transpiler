        source_hash: u64 = hash_sview(identity) & 0x7fffffffffffffff
        target_hash: u64 = hash_sview(target_type) & 0x7fffffffffffffff
        value_hash: u64 = hash_sview(value_type) & 0x7fffffffffffffff
