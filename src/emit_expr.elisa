extend CTranslator:
    def typed_expr_at(ctx: TypedContext&, index: i64) -> TypedExpr:
        return ctx.exprs[index.usize()]

    def typed_stmt_at(ctx: TypedContext&, index: i64) -> TypedStmt:
        return ctx.stmts[index.usize()]

    def append_qualified(out: mutable darray[u8]&, namespace: sview, name: sview) -> void:
        append_view(out, namespace)
        append_view(out, sview(".", 0, -1))
        append_view(out, name)

    def typed_emit_source_name(out: mutable darray[u8]&, ctx: TypedContext&, name: sview) -> void:
        for index in 0..<ctx.current_name_aliases.count |out, ctx, name|:
            alias: TypedNameAlias = ctx.current_name_aliases[index.usize()]
            if sview_eq(alias.source, name):
                append_view(out, name)
                append_view(out, alias.suffix)
                return
        append_view(out, name)

    def typed_nonnull_supported(qual_type: sview) -> bool:
        return not c_type_is_function(qual_type) and sview_find_byte(qual_type, 42) >= 0 and c_type_pointer_optional(qual_type)

    def typed_emit_nonnull_expr(out: mutable darray[u8]&, ctx: TypedContext&, index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        # Branch-local facts allow call arguments to avoid unnecessary defensive
        # casts, but Elisa still requires a non-null type at an indexing/member
        # boundary. Keep the checked helper at that boundary instead of emitting
        # a nullable reference as if the source type had been refined in place.
        # Only values whose emitted shape is a normal Elisa reference can use the
        # generic helper. Cast nodes may already carry an ABI-specific shape, so
        # wrapping those nodes can still be an invalid conversion.
        if typed_nonnull_supported(expression.type_name) and (expression.kind == TypedExprKind.Name or expression.kind == TypedExprKind.Member or expression.kind == TypedExprKind.Call or expression.kind == TypedExprKind.Cast or expression.kind == TypedExprKind.Null):
            if not c_type_is_const_pointer(expression.type_name):
                append_view(out, sview("elisa_nonnull(", 0, -1))
                typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(")", 0, -1))
            else:
                append_view(out, sview("elisa_nonnull_readonly(", 0, -1))
                typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(")", 0, -1))
        else:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_emit_pointer_address(out: mutable darray[u8]&, ctx: TypedContext&, index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        # Optional references already carry their nullable address. Comparing
        # that representation directly avoids a non-null assertion helper on
        # every side of ordinary C pointer equality and ordering expressions.
        expression: TypedExpr = typed_expr_at(ctx, index)
        is_null: bool = typed_expr_is_null_value(ctx, index)
        if is_null:
            append_view(out, sview("0", 0, -1))
        else:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(".cast[uintptr]", 0, -1))

    def typed_emit_initializer_value(out: mutable darray[u8]&, ctx: TypedContext&, index: i64, target_type: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        if c_type_is_function_pointer(target_type):
            typed_emit_function_pointer_storage_value(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        if c_type_is_array(target_type) and expression.kind == TypedExprKind.Aggregate and expression.args_count == 0:
            append_view(out, sview("zeroed", 0, -1))
            return
        element_type: sview = c_type_without_qualifiers(string_view_prefix(target_type, sview_find_byte(target_type, 91))) if c_type_is_array(target_type) else sview("", 0, 0)
        if expression.kind == TypedExprKind.String and c_type_is_array(target_type) and (sview_starts_with(element_type, sview("char", 0, -1)) or sview_starts_with(element_type, sview("unsigned char", 0, -1))):
            append_c_string_array(out, expression.text, target_type)
        else:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_emit_function_pointer_storage_value(out: mutable darray[u8]&, ctx: TypedContext&, index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        if expression.kind == TypedExprKind.Null:
            append_view(out, sview("null", 0, -1))
            return
        # Function values and nullable function fields now share a first-class
        # typed representation; no opaque pointer conversion is required.
        typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_emit_binary_value(out: mutable darray[u8]&, ctx: TypedContext&, index: i64, other_index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        # Clang represents C's integer truth values and `_Bool` constants with
        # different types. Elisa keeps those types distinct, so materialize a
        # boolean operand as 0/1 whenever it participates in a non-logical C
        # operator (comparisons, arithmetic, and bit operations).
        expression: TypedExpr = typed_expr_at(ctx, index)
        other: TypedExpr = typed_expr_at(ctx, other_index)
        if (c_type_is_enum(expression.type_name) or expression.value == 2) and c_type_is_integer(other.type_name):
            append_view(out, sview("(", 0, -1))
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(").i32()", 0, -1))
            return
        arithmetic_type: sview = c_type_usual_arithmetic_type(expression.type_name, other.type_name) if c_type_is_integer(expression.type_name) and c_type_is_integer(other.type_name) else sview("", 0, 0)
        if arithmetic_type.len > 0 and not sview_eq(c_type_abi_base(expression.type_name), arithmetic_type):
            append_view(out, sview("(", 0, -1))
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(").", 0, -1))
            append_view(out, arithmetic_type)
            append_view(out, sview("()", 0, -1))
        elif typed_expr_is_boolean(ctx, index) and not typed_expr_is_boolean(ctx, other_index):
            append_view(out, sview("(1 if ", 0, -1))
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(" else 0)", 0, -1))
        else:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_emit_nested_pointer_value(out: mutable darray[u8]&, ctx: TypedContext&, index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        # A C `char **` is represented as `cstr&&`. Optional nested references
        # must be narrowed/cast before indexing; the cast preserves the pointer
        # value and does not turn the pointed-to string into a byte.
        nested_type: sview = sview("cstr", 0, -1) if c_type_is_const_pointer(typed_expr_at(ctx, index).type_name) else sview("u8", 0, -1)
        if c_type_pointer_optional(typed_expr_at(ctx, index).type_name):
            if typed_expr_can_pass_mutable(ctx, index):
                append_view(out, sview("elisa_nonnull(", 0, -1))
                typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(")", 0, -1))
            else:
                append_view(out, sview("elisa_nonnull((", 0, -1))
                typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(").cast[mutable ", 0, -1))
                append_c_type(out, typed_expr_at(ctx, index).type_name)
                append_view(out, sview("?", 0, -1))
                append_view(out, sview("])", 0, -1))
        else:
            append_view(out, sview("(", 0, -1))
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(").cast[mutable ", 0, -1))
            append_view(out, nested_type)
            append_view(out, sview("]", 0, -1))

    def typed_is_nested_pointer_slot(ctx: TypedContext&, index: i64) -> bool:
        expression: TypedExpr = typed_expr_at(ctx, index)
        return false if expression.kind != TypedExprKind.ArrayIndex
        base: TypedExpr = typed_expr_at(ctx, expression.lhs)
        return false if c_type_pointer_count(base.type_name) < 2 or not c_type_is_char_pointer(base.type_name)
        zero: TypedExpr = typed_expr_at(ctx, expression.rhs)
        return zero.kind == TypedExprKind.Integer and sview_eq(zero.text, sview("0", 0, -1))

    def typed_expr_is_nested_char_index(ctx: TypedContext&, index: i64) -> bool:
        expression: TypedExpr = typed_expr_at(ctx, index)
        return false if expression.kind != TypedExprKind.ArrayIndex
        base: TypedExpr = typed_expr_at(ctx, expression.lhs)
        return c_type_pointer_count(base.type_name) >= 2 and c_type_is_char_pointer(base.type_name)

    def typed_expr_is_address_of_pointer(ctx: TypedContext&, index: i64) -> bool:
        expression: TypedExpr = typed_expr_at(ctx, index)
        return true if expression.kind == TypedExprKind.Unary and sview_eq(expression.text, sview("&", 0, -1))
        return typed_expr_is_address_of_pointer(ctx, expression.lhs) if expression.kind == TypedExprKind.Cast else false

    def typed_expr_is_string_value(ctx: TypedContext&, index: i64) -> bool:
        expression: TypedExpr = typed_expr_at(ctx, index)
        return true if expression.kind == TypedExprKind.String
        return typed_expr_is_string_value(ctx, expression.lhs) if expression.kind == TypedExprKind.Cast else false

    def typed_expr_is_array_decay_value(ctx: TypedContext&, index: i64) -> bool:
        expression: TypedExpr = typed_expr_at(ctx, index)
        return expression.kind == TypedExprKind.Cast and c_type_is_array(typed_expr_at(ctx, expression.lhs).type_name)

    def typed_emit_nested_pointer_slot_target(out: mutable darray[u8]&, ctx: TypedContext&, index: i64, level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        # A C pointer-to-pointer assignment stores a pointer in the pointed-to
        # slot. Elisa's ordinary nested-reference index is a reference to the
        # pointed-to bytes, so bind the raw slot address to a local view first.
        # The local is important: a cast expression itself is not assignable in
        # Elisa, while a mutable view is.
        append_indent(out, level)
        root_name: sview = typed_expr_root_name(ctx, expression.lhs)
        append_view(out, sview("pointer_slot_", 0, -1))
        append_view(out, root_name) if root_name.len > 0 else append_view(out, sview("value", 0, -1))
        append_view(out, sview("_", 0, -1))
        append_i64(out, index)
        append_view(out, sview(": mutable void&? = ", 0, -1))
        if c_type_pointer_optional(typed_expr_at(ctx, expression.lhs).type_name):
            append_view(out, sview("(elisa_nonnull(", 0, -1))
            typed_emit_expr(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(")).cast[mutable void&?]", 0, -1))
        else:
            append_view(out, sview("(", 0, -1))
            typed_emit_expr(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(").cast[mutable void&?]", 0, -1))
        append_view(out, sview("\n", 0, -1))
        append_indent(out, level)
        append_view(out, sview("pointer_slot_", 0, -1))
        append_view(out, root_name) if root_name.len > 0 else append_view(out, sview("value", 0, -1))
        append_view(out, sview("_", 0, -1))
        append_i64(out, index)

    def typed_emit_nested_pointer_slot_value(out: mutable darray[u8]&, ctx: TypedContext&, index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        if expression.kind == TypedExprKind.Null:
            append_view(out, sview("null", 0, -1))
            return
        append_view(out, sview("(", 0, -1))
        typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(").cast[mutable void&?]", 0, -1))

    def c_type_call_compatible(argument_type: sview, target_type: sview) -> bool:
        argument_pointer: bool = sview_find_byte(argument_type, 42) >= 0
        target_pointer: bool = sview_find_byte(target_type, 42) >= 0
        if argument_pointer or target_pointer:
            return false if not argument_pointer or not target_pointer or c_type_pointer_count(argument_type) != c_type_pointer_count(target_type)
            # Calls need the exact nested pointee spelling.  `char **` and
            # `unsigned char **`, for example, have different Elisa reference
            # shapes even though their final address is ABI-compatible.  The
            # explicit-cast emitter may still use c_type_abi_base when it has
            # enough context to prove a one-level cast is redundant.
            argument_base: sview = c_type_named_base(argument_type)
            target_base: sview = c_type_named_base(target_type)
            # Clang exposes `char *` and `unsigned char *` as distinct C
            # types, while this translator intentionally maps both to Elisa's
            # byte-reference representation. Permit that one-level ABI
            # equivalence here so external calls do not acquire needless casts;
            # nested pointers remain exact because their slot layout and aliasing
            # semantics differ.
            same_abi_byte_shape: bool = c_type_pointer_count(argument_type) == 1 and c_type_pointer_count(target_type) == 1 and sview_eq(c_type_abi_base(argument_type), c_type_abi_base(target_type))
            return false if not sview_eq(argument_base, target_base) and not same_abi_byte_shape
            return c_type_is_const_pointer(target_type) or not c_type_is_const_pointer(argument_type)
        return sview_eq(c_type_without_qualifiers(argument_type), c_type_without_qualifiers(target_type))

    def c_type_array_decay_compatible(array_type: sview, target_type: sview) -> bool:
        return false if not c_type_is_array(array_type) or c_type_is_function(target_type) or sview_find_byte(target_type, 42) < 0
        return false if c_type_pointer_count(target_type) != 1
        open_bracket: i64 = sview_find_byte(array_type, 91)
        if open_bracket < 0:
            return false
        element_type: sview = string_view_prefix(array_type, open_bracket)
        return false if not sview_eq(c_type_abi_base(element_type), c_type_abi_base(target_type))
        return c_type_is_const_pointer(target_type) or not sview_starts_with(element_type, sview("const ", 0, -1))

    def typed_is_direct_function_field(ctx: TypedContext&, index: i64) -> bool:
        expression: TypedExpr = typed_expr_at(ctx, index)
        return false if expression.kind != TypedExprKind.Member or not c_type_is_function_pointer(expression.type_name)
        base: TypedExpr = typed_expr_at(ctx, expression.lhs)
        return base.kind == TypedExprKind.Name and typed_record_index(ctx, base.type_name) >= 0

    def typed_emit_direct_function_field_assignment(out: mutable darray[u8]&, ctx: TypedContext&, index: i64, value_index: i64, level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        base: TypedExpr = typed_expr_at(ctx, expression.lhs)
        record_index: i64 = typed_record_index(ctx, base.type_name)
        return if record_index < 0
        record: TypedRecord = ctx.records[record_index.usize()]
        append_indent(out, level)
        typed_emit_expr(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(" <- ", 0, -1))
        append_elisa_type_name(out, record.name)
        append_view(out, sview("{", 0, -1))
        for offset in 0..<record.fields_count |out, ctx, record, expression, base, value_index|:
            field: TypedField = ctx.fields[(record.fields_start + offset).usize()]
            append_view(out, sview(", ", 0, -1)) if offset > 0
            append_view(out, field.name)
            append_view(out, sview(": ", 0, -1))
            if sview_eq(field.name, expression.text):
                typed_emit_initializer_value(out, ctx, value_index, field.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            elif c_type_is_function_pointer(field.type_name):
                typed_emit_expr(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(".", 0, -1))
                append_view(out, field.name)
            else:
                typed_emit_expr(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(".", 0, -1))
                append_view(out, field.name)
        append_view(out, sview("}\n", 0, -1))

    def typed_emit_conditional_value(out: mutable darray[u8]&, ctx: TypedContext&, index: i64, target_type: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        if expression.kind == TypedExprKind.Conditional:
            typed_emit_conditional_value(out, ctx, expression.rhs, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(" if ", 0, -1))
            typed_emit_condition(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(" else ", 0, -1))
            typed_emit_conditional_value(out, ctx, expression.third, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        wants_bool: bool = sview_eq(target_type, sview("_Bool", 0, -1)) or sview_eq(target_type, sview("bool", 0, -1))
        if wants_bool and not typed_expr_is_boolean(ctx, index):
            append_view(out, sview("(", 0, -1))
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(" != 0)", 0, -1))
        elif not wants_bool and typed_expr_is_boolean(ctx, index):
            append_view(out, sview("(1 if ", 0, -1))
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(" else 0)", 0, -1))
        else:
            typed_emit_target_value(out, ctx, index, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_emit_expr(out: mutable darray[u8]&, ctx: TypedContext&, index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr = typed_expr_at(ctx, index)
        if typed_expr_is_redundant_cast(ctx, index):
            typed_emit_expr(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        identity_operand: i64 = typed_expr_is_identity_binary(ctx, index)
        if identity_operand >= 0:
            typed_emit_expr(out, ctx, identity_operand) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        # Fold pure integer expressions at the final emission boundary. This
        # preserves the typed IR used by analysis while removing C-only
        # constant-expression scaffolding from generated Elisa. Pointer casts
        # are excluded by the result-type check because their numeric spelling
        # may represent an address rather than an integer value.
        folded: mutable i64 = 0
        if (expression.kind == TypedExprKind.Binary or expression.kind == TypedExprKind.Unary or expression.kind == TypedExprKind.Cast) and (c_type_is_integer(expression.type_name) or c_type_is_enum(expression.type_name)) and typed_eval_integer_constant(ctx, index, folded):
            append_view(out, sview("true", 0, -1)) if typed_expr_is_boolean(ctx, index) else append_i64(out, folded)
            return
        match expression.kind:
            TypedExprKind.Integer:
                append_view(out, expression.text)
            TypedExprKind.Floating:
                append_view(out, expression.text)
            TypedExprKind.String:
                append_elisa_string_literal(out, expression.text)
            TypedExprKind.Character:
                append_i64(out, expression.value)
            TypedExprKind.Name:
                if expression.value == 1:
                    append_qualified(out, expression.type_name, expression.text)
                elif expression.value == 2:
                    append_elisa_type_name(out, typed_enum_const_name(ctx, expression.text))
                    append_view(out, sview(".", 0, -1))
                    append_view(out, expression.text)
                elif typed_global_index(ctx, expression.text) < 0 and typed_external_global_index(ctx, expression.text) >= 0:
                    typed_emit_external_alias(out, ctx, TypedBindingKind.ExternalGlobal, typed_external_global_index(ctx, expression.text))
                elif typed_external_index(ctx, expression.text) >= 0:
                    typed_emit_external_alias(out, ctx, TypedBindingKind.External, typed_external_index(ctx, expression.text))
                else:
                    typed_emit_source_name(out, ctx, expression.text)
            TypedExprKind.Null:
                append_view(out, sview("null", 0, -1))
            TypedExprKind.Zeroed:
                append_view(out, sview("zeroed", 0, -1))
            TypedExprKind.Sequence:
                # A sequence used as a value has the value of its final term.
                # Statement emission below preserves both terms' side effects.
                typed_emit_expr(out, ctx, expression.rhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            TypedExprKind.Binary:
                if (c_type_is_function(typed_expr_at(ctx, expression.lhs).type_name) or c_type_is_function(typed_expr_at(ctx, expression.rhs).type_name)) and not sview_eq(expression.text, sview("<-", 0, -1)):
                    append_view(out, sview("(", 0, -1))
                    typed_emit_function_pointer_storage_value(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview(" ", 0, -1))
                    append_view(out, expression.text)
                    append_view(out, sview(" ", 0, -1))
                    typed_emit_function_pointer_storage_value(out, ctx, expression.rhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview(")", 0, -1))
                elif typed_expr_is_pointer(ctx, expression.lhs) and typed_expr_is_pointer(ctx, expression.rhs) and (sview_eq(expression.text, sview("==", 0, -1)) or sview_eq(expression.text, sview("!=", 0, -1)) or sview_eq(expression.text, sview("<", 0, -1)) or sview_eq(expression.text, sview(">", 0, -1)) or sview_eq(expression.text, sview("<=", 0, -1)) or sview_eq(expression.text, sview(">=", 0, -1))):
                    # Elisa's relational operators compare referenced values. C's
                    # relational operators on pointers compare addresses, so make
                    # that conversion explicit for pointer-walking loops.
                    append_view(out, sview("((", 0, -1))
                    typed_emit_pointer_address(out, ctx, expression.lhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview(" ", 0, -1))
                    append_view(out, expression.text)
                    append_view(out, sview(" ", 0, -1))
                    typed_emit_pointer_address(out, ctx, expression.rhs) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("))", 0, -1))
                elif (sview_eq(expression.text, sview("+", 0, -1)) or sview_eq(expression.text, sview("-", 0, -1))) and typed_expr_is_pointer(ctx, expression.lhs):
                    if sview_eq(expression.text, sview("-", 0, -1)) and typed_expr_is_pointer(ctx, expression.rhs):
