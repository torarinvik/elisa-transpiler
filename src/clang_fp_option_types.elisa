extend CTranslator:
    const enum ClangFloatingPointMode of i8:
        Strict
        Relaxed
        Unknown

    const enum ClangFPBooleanSetting of i8:
        Unknown
        TargetDefault
        Off
        On

    const enum ClangFPExceptionSetting of i8:
        Unknown
        TargetDefault
        Ignore
        MayTrap
        Strict

    const enum ClangFPRoundingSetting of i8:
        Unknown
        TargetDefault
        Tonearest
        Dynamic
        Downward
        Upward
        TowardZero

    const enum ClangFPContractSetting of i8:
        Unknown
        TargetDefault
        Off
        On
        Fast
        FastHonorPragmas

    const enum ClangFPDenormalSetting of i8:
        Unknown
        TargetDefault
        IEEE
        PreserveSign
        PositiveZero

    const enum ClangFPComplexSetting of i8:
        Unknown
        TargetDefault
        Basic
        Improved
        Full
        Promoted

    const enum ClangFPEvalSetting of i8:
        Unknown
        TargetDefault
        Source
        Double
        Extended

    const enum ClangFPExcessPrecisionSetting of i8:
        Unknown
        TargetDefault
        NoExcessPrecision
        Fast
        Standard

    const enum ClangFPDriverLinkEffect of i8:
        TargetDefault
        AutomaticIfLinked
        ExplicitlyLinked
        Suppressed
        NotLinked
        Unknown

    const enum ClangFPModelProfile of i8:
        Precise
        Strict
        Fast
        Aggressive

    struct ClangFPOptionVector:
        mode: mutable ClangFloatingPointMode
        exception_behavior: mutable ClangFPExceptionSetting
        fenv_access: mutable ClangFPBooleanSetting
        rounding_mode: mutable ClangFPRoundingSetting
        rounding_math: mutable ClangFPBooleanSetting
        contract: mutable ClangFPContractSetting
        explicit_contract: mutable ClangFPContractSetting
        contract_explicitly_seen: mutable bool
        denormal: mutable ClangFPDenormalSetting
        denormal_fp32: mutable ClangFPDenormalSetting
        math_errno: mutable ClangFPBooleanSetting
        honor_nans: mutable ClangFPBooleanSetting
        honor_infinities: mutable ClangFPBooleanSetting
        finite_math_only: mutable ClangFPBooleanSetting
        signed_zeros: mutable ClangFPBooleanSetting
        associative_math: mutable ClangFPBooleanSetting
        reciprocal_math: mutable ClangFPBooleanSetting
        approximate_functions: mutable ClangFPBooleanSetting
        trapping_math: mutable ClangFPBooleanSetting
        cx_limited_range: mutable ClangFPBooleanSetting
        float_store: mutable ClangFPBooleanSetting
        strict_float_cast_overflow: mutable ClangFPBooleanSetting
        single_precision_constant: mutable ClangFPBooleanSetting
        protect_parens: mutable ClangFPBooleanSetting
        complex_arithmetic: mutable ClangFPComplexSetting
        eval_method: mutable ClangFPEvalSetting
        excess_precision: mutable ClangFPExcessPrecisionSetting
        driver_link_effect: mutable ClangFPDriverLinkEffect
        unknown_option_seen: mutable bool
