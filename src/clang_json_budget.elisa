extend CTranslator:
    const CLANG_JSON_MAX_DEPTH: i64 = 256
    def ast_json_is_hex_digit(byte: i64) -> bool:
        return (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)

    # Validate one raw UTF-8 scalar in a JSON string. Escaped Unicode is checked
    # by the JSON decoder; raw bytes must reject overlong forms, surrogates,
    # truncated sequences, isolated continuations, and values above U+10FFFF.
    def ast_json_utf8_sequence_end(text: sview, start: i64) -> i64:
        return -1 if start < 0 or start >= text.len
        lead: i64 = string_view_index(text, start)
        return start + 1 if lead <= 127

        sequence_length: mutable i64 = 0
        second_minimum: mutable i64 = 128
        second_maximum: mutable i64 = 191
        if lead >= 194 and lead <= 223:
            sequence_length <- 2
        elif lead == 224:
            sequence_length <- 3
            second_minimum <- 160
        elif (lead >= 225 and lead <= 236) or (lead >= 238 and lead <= 239):
            sequence_length <- 3
        elif lead == 237:
            sequence_length <- 3
            second_maximum <- 159
        elif lead == 240:
            sequence_length <- 4
            second_minimum <- 144
        elif lead >= 241 and lead <= 243:
            sequence_length <- 4
        elif lead == 244:
            sequence_length <- 4
            second_maximum <- 143
        else:
            return -1

        return -1 if text.len - start < sequence_length
        second: i64 = string_view_index(text, start + 1)
        return -1 if second < second_minimum or second > second_maximum
        for offset in 2..<sequence_length |text, start|:
            continuation: i64 = string_view_index(text, start + offset)
            return -1 if continuation < 128 or continuation > 191
        return start + sequence_length

    # Unlike the projection walkers, this scanner validates every JSON string
    # escape and rejects unescaped control bytes. That matters before projection:
    # fields later discarded from the AST must not hide malformed input.
    def ast_json_strict_string_end(text: sview, start: i64) -> i64:
        return -1 if start >= text.len or string_view_index(text, start) != 34
        cursor: mutable i64 = start + 1
        while cursor < text.len:
            byte: i64 = string_view_index(text, cursor)
            return cursor + 1 if byte == 34
            return -1 if byte < 32
            if byte == 92:
                cursor <- cursor + 1
                return -1 if cursor >= text.len
                escaped: i64 = string_view_index(text, cursor)
                if escaped == 34 or escaped == 92 or escaped == 47 or escaped == 98 or escaped == 102 or escaped == 110 or escaped == 114 or escaped == 116:
                    cursor <- cursor + 1
                elif escaped == 117:
                    return -1 if cursor + 4 >= text.len
                    for offset in 1..<5 |text, cursor|:
                        return -1 if not ast_json_is_hex_digit(string_view_index(text, cursor + offset))
                    cursor <- cursor + 5
                else:
                    return -1
            elif byte <= 127:
                # Keep the overwhelmingly common ASCII path branch-only; call
                # the multibyte validator only when a raw high byte appears.
                cursor <- cursor + 1
            else:
                stop: i64 = ast_json_utf8_sequence_end(text, cursor)
                return -1 if stop <= cursor
                cursor <- stop
        return -1

    def ast_json_is_digit(byte: i64) -> bool:
        return byte >= 48 and byte <= 57

    def ast_json_is_token_delimiter(byte: i64) -> bool:
        return byte == 32 or byte == 9 or byte == 10 or byte == 13 or byte == 44 or byte == 93 or byte == 125

    # Return the first byte after a valid JSON literal/number, otherwise -1.
    def ast_json_strict_primitive_end(text: sview, start: i64) -> i64:
        return -1 if start >= text.len
        first: i64 = string_view_index(text, start)
        if first == 110 or first == 116 or first == 102:
            token: sview = sview("null", 0, -1) if first == 110 else sview("true", 0, -1) if first == 116 else sview("false", 0, -1)
            return -1 if token.len > text.len - start
            for offset in 0..<token.len |text, start, token|:
                return -1 if string_view_index(text, start + offset) != string_view_index(token, offset)
            stop: i64 = start + token.len
            return -1 if stop < text.len and not ast_json_is_token_delimiter(string_view_index(text, stop))
            return stop

        cursor: mutable i64 = start
        cursor <- cursor + 1 if string_view_index(text, cursor) == 45
        return -1 if cursor >= text.len
        byte: i64 = string_view_index(text, cursor)
        if byte == 48:
            cursor <- cursor + 1
            return -1 if cursor < text.len and ast_json_is_digit(string_view_index(text, cursor))
        else:
            return -1 if byte < 49 or byte > 57
            while cursor < text.len and ast_json_is_digit(string_view_index(text, cursor)):
                cursor <- cursor + 1
        if cursor < text.len and string_view_index(text, cursor) == 46:
            cursor <- cursor + 1
            return -1 if cursor >= text.len or not ast_json_is_digit(string_view_index(text, cursor))
            while cursor < text.len and ast_json_is_digit(string_view_index(text, cursor)):
                cursor <- cursor + 1
        if cursor < text.len and (string_view_index(text, cursor) == 69 or string_view_index(text, cursor) == 101):
            cursor <- cursor + 1
            cursor <- cursor + 1 if cursor < text.len and (string_view_index(text, cursor) == 43 or string_view_index(text, cursor) == 45)
            return -1 if cursor >= text.len or not ast_json_is_digit(string_view_index(text, cursor))
            while cursor < text.len and ast_json_is_digit(string_view_index(text, cursor)):
                cursor <- cursor + 1
        return -1 if cursor < text.len and not ast_json_is_token_delimiter(string_view_index(text, cursor))
        return cursor

    # A syntax-only pass over raw Clang JSON. It deliberately uses the same
    # bounded stack as the value-budget scan but does not impose the projected
    # value cap; raw Clang dumps naturally contain declarations projection drops.
    def ast_json_is_well_formed(text: sview) -> bool:
        values: mutable i64 = 0
        exceeded: mutable bool = false
        return ast_json_preflight_value_count(text, 9223372036854775807.usize(), &values, &exceeded) and not exceeded

    # Count JSON values in the compact Clang projection without constructing
    # the JsonValueHandle[r] DOM. This lets the driver reject pathological ASTs before
    # the parser allocates one arena entry per value/container. Object keys are
    # deliberately not values. If the structure is malformed, return false so
    # the normal JSON parser can provide the precise syntax diagnostic.
    def ast_json_preflight_value_count(text: sview, max_values: usize, value_count: mutable i64&, limit_exceeded: mutable bool&) -> bool:
        root_array_item_count: mutable i64 = 0
        root_array_limit_exceeded: mutable bool = false
        return ast_json_preflight_value_count_with_array_limit(text, max_values, 9223372036854775807.usize(), &value_count, &limit_exceeded, &root_array_item_count, &root_array_limit_exceeded)

    # Also bound the number of direct elements in a root JSON array. The
    # compilation-database path uses this to reject too many translation-unit
    # entries before constructing the persistent JSON DOM.
    def ast_json_preflight_value_count_with_array_limit(text: sview, max_values: usize, max_root_array_items: usize, value_count: mutable i64&, limit_exceeded: mutable bool&, root_array_item_count: mutable i64&, root_array_limit_exceeded: mutable bool&) -> bool:
        value_count <- 0
        limit_exceeded <- false
        root_array_item_count <- 0
        root_array_limit_exceeded <- false
        cursor: mutable i64 = ast_json_skip_space(text, 0)
        depth: mutable i64 = 0
        container_kind: mutable u8[CLANG_JSON_MAX_DEPTH] = zeroed
        container_state: mutable u8[CLANG_JSON_MAX_DEPTH] = zeroed
        root_seen: mutable bool = false
        maximum: i64 = max_values.i64()
        maximum_root_array_items: i64 = max_root_array_items.i64()

        while cursor < text.len |text, max_values, value_count, limit_exceeded, root_array_item_count, root_array_limit_exceeded, cursor, depth, container_kind, container_state, root_seen, maximum, maximum_root_array_items|:
            byte: i64 = string_view_index(text, cursor)
            if byte == 32 or byte == 9 or byte == 10 or byte == 13:
                cursor <- cursor + 1
            elif byte == 44:
                return false if depth == 0
                top: usize = (depth - 1).usize()
                return false if container_state[top] != 3
                container_state[top] <- 4
                cursor <- cursor + 1
            elif byte == 58:
                return false if depth == 0
                top: usize = (depth - 1).usize()
                return false if container_kind[top] != 1 or container_state[top] != 1
                container_state[top] <- 2
                cursor <- cursor + 1
            elif byte == 125:
                return false if depth == 0
                top: usize = (depth - 1).usize()
                return false if container_kind[top] != 1 or (container_state[top] != 0 and container_state[top] != 3)
                depth <- depth - 1
                cursor <- cursor + 1
            elif byte == 93:
                return false if depth == 0
                top: usize = (depth - 1).usize()
                return false if container_kind[top] != 2 or (container_state[top] != 0 and container_state[top] != 3)
                depth <- depth - 1
                cursor <- cursor + 1
            elif byte == 34:
                stop: i64 = ast_json_strict_string_end(text, cursor)
                return false if stop <= cursor
                is_object_key: mutable bool = false
                if depth > 0:
                    top: usize = (depth - 1).usize()
                    is_object_key <- container_kind[top] == 1 and (container_state[top] == 0 or container_state[top] == 4)
                if is_object_key:
                    top: usize = (depth - 1).usize()
                    container_state[top] <- 1
                else:
                    if depth == 1 and container_kind[0.usize()] == 2:
                        root_array_item_count <- root_array_item_count + 1
                        if root_array_item_count > maximum_root_array_items:
                            root_array_limit_exceeded <- true
                            return true
                    if depth == 0:
                        return false if root_seen
                        root_seen <- true
                    elif container_kind[(depth - 1).usize()] == 1:
                        top: usize = (depth - 1).usize()
                        return false if container_state[top] != 2
                        container_state[top] <- 3
                    else:
                        top: usize = (depth - 1).usize()
                        return false if container_state[top] != 0 and container_state[top] != 4
                        container_state[top] <- 3
                    value_count <- value_count + 1
                    if value_count > maximum:
                        limit_exceeded <- true
                        return true
                cursor <- stop
            elif byte == 123 or byte == 91:
                if depth == 1 and container_kind[0.usize()] == 2:
                    root_array_item_count <- root_array_item_count + 1
                    if root_array_item_count > maximum_root_array_items:
                        root_array_limit_exceeded <- true
                        return true
                if depth == 0:
                    return false if root_seen
                    root_seen <- true
                elif container_kind[(depth - 1).usize()] == 1:
                    top: usize = (depth - 1).usize()
                    return false if container_state[top] != 2
                    container_state[top] <- 3
                else:
                    top: usize = (depth - 1).usize()
                    return false if container_state[top] != 0 and container_state[top] != 4
                    container_state[top] <- 3
                value_count <- value_count + 1
                if value_count > maximum:
                    limit_exceeded <- true
                    return true
                return false if depth >= CLANG_JSON_MAX_DEPTH
                container_kind[depth.usize()] <- 1
                container_kind[depth.usize()] <- 2 if byte == 91
                container_state[depth.usize()] <- 0
                depth <- depth + 1
                cursor <- cursor + 1
            else:
                if depth == 1 and container_kind[0.usize()] == 2:
                    root_array_item_count <- root_array_item_count + 1
                    if root_array_item_count > maximum_root_array_items:
                        root_array_limit_exceeded <- true
                        return true
                if depth == 0:
                    return false if root_seen
                    root_seen <- true
                elif container_kind[(depth - 1).usize()] == 1:
                    top: usize = (depth - 1).usize()
                    return false if container_state[top] != 2
                    container_state[top] <- 3
                else:
                    top: usize = (depth - 1).usize()
                    return false if container_state[top] != 0 and container_state[top] != 4
                    container_state[top] <- 3
                value_count <- value_count + 1
                if value_count > maximum:
                    limit_exceeded <- true
                    return true
                stop: i64 = ast_json_strict_primitive_end(text, cursor)
                return false if stop <= cursor
                cursor <- stop

        return root_seen and depth == 0
