extend CTranslator:
    def typed_emit_flow_declaration[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, statement: TypedStmt[r], level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if typed_current_declared_name(ctx, statement.name)
        ctx.current_declared_names.push(statement.name)
        append_indent(out, level)
        is_pointer_local: bool = c_type_pointer_count(statement.type_name) > 0 and statement.aux != TYPED_STMT_AUX_CPP_UNORDERED_MAP_ITERATOR
        if is_pointer_local:
            # Flow lowering hoists declarations because a goto may enter from
            # below them.  Hoisting must preserve the same two independent C
            # properties as structured emission: a top-level pointer const
            # controls whether the Elisa binding may be rebound, while const
            # on the pointee controls the reference capability.  C `const` is
            # never emitted as an Elisa qualifier; ordinary Elisa bindings
            # already have the desired immutable default.
            append_view(out, sview("mutable ", 0, -1)) if c_type_pointer_binding_is_mutable(statement.type_name)
            append_view(out, statement.name)
            append_view(out, sview(": ", 0, -1))
            append_view(out, sview("mutable ", 0, -1)) if not c_type_pointer_layers_composable(statement.type_name) and not c_type_is_function_pointer(statement.type_name) and c_type_pointer_can_write(statement.type_name)
        else:
            append_view(out, statement.name)
            # C object-level `const` maps to Elisa's ordinary immutable
            # binding. This must remain true in the hoisted CFG path too;
            # control-flow lowering changes declaration placement, not its
            # source mutability semantics.
            # Hoisted non-const locals retain the conservative writable
            # representation used by the CFG backend: later assignments may
            # arrive from another block. The source-level const boundary is
            # still exact because only an actual top-level const object gets
            # the ordinary immutable spelling.
            append_view(out, sview(": ", 0, -1)) if c_type_is_const_object(statement.type_name) else append_view(out, sview(": mutable ", 0, -1))
        append_c_type_contextual(out, ctx, statement.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(statement.type_name)
        append_view(out, sview(" = zeroed\n", 0, -1))
    def typed_emit_flow_statement[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, index: i64, level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        statement: TypedStmt[r] = typed_stmt_at(ctx, index)
        if statement.kind == TypedStmtKind.Declaration:
            # Declarations are hoisted to the function entry so gotos cannot
            # jump over storage creation.  Replay every initializer at its
            # original CFG position, including local arrays: C permits
            # `char name[N] = "prefix"`, and dropping that initializer changes
            # later string operations into reads from an empty buffer.
            if statement.expr >= 0:
                append_indent(out, level)
                append_view(out, statement.name)
                append_view(out, sview(" <- ", 0, -1))
                typed_emit_target_value(out, ctx, statement.expr, statement.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("\n", 0, -1))
            return
        if statement.kind == TypedStmtKind.Expression:
            typed_emit_expression_statement(out, ctx, statement.expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        # Keep structured statements that are embedded in a CFG block.  The
        # CFG builder owns only the control transfers it can model directly;
        # silently replacing a nested switch (or another structured statement)
        # with `pass` changes program semantics.  This is especially important
        # for C functions that use a direction/dispatch switch before a goto.
        typed_emit_stmt(out, ctx, index, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_flow_incoming_count[@r](builder: TypedFlowBuilder[r]&, target: i64) -> i64:
        return 0 if target < 0 or target >= builder.blocks.count.i64()
        count: mutable i64 = 1 if target == 0 else 0
        for index in 0..<builder.blocks.count |builder, target, count|:
            block: TypedFlowBlock[r] = builder.blocks[index.usize()]
            if block.term_kind == TypedFlowTermKind.Jump:
                count <- count + 1 if block.target == target
            elif block.term_kind == TypedFlowTermKind.Branch:
                count <- count + 1 if block.true_target == target
                count <- count + 1 if block.false_target == target and block.true_target != target
            elif block.term_kind == TypedFlowTermKind.Switch:
                count <- count + 1 if block.target == target
                for offset in 0..<block.switch_count |builder, block, target, count, offset|:
                    switch_target: TypedFlowSwitchTarget = builder.switch_targets[(block.switch_start + offset).usize()]
                    count <- count + 1 if switch_target.target == target
        return count

    def typed_flow_is_label_block[@r](builder: TypedFlowBuilder[r]&, target: i64) -> bool:
        for index in 0..<builder.label_blocks.count |builder, target|:
            return true if builder.label_blocks[index.usize()] == target
        return false

    def typed_flow_can_inline[@r](builder: TypedFlowBuilder[r]&, target: i64) -> bool:
        return false if target <= 0 or target >= builder.blocks.count.i64()
        return false if typed_flow_is_label_block(builder, target)
        return false if typed_flow_incoming_count(builder, target) != 1
        block: TypedFlowBlock[r] = builder.blocks[target.usize()]
        return block.term_kind == TypedFlowTermKind.Jump or block.term_kind == TypedFlowTermKind.Return or block.term_kind == TypedFlowTermKind.Stop

    def typed_flow_arm_jumps_to[@r](builder: TypedFlowBuilder[r]&, target: i64, final_target: i64) -> bool:
        return false if not typed_flow_can_inline(builder, target)
        block: TypedFlowBlock[r] = builder.blocks[target.usize()]
        return block.statements_count > 0 and block.term_kind == TypedFlowTermKind.Jump and block.target == final_target

    # An unlabeled empty jump block has no source-visible work and no legal
    # entry point of its own. Thread it at the edge that emits the transfer so
    # a goto-heavy function does not spend a state-machine turn visiting a
    # purely synthetic block. Never thread through a labeled block: a source
    # goto may target that label even when the label's block is empty. The
    # bounded step count also makes malformed/cyclic CFGs fail closed rather
    # than turning output generation into an unbounded walk.
    def typed_flow_thread_target[@r](builder: TypedFlowBuilder[r]&, target: i64) -> i64:
        current: mutable i64 = target
        steps: mutable i64 = 0
        while steps < 64:
            return current if current <= 0 or current >= builder.blocks.count.i64()
            return current if typed_flow_is_label_block(builder, current)
            block: TypedFlowBlock[r] = builder.blocks[current.usize()]
            return current if block.statements_count != 0 or block.term_kind != TypedFlowTermKind.Jump
            return current if block.target == current
            current <- block.target
            steps <- steps + 1
        return current
    def typed_emit_flow_block_statements[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, builder: TypedFlowBuilder[r]&, block_index: i64, level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if block_index < 0 or block_index >= builder.blocks.count.i64()
        block: TypedFlowBlock[r] = builder.blocks[block_index.usize()]
        return if block.statements_count == 0
        for offset in 0..<builder.statements.count |out, ctx, builder, block_index|:
            flow_statement: TypedFlowStatement = builder.statements[offset.usize()]
            typed_emit_flow_statement(out, ctx, flow_statement.statement, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console if flow_statement.block == block_index
    def typed_emit_flow_jump_depth[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, builder: TypedFlowBuilder[r]&, target: i64, level: i64, inline_target: bool, depth: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        resolved_target: i64 = typed_flow_thread_target(builder, target)
        if inline_target and typed_flow_can_inline(builder, resolved_target):
            block: TypedFlowBlock[r] = builder.blocks[resolved_target.usize()]
            typed_emit_flow_block_statements(out, ctx, builder, resolved_target, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            # Follow a short straight-line chain. Each block is still required
            # to have one incoming edge, so this cannot duplicate a block that
            # another control-flow arm can observe.
            if depth > 0 and block.term_kind == TypedFlowTermKind.Jump and block.target != resolved_target:
                typed_emit_flow_jump_depth(out, ctx, builder, block.target, level, true, depth - 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            else:
                typed_emit_flow_terminator(out, ctx, builder, block, level, false) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        append_indent(out, level)
        append_view(out, builder.state_name)
        append_view(out, sview(" <- ", 0, -1))
        append_i64(out, resolved_target)
        append_view(out, sview("\n", 0, -1))
    def typed_emit_flow_jump[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, builder: TypedFlowBuilder[r]&, target: i64, level: i64, inline_target: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        typed_emit_flow_jump_depth(out, ctx, builder, target, level, inline_target, 4) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_emit_flow_arm[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, builder: TypedFlowBuilder[r]&, target: i64, level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        typed_emit_flow_jump(out, ctx, builder, target, level, true) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_flow_is_inlined[@r](builder: TypedFlowBuilder[r]&, target: i64) -> bool:
        return false if target <= 0 or target >= builder.blocks.count.i64()
        for index in 0..<builder.blocks.count |builder, target|:
            block: TypedFlowBlock[r] = builder.blocks[index.usize()]
            if block.term_kind == TypedFlowTermKind.Branch:
                return true if block.true_target == target and typed_flow_can_inline(builder, target)
                return true if block.false_target == target and typed_flow_can_inline(builder, target)
            elif block.term_kind == TypedFlowTermKind.Jump:
                return true if block.target == target and typed_flow_can_inline(builder, target)
        return false
    def typed_emit_flow_return[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, block: TypedFlowBlock[r], level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        if block.term_expr >= 0 and typed_expr_at(ctx, block.term_expr).kind == TypedExprKind.Binary and sview_eq(typed_expr_at(ctx, block.term_expr).text, sview("<-", 0, -1)):
            typed_emit_expression_statement(out, ctx, block.term_expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_indent(out, level)
            append_view(out, sview("return ", 0, -1))
            typed_emit_target_value(out, ctx, typed_assignment_result(ctx, block.term_expr), block.term_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview("\n", 0, -1))
            return
        append_indent(out, level)
        append_view(out, sview("return", 0, -1))
        if block.term_expr >= 0:
            append_view(out, sview(" ", 0, -1))
            typed_emit_target_value(out, ctx, block.term_expr, block.term_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview("\n", 0, -1))
    def typed_emit_flow_switch[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, builder: TypedFlowBuilder[r]&, block: TypedFlowBlock[r], level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        selector_name: mutable sview = sview("", 0, 0)
        if typed_switch_selector_needs_temp(ctx, block.term_expr):
            selector_name <- typed_emit_switch_selector(out, ctx, block.term_expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_indent(out, level)
        append_view(out, sview("match ", 0, -1))
        if selector_name.len > 0:
            append_view(out, selector_name)
        else:
            typed_emit_expr(out, ctx, block.term_expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(":\n", 0, -1))
        has_default: mutable bool = false
        for offset in 0..<block.switch_count |out, ctx, builder, block, level, has_default, offset|:
            switch_target: TypedFlowSwitchTarget = builder.switch_targets[(block.switch_start + offset).usize()]
            switch_case: TypedSwitchCase = ctx.switch_cases[switch_target.case_index.usize()]
            append_indent(out, level + 1)
            if switch_case.is_default:
                append_view(out, sview("_:", 0, -1))
                has_default <- true
            elif switch_case.is_constant:
                append_i64(out, switch_case.constant_value)
                append_view(out, sview(":", 0, -1))
            else:
                typed_emit_expr(out, ctx, switch_case.value) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(":", 0, -1))
            append_view(out, sview("\n", 0, -1))
            typed_emit_flow_jump(out, ctx, builder, switch_target.target, level + 2, false) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if not has_default:
            append_indent(out, level + 1)
            append_view(out, sview("_:\n", 0, -1))
            typed_emit_flow_jump(out, ctx, builder, block.target, level + 2, false) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_emit_flow_terminator[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, builder: TypedFlowBuilder[r]&, block: TypedFlowBlock[r], level: i64, inline_target: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        match block.term_kind:
            TypedFlowTermKind.Jump:
                typed_emit_flow_jump(out, ctx, builder, block.target, level, inline_target) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            TypedFlowTermKind.Branch:
                if typed_flow_arm_jumps_to(builder, block.true_target, block.false_target):
                    append_indent(out, level)
                    append_view(out, sview("if ", 0, -1))
                    typed_emit_condition(out, ctx, block.term_expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview(":\n", 0, -1))
                    typed_emit_flow_block_statements(out, ctx, builder, block.true_target, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    typed_emit_flow_jump(out, ctx, builder, block.false_target, level, inline_target) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    return
                if block.true_target == block.false_target:
                    # The condition still has to be evaluated: it may contain
                    # a call, assignment, volatile read, or another C side
                    # effect even when both control-flow arms converge.
                    typed_emit_expression_statement(out, ctx, block.term_expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console if block.term_expr >= 0
                    typed_emit_flow_jump(out, ctx, builder, block.true_target, level, inline_target) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    return
                append_indent(out, level)
                append_view(out, sview("if ", 0, -1))
                typed_emit_condition(out, ctx, block.term_expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(":\n", 0, -1))
                typed_emit_flow_arm(out, ctx, builder, block.true_target, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_indent(out, level)
                append_view(out, sview("else:\n", 0, -1))
                typed_emit_flow_arm(out, ctx, builder, block.false_target, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            TypedFlowTermKind.Switch:
                typed_emit_flow_switch(out, ctx, builder, block, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            TypedFlowTermKind.Return:
                typed_emit_flow_return(out, ctx, block, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            _:
                append_indent(out, level)
                append_view(out, sview("break\n", 0, -1))
    def typed_emit_flow_body[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, function: TypedFunction[r], level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        builder: mutable TypedFlowBuilder[r] = TypedFlowBuilder[r]{blocks: [], statements: [], label_blocks: [], declarations: [], switch_targets: [], break_targets: [], continue_targets: [], state_name: typed_flow_state_name(ctx, function), current: -1}
        typed_build_flow(builder, ctx, function) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        reachable: darray[bool] = typed_flow_reachable_blocks(builder)
        for offset in 0..<builder.declarations.count |out, ctx, builder|:
            typed_emit_flow_declaration(out, ctx, typed_stmt_at(ctx, builder.declarations[offset.usize()]), level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_indent(out, level)
        append_view(out, builder.state_name)
        append_view(out, sview(": mutable i32 = 0\n", 0, -1))
        append_indent(out, level)
        append_view(out, sview("while true:\n", 0, -1))
        for index in 0..<builder.blocks.count |out, ctx, builder|:
            block: TypedFlowBlock[r] = builder.blocks[index.usize()]
            continue if not reachable[index.usize()]
            if typed_flow_is_inlined(builder, index):
                continue
            if index != 0 and block.statements_count == 0 and block.term_kind == TypedFlowTermKind.Jump and block.target != index:
                continue
            append_indent(out, level + 1)
            append_view(out, sview("if ", 0, -1)) if index == 0 else append_view(out, sview("elif ", 0, -1))
            append_view(out, builder.state_name)
            append_view(out, sview(" == ", 0, -1))
            append_i64(out, index)
            append_view(out, sview(":\n", 0, -1))
            typed_emit_flow_block_statements(out, ctx, builder, index, level + 2) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            typed_emit_flow_terminator(out, ctx, builder, block, level + 2, true) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_indent(out, level + 1)
        append_view(out, sview("else:\n", 0, -1))
        append_indent(out, level + 2)
        append_view(out, sview("break\n", 0, -1))
