extend CTranslator:
    def append_view(out: mutable darray[u8]&, value: sview) -> void:
        for index in 0..<value.len |out, value|:
            out.push(string_view_index(value, index).u8())

    def append_indent(out: mutable darray[u8]&, level: i64) -> void:
        for _index in 0..<level |out|:
            append_view(out, sview("    ", 0, -1))

    def append_view_range(out: mutable darray[u8]&, value: sview, start: i64, end: i64) -> void:
        for index in start..<end |out, value|:
            out.push(string_view_index(value, index).u8())

    def type_starts_with(value: sview, prefix: sview) -> bool:
        return sview_starts_with(value, prefix)

    def c_type_without_qualifiers(value: sview) -> sview:
        result: mutable sview = value
        while sview_starts_with(result, sview("const ", 0, -1)) or sview_starts_with(result, sview("volatile ", 0, -1)) or sview_starts_with(result, sview("restrict ", 0, -1)) |result|:
            if sview_starts_with(result, sview("const ", 0, -1)):
                result <- string_view_suffix(result, 6)
            elif sview_starts_with(result, sview("volatile ", 0, -1)):
                result <- string_view_suffix(result, 9)
            else:
                result <- string_view_suffix(result, 9)
        return result

    def c_type_pointer_base(qual_type: sview) -> sview:
        star: i64 = sview_find_byte(qual_type, 42)
        return string_view_prefix(qual_type, star) if star >= 0 else qual_type

    def c_find_byte_from(value: sview, wanted: i64, start: i64) -> i64:
        for index in start..<value.len |value, wanted, start|:
            return index if string_view_index(value, index) == wanted
        return -1

    def c_find_last_byte(value: sview, wanted: i64) -> i64:
        index: mutable i64 = value.len - 1
        while index >= 0 |value, wanted, index|:
            return index if string_view_index(value, index) == wanted
            index <- index - 1
        return -1

    # Clang spells a C function pointer as `return (*)(params)`, optionally with
    # a pointer in the return type (`void *(*)(size_t)`). The `(*` marker avoids
    # confusing the return pointer with the function-pointer declarator.
    def c_function_pointer_marker(qual_type: sview) -> i64:
        for index in 0..<qual_type.len |qual_type|:
            if string_view_index(qual_type, index) != 40:
                continue
            cursor: mutable i64 = index + 1
            while cursor < qual_type.len and string_view_index(qual_type, cursor) == 32 |qual_type, cursor|:
                cursor <- cursor + 1
            return index if cursor < qual_type.len and string_view_index(qual_type, cursor) == 42
        return -1

    def c_type_is_function_pointer(qual_type: sview) -> bool:
        return c_function_pointer_marker(qual_type) >= 0

    def c_type_is_function(qual_type: sview) -> bool:
        open_paren: i64 = sview_find_byte(qual_type, 40)
        close_paren: i64 = c_find_last_byte(qual_type, 41)
        return open_paren >= 0 and close_paren > open_paren

    def c_trim_spaces(value: sview) -> sview:
        result: mutable sview = value
        while result.len > 0 and string_view_index(result, 0) == 32:
            result <- string_view_suffix(result, 1)
        while result.len > 0 and string_view_index(result, result.len - 1) == 32:
            result <- string_view_prefix(result, result.len - 1)
        return result

    def c_type_named_base(qual_type: sview) -> sview:
        base: mutable sview = c_type_without_qualifiers(c_type_pointer_base(qual_type))
        base <- sview_trim_trailing(base, 32)
        if sview_starts_with(base, sview("struct ", 0, -1)):
            return string_view_suffix(base, 7)
        if sview_starts_with(base, sview("union ", 0, -1)):
            return string_view_suffix(base, 6)
        if sview_starts_with(base, sview("enum ", 0, -1)):
            return string_view_suffix(base, 5)
        return base

    def c_type_abi_base(qual_type: sview) -> sview:
        # These C spellings share one Elisa storage representation. Keeping the
        # normalization here lets cast-elision recognize harmless signedness and
        # typedef spelling changes while still distinguishing real void/record
        # pointer reinterpretations.
        base: sview = c_type_named_base(qual_type)
        return sview("u8", 0, -1) if sview_eq(base, sview("char", 0, -1)) or sview_eq(base, sview("unsigned char", 0, -1)) or sview_eq(base, sview("cc_t", 0, -1)) else sview("i8", 0, -1) if sview_eq(base, sview("signed char", 0, -1)) else sview("i16", 0, -1) if sview_eq(base, sview("short", 0, -1)) or sview_eq(base, sview("short int", 0, -1)) else sview("u16", 0, -1) if sview_eq(base, sview("unsigned short", 0, -1)) or sview_eq(base, sview("unsigned short int", 0, -1)) else sview("i32", 0, -1) if sview_eq(base, sview("int", 0, -1)) or sview_eq(base, sview("signed", 0, -1)) or sview_eq(base, sview("signed int", 0, -1)) else sview("u32", 0, -1) if sview_eq(base, sview("unsigned", 0, -1)) or sview_eq(base, sview("unsigned int", 0, -1)) else sview("i64", 0, -1) if sview_eq(base, sview("long", 0, -1)) or sview_eq(base, sview("long int", 0, -1)) or sview_eq(base, sview("long long", 0, -1)) or sview_eq(base, sview("long long int", 0, -1)) else sview("u64", 0, -1) if sview_eq(base, sview("unsigned long", 0, -1)) or sview_eq(base, sview("unsigned long int", 0, -1)) or sview_eq(base, sview("unsigned long long", 0, -1)) or sview_eq(base, sview("unsigned long long int", 0, -1)) else sview("usize", 0, -1) if sview_eq(base, sview("size_t", 0, -1)) else sview("isize", 0, -1) if sview_eq(base, sview("ssize_t", 0, -1)) else sview("f32", 0, -1) if sview_eq(base, sview("float", 0, -1)) else sview("f64", 0, -1) if sview_eq(base, sview("double", 0, -1)) else base

    def append_elisa_type_name(out: mutable darray[u8]&, name: mutable sview) -> void:
        return if name.len == 0
        name <- safe_identifier(name)
        first: u8 = string_view_index(name, 0).u8()
        if first >= 97 and first <= 122:
            out.push(first - 32)
        elif (first < 65 or first > 90):
            append_view(out, sview("C_", 0, -1))
            out.push(first)
        else:
            out.push(first)
        for index in 1..<name.len |out, name|:
            out.push(string_view_index(name, index).u8())

    def c_array_length(qual_type: sview) -> i64:
        open_bracket: i64 = sview_find_byte(qual_type, 91)
        close_bracket: i64 = sview_find_byte(qual_type, 93)
        return 0 if open_bracket < 0 or close_bracket <= open_bracket
        result: mutable i64 = 0
        for index in (open_bracket + 1)..<close_bracket |qual_type, result|:
            digit: i64 = string_view_index(qual_type, index) - 48
            result <- result * 10 + digit if digit >= 0 and digit <= 9
        return result

    def c_hex_digit(byte: i64) -> i64:
        return byte - 48 if byte >= 48 and byte <= 57
        return byte - 65 + 10 if byte >= 65 and byte <= 70
        return byte - 97 + 10 if byte >= 97 and byte <= 102
        return -1

    def append_c_string_array(out: mutable darray[u8]&, literal: sview, target_type: sview) -> void:
        capacity: i64 = c_array_length(target_type)
        append_view(out, sview("[", 0, -1))
        source_index: mutable i64 = 1
        emitted: mutable i64 = 0
        source_end: i64 = literal.len - 1
        while source_index < source_end and emitted < capacity |out, literal, source_index, emitted|:
            value: mutable i64 = string_view_index(literal, source_index)
            source_index <- source_index + 1
            if value == 92 and source_index < source_end:
                escaped: i64 = string_view_index(literal, source_index)
                source_index <- source_index + 1
                if escaped == 110:
                    value <- 10
                elif escaped == 114:
                    value <- 13
                elif escaped == 116:
                    value <- 9
                elif escaped == 98:
                    value <- 8
                elif escaped == 102:
                    value <- 12
                elif escaped == 118:
                    value <- 11
                elif escaped == 97:
                    value <- 7
                elif escaped == 120:
                    value <- 0
                    while source_index < source_end and c_hex_digit(string_view_index(literal, source_index)) >= 0 |literal, source_index, value|:
                        value <- value * 16 + c_hex_digit(string_view_index(literal, source_index))
                        source_index <- source_index + 1
                elif escaped >= 48 and escaped <= 55:
                    value <- escaped - 48
                    digits: mutable i64 = 1
                    while digits < 3 and source_index < source_end and string_view_index(literal, source_index) >= 48 and string_view_index(literal, source_index) <= 55 |literal, source_index, value, digits|:
                        value <- value * 8 + string_view_index(literal, source_index) - 48
                        source_index <- source_index + 1
                        digits <- digits + 1
                else:
                    value <- escaped
            append_view(out, sview(", ", 0, -1)) if emitted > 0
            append_i64(out, value)
            emitted <- emitted + 1
        while emitted < capacity |out, emitted|:
            append_view(out, sview(", ", 0, -1)) if emitted > 0
            append_view(out, sview("0", 0, -1))
            emitted <- emitted + 1
        append_view(out, sview("]", 0, -1))

    def append_hex_digit(out: mutable darray[u8]&, value: i64) -> void:
        out.push((48 + value).u8()) if value < 10
        out.push((55 + value).u8()) if value >= 10

    # Clang's JSON value keeps C's octal and hexadecimal escapes verbatim. Elisa
    # intentionally has no octal string escapes, so canonicalize byte escapes to
    # `\xNN` while preserving the ordinary Elisa-compatible escapes.
    def append_elisa_string_literal(out: mutable darray[u8]&, literal: sview) -> void:
        return if literal.len == 0
        out.push(34)
        index: mutable i64 = 1
        end: i64 = literal.len - 1
        while index < end |out, literal, index, end|:
            value: i64 = string_view_index(literal, index)
            index <- index + 1
            if value != 92:
                out.push(92) if value == 34
                out.push(value.u8())
                continue
            break if index >= end
            escaped: i64 = string_view_index(literal, index)
            index <- index + 1
            byte: mutable i64 = -1
            digits: mutable i64 = 0
            if escaped >= 48 and escaped <= 55:
                byte <- escaped - 48
                digits <- 1
                while digits < 3 and index < end and string_view_index(literal, index) >= 48 and string_view_index(literal, index) <= 55 |literal, index, end, byte, digits|:
                    byte <- byte * 8 + string_view_index(literal, index) - 48
                    index <- index + 1
                    digits <- digits + 1
            elif escaped == 120:
                byte <- 0
                digits <- 0
                while digits < 2 and index < end and c_hex_digit(string_view_index(literal, index)) >= 0 |literal, index, end, byte, digits|:
                    byte <- byte * 16 + c_hex_digit(string_view_index(literal, index))
                    index <- index + 1
                    digits <- digits + 1
            if byte >= 0:
                out.push(92)
                out.push(120)
                append_hex_digit(out, (byte / 16) % 16)
                append_hex_digit(out, byte % 16)
            else:
                out.push(92)
                out.push(escaped.u8())
        out.push(34)

    def c_type_is_const_pointer(qual_type: sview) -> bool:
        base: sview = c_type_pointer_base(qual_type)
        return sview_starts_with(base, sview("const ", 0, -1))

    def c_type_pointer_can_write(qual_type: sview) -> bool:
        # For T **, the outer pointer writes a pointer slot even when the
        # ultimate pointee is const (for example `const char **`). For a single
        # pointer, only a non-const pointee permits writes through the view.
        return c_type_pointer_count(qual_type) > 1 or not c_type_is_const_pointer(qual_type)

    def c_type_pointer_optional(qual_type: sview) -> bool:
        # The optional marker belongs to the pointer value, not to an array
        # aggregate containing pointer elements.
        if c_type_is_function(qual_type) or sview_find_byte(qual_type, 91) >= 0 or sview_find_byte(qual_type, 42) < 0:
            return false
        raw_base: sview = c_type_pointer_base(qual_type)
        base: sview = c_type_without_qualifiers(raw_base)
        pointer_count: mutable i64 = 0
        for index in 0..<qual_type.len |qual_type, pointer_count|:
            pointer_count <- pointer_count + 1 if string_view_index(qual_type, index) == 42
        return true

    def c_type_pointer_count(qual_type: sview) -> i64:
        count: mutable i64 = 0
        for index in 0..<qual_type.len |qual_type, count|:
            count <- count + 1 if string_view_index(qual_type, index) == 42
        return count

    def c_type_is_char_pointer(qual_type: sview) -> bool:
        base: sview = c_type_named_base(qual_type)
        return sview_eq(base, sview("char", 0, -1)) or sview_eq(base, sview("unsigned char", 0, -1)) or sview_eq(base, sview("cc_t", 0, -1))

    def c_function_pointer_params_start(qual_type: sview) -> i64:
        marker: i64 = c_function_pointer_marker(qual_type)
        close_marker: i64 = c_find_byte_from(qual_type, 41, marker + 1)
        return c_find_byte_from(qual_type, 40, close_marker + 1) if marker >= 0 and close_marker >= 0 else -1

    def c_function_parameter_type(function_type: sview, wanted: i64) -> sview:
        params_start: i64 = c_function_pointer_params_start(function_type)
        params_end: i64 = c_find_last_byte(function_type, 41)
        if params_start < 0 or params_end <= params_start or wanted < 0:
            return sview("", 0, 0)
        start: mutable i64 = params_start + 1
        parameter: mutable i64 = 0
        depth: mutable i64 = 0
        for index in (params_start + 1)..<params_end |function_type, wanted, start, parameter, depth|:
            byte: i64 = string_view_index(function_type, index)
            if byte == 40:
                depth <- depth + 1
            elif byte == 41:
                depth <- depth - 1
            elif byte == 44 and depth == 0:
                return c_trim_spaces(string_view_prefix(string_view_suffix(function_type, start), index - start)) if parameter == wanted
                parameter <- parameter + 1
                start <- index + 1
        return c_trim_spaces(string_view_prefix(string_view_suffix(function_type, start), params_end - start)) if parameter == wanted
        return sview("", 0, 0)

    def append_c_function_result(out: mutable darray[u8]&, return_type: sview) -> void:
        append_view(out, sview("mutable ", 0, -1)) if sview_find_byte(return_type, 42) >= 0 and not c_type_is_const_pointer(return_type)
        append_c_type(out, return_type)
        append_view(out, sview("?", 0, -1)) if c_type_pointer_optional(return_type)

    def append_c_function_type(out: mutable darray[u8]&, function_type: sview) -> void:
        marker: i64 = c_function_pointer_marker(function_type)
        params_start: i64 = c_function_pointer_params_start(function_type)
        params_end: i64 = c_find_last_byte(function_type, 41)
        return_type: sview = c_trim_spaces(string_view_prefix(function_type, marker))
        append_view(out, sview("fn(", 0, -1))
        parameter: mutable i64 = 0
        if params_start >= 0 and params_end > params_start:
            for _index in 0..<64 |out, function_type, params_start, params_end, parameter|:
                current: sview = c_function_parameter_type(function_type, parameter)
                break if current.len == 0
                append_view(out, sview(", ", 0, -1)) if parameter > 0
                if sview_eq(current, sview("...", 0, -1)):
                    append_view(out, sview("...", 0, -1))
                else:
                    append_view(out, sview("mutable ", 0, -1)) if sview_find_byte(current, 42) >= 0 and not c_type_is_function_pointer(current) and not c_type_is_const_pointer(current)
                    append_c_type(out, current)
                    append_view(out, sview("?", 0, -1)) if c_type_pointer_optional(current)
                parameter <- parameter + 1
                break if c_function_parameter_type(function_type, parameter).len == 0
        append_view(out, sview(") -> ", 0, -1))
        append_c_function_result(out, return_type)

    def append_c_type(out: mutable darray[u8]&, qual_type: sview) -> void:
        # C pointer values are represented as Elisa references. The declaration
        # site supplies `mutable` when C allows writes through that pointer.
        open_bracket: i64 = sview_find_byte(qual_type, 91)
        close_bracket: i64 = sview_find_byte(qual_type, 93)
        if c_type_is_function_pointer(qual_type):
            append_c_function_type(out, qual_type)
        elif open_bracket >= 0 and close_bracket > open_bracket:
            append_view(out, sview("array[", 0, -1))
            element_type: sview = string_view_prefix(qual_type, open_bracket)
            append_c_type(out, element_type)
            append_view(out, sview("?", 0, -1)) if c_type_pointer_optional(element_type)
            append_view(out, sview(", ", 0, -1))
            append_view_range(out, qual_type, open_bracket + 1, close_bracket)
            append_view(out, sview("]", 0, -1))
        elif sview_find_byte(qual_type, 42) >= 0:
            base: mutable sview = c_type_without_qualifiers(c_type_pointer_base(qual_type))
            base <- sview_trim_trailing(base, 32)
            pointer_count: mutable i64 = 0
            for index in 0..<qual_type.len |qual_type, pointer_count|:
                pointer_count <- pointer_count + 1 if string_view_index(qual_type, index) == 42
            if pointer_count >= 2 and (sview_starts_with(base, sview("char", 0, -1)) or sview_starts_with(base, sview("const char", 0, -1)) or sview_starts_with(base, sview("unsigned char", 0, -1)) or sview_starts_with(base, sview("const unsigned char", 0, -1))):
                append_view(out, sview("cstr&&", 0, -1)) if c_type_is_const_pointer(qual_type) else append_view(out, sview("u8&&", 0, -1))
            elif sview_find_byte(base, 40) >= 0:
                append_view(out, sview("void&", 0, -1))
            elif sview_starts_with(base, sview("char", 0, -1)) or sview_starts_with(base, sview("unsigned char", 0, -1)) or sview_starts_with(base, sview("cc_t", 0, -1)):
                append_view(out, sview("u8&", 0, -1))
            elif sview_eq(base, sview("signed char", 0, -1)):
                append_view(out, sview("i8&", 0, -1))
            elif sview_eq(base, sview("float", 0, -1)):
                append_view(out, sview("f32&", 0, -1))
            elif sview_eq(base, sview("double", 0, -1)):
                append_view(out, sview("f64&", 0, -1))
            elif sview_eq(base, sview("int", 0, -1)) or sview_eq(base, sview("signed", 0, -1)) or sview_eq(base, sview("signed int", 0, -1)):
                append_view(out, sview("i32&", 0, -1))
            elif sview_eq(base, sview("unsigned", 0, -1)) or sview_eq(base, sview("unsigned int", 0, -1)):
                append_view(out, sview("u32&", 0, -1))
            elif sview_eq(base, sview("short", 0, -1)) or sview_eq(base, sview("short int", 0, -1)):
                append_view(out, sview("i16&", 0, -1))
            elif sview_eq(base, sview("unsigned short", 0, -1)) or sview_eq(base, sview("unsigned short int", 0, -1)):
                append_view(out, sview("u16&", 0, -1))
            elif sview_eq(base, sview("long", 0, -1)) or sview_eq(base, sview("long int", 0, -1)):
                append_view(out, sview("i64&", 0, -1))
            elif sview_eq(base, sview("size_t", 0, -1)):
                append_view(out, sview("usize&", 0, -1))
            elif sview_eq(base, sview("ssize_t", 0, -1)):
                append_view(out, sview("isize&", 0, -1))
            elif sview_eq(base, sview("time_t", 0, -1)) or sview_eq(base, sview("__darwin_time_t", 0, -1)):
                append_view(out, sview("i64&", 0, -1))
            elif sview_eq(base, sview("tcflag_t", 0, -1)) or sview_eq(base, sview("speed_t", 0, -1)):
                append_view(out, sview("u64&", 0, -1))
            elif sview_eq(base, sview("FILE", 0, -1)):
                append_view(out, sview("void&", 0, -1))
            elif sview_starts_with(base, sview("void", 0, -1)) or sview_find_byte(base, 40) >= 0:
                append_view(out, sview("void&", 0, -1))
            else:
                named: sview = c_type_named_base(qual_type)
                if sview_eq(named, sview("", 0, 0)):
                    append_view(out, sview("void&", 0, -1))
                else:
                    append_elisa_type_name(out, named)
                    append_view(out, sview("&", 0, -1))
        elif type_starts_with(qual_type, sview("void", 0, -1)):
            append_view(out, sview("void", 0, -1))
        elif type_starts_with(qual_type, sview("__builtin_va_list", 0, -1)) or type_starts_with(qual_type, sview("va_list", 0, -1)):
            append_view(out, sview("va_list", 0, -1))
        elif type_starts_with(qual_type, sview("time_t", 0, -1)) or type_starts_with(qual_type, sview("__darwin_time_t", 0, -1)):
            append_view(out, sview("i64", 0, -1))
        elif type_starts_with(qual_type, sview("size_t", 0, -1)) or type_starts_with(qual_type, sview("__darwin_size_t", 0, -1)) or type_starts_with(qual_type, sview("__size_t", 0, -1)):
            append_view(out, sview("usize", 0, -1))
        elif type_starts_with(qual_type, sview("ssize_t", 0, -1)) or type_starts_with(qual_type, sview("__darwin_ssize_t", 0, -1)):
            append_view(out, sview("isize", 0, -1))
        elif type_starts_with(qual_type, sview("tcflag_t", 0, -1)) or type_starts_with(qual_type, sview("speed_t", 0, -1)):
            append_view(out, sview("u64", 0, -1))
        elif type_starts_with(qual_type, sview("unsigned char", 0, -1)) or type_starts_with(qual_type, sview("cc_t", 0, -1)):
            append_view(out, sview("u8", 0, -1))
        elif type_starts_with(qual_type, sview("signed char", 0, -1)):
            append_view(out, sview("i8", 0, -1))
        elif type_starts_with(qual_type, sview("char", 0, -1)):
            append_view(out, sview("u8", 0, -1))
        elif type_starts_with(qual_type, sview("unsigned short", 0, -1)):
            append_view(out, sview("u16", 0, -1))
        elif type_starts_with(qual_type, sview("short", 0, -1)):
            append_view(out, sview("i16", 0, -1))
        elif type_starts_with(qual_type, sview("unsigned long", 0, -1)):
            append_view(out, sview("u64", 0, -1))
        elif type_starts_with(qual_type, sview("long", 0, -1)):
            append_view(out, sview("i64", 0, -1))
        elif type_starts_with(qual_type, sview("unsigned long long", 0, -1)):
            append_view(out, sview("u64", 0, -1))
        elif type_starts_with(qual_type, sview("long long", 0, -1)):
            append_view(out, sview("i64", 0, -1))
        elif type_starts_with(qual_type, sview("unsigned", 0, -1)):
            append_view(out, sview("u32", 0, -1))
        elif type_starts_with(qual_type, sview("_Bool", 0, -1)) or type_starts_with(qual_type, sview("bool", 0, -1)):
            append_view(out, sview("bool", 0, -1))
        elif type_starts_with(qual_type, sview("float", 0, -1)):
            append_view(out, sview("f32", 0, -1))
        elif type_starts_with(qual_type, sview("double", 0, -1)):
            append_view(out, sview("f64", 0, -1))
        else:
            named: sview = c_type_named_base(qual_type)
            if sview_eq(named, sview("termios", 0, -1)) or sview_eq(named, sview("winsize", 0, -1)):
                append_elisa_type_name(out, named)
            elif named.len > 0 and (sview_starts_with(qual_type, sview("struct ", 0, -1)) or sview_starts_with(qual_type, sview("union ", 0, -1)) or sview_starts_with(qual_type, sview("enum ", 0, -1))):
                append_elisa_type_name(out, named)
            else:
                append_view(out, sview("i32", 0, -1))
