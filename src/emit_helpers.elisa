extend CTranslator:
    def typed_emit_increment_helper[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, type_key: sview, mode: i64) -> void:
        append_view(out, sview("def ", 0, -1))
        typed_increment_helper_name(out, ctx, type_key, mode)
        append_view(out, sview("(value: mutable ", 0, -1))
        append_view(out, sview("u8", 0, -1)) if sview_eq(type_key, sview("bool", 0, -1)) else append_view(out, type_key)
        append_view(out, sview("&) -> ", 0, -1))
        append_view(out, type_key)
        append_view(out, sview(":\n", 0, -1))
        if mode == 1 or mode == 3:
            if sview_eq(type_key, sview("bool", 0, -1)):
                append_view(out, sview("    old: bool = value[0] != 0\n", 0, -1))
            else:
                append_view(out, sview("    old: ", 0, -1))
                append_view(out, type_key)
                append_view(out, sview(" = value[0]\n", 0, -1))
        if sview_eq(type_key, sview("bool", 0, -1)):
            if mode == 1 or mode == 2:
                append_view(out, sview("    value[0] <- 1\n", 0, -1))
            else:
                append_view(out, sview("    value[0] <- 1 if value[0] == 0 else 0\n", 0, -1))
        else:
            append_view(out, sview("    value[0] += 1\n", 0, -1)) if mode == 1 or mode == 2 else append_view(out, sview("    value[0] -= 1\n", 0, -1))
        if mode == 1 or mode == 3:
            append_view(out, sview("    return old\n\n", 0, -1))
        elif sview_eq(type_key, sview("bool", 0, -1)):
            append_view(out, sview("    return value[0] != 0\n\n", 0, -1))
        else:
            append_view(out, sview("    return value[0]\n\n", 0, -1))
    def typed_emit_increment_helpers[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, mask: i64) -> void:
        return if mask == 0
        for type_id in 0..<13 |out, ctx, mask|:
            type_key: sview = typed_increment_type_name(type_id)
            for mode in 1..<5 |out, ctx, mask, type_id, type_key|:
                typed_emit_increment_helper(out, ctx, type_key, mode) if typed_increment_helper_is_used(mask, type_id, mode)
    def typed_float_classification_kind(name: sview) -> i64:
        return 1 if sview_eq(name, sview("__builtin_isnan_value", 0, -1))
        return 2 if sview_eq(name, sview("__builtin_isinf_sign_value", 0, -1))
        return 0
    def typed_float_classification_type[@r](ctx: TypedContext[r]&, expression: TypedExpr[r]) -> sview @r:
        return sview("", 0, 0) if expression.args_count != 1 or expression.args_start < 0
        argument_index: i64 = ctx.expr_children[expression.args_start.usize()]
        return clang_target_type_abi_base(ctx.target_abi, typed_expr_at(ctx, argument_index).type_name)
    def typed_emit_float_classification_helper_name[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, kind: i64, float_type: sview) -> void:
        identity: sview = ctx.canonical_source if ctx.canonical_source.len > 0 else sview(ctx.source, 0, -1)
        source_hash: u64 = hash_sview(identity) & 0x7fffffffffffffff
        append_view(out, sview("__elisa_transpiler_", 0, -1))
        append_view(out, sview("isnan_", 0, -1)) if kind == 1 else append_view(out, sview("isinf_sign_", 0, -1))
        append_i64(out, source_hash.i64())
        append_view(out, sview("_", 0, -1))
        append_view(out, float_type)
    def typed_float_classification_helper_is_first[@r](ctx: TypedContext[r]&, index: i64) -> bool:
        current: TypedExpr[r] = typed_expr_at(ctx, index)
        kind: i64 = typed_float_classification_kind(current.text)
        return false if kind == 0
        float_type: sview = typed_float_classification_type(ctx, current)
        return false if not sview_eq(float_type, sview("f32", 0, -1)) and not sview_eq(float_type, sview("f64", 0, -1))
        for previous_index in 0..<index |ctx, current, kind, float_type|:
            previous: TypedExpr[r] = typed_expr_at(ctx, previous_index)
            return false if typed_float_classification_kind(previous.text) == kind and sview_eq(typed_float_classification_type(ctx, previous), float_type)
        return true
    def typed_emit_float_classification_helper[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64) -> void:
        expression: TypedExpr[r] = typed_expr_at(ctx, index)
        kind: i64 = typed_float_classification_kind(expression.text)
        float_type: sview = typed_float_classification_type(ctx, expression)
        append_view(out, sview("def ", 0, -1))
        typed_emit_float_classification_helper_name(out, ctx, kind, float_type)
        append_view(out, sview("(value: ", 0, -1))
        append_view(out, float_type)
        append_view(out, sview(") -> i32:\n", 0, -1))
        if kind == 1:
            append_view(out, sview("    return 1 if value != value else 0\n\n", 0, -1))
            return
        append_view(out, sview("    if value == value and value - value != ", 0, -1))
        append_view(out, sview("(0.0).f32()", 0, -1)) if sview_eq(float_type, sview("f32", 0, -1)) else append_view(out, sview("0.0", 0, -1))
        append_view(out, sview(":\n        return 1 if value > ", 0, -1))
        append_view(out, sview("(0.0).f32()", 0, -1)) if sview_eq(float_type, sview("f32", 0, -1)) else append_view(out, sview("0.0", 0, -1))
        append_view(out, sview(" else -1\n    return 0\n\n", 0, -1))
    def typed_emit_float_classification_helpers[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&) -> void:
        for index in 0..<ctx.exprs.count.i64() |out, ctx|:
            typed_emit_float_classification_helper(out, ctx, index) if typed_float_classification_helper_is_first(ctx, index)
    def typed_emit_assignment_value_helper_name[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&) -> void:
        identity: sview = ctx.canonical_source if ctx.canonical_source.len > 0 else sview(ctx.source, 0, -1)
        hash: u64 = hash_sview(identity) & 0x7fffffffffffffff
        append_view(out, sview("__elisa_transpiler_assign_value_", 0, -1))
        append_i64(out, hash.i64())
    def typed_emit_assignment_value_helper[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&) -> void:
        append_view(out, sview("def ", 0, -1))
        typed_emit_assignment_value_helper_name(out, ctx)
        append_view(out, sview("[T](place: mutable T&, value: T) -> T:\n", 0, -1))
        append_view(out, sview("    place[0] <- value\n", 0, -1))
        append_view(out, sview("    return value\n\n", 0, -1))

    def typed_emit_compound_literal_helper_name[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, readonly: bool) -> void:
        identity: sview = ctx.canonical_source if ctx.canonical_source.len > 0 else sview(ctx.source, 0, -1)
        source_hash: u64 = hash_sview(identity) & 0x7fffffffffffffff
        append_view(out, sview("__elisa_transpiler_compound_literal_", 0, -1))
        append_view(out, sview("readonly_", 0, -1)) if readonly else append_view(out, sview("mutable_", 0, -1))
        append_i64(out, source_hash.i64())

    def typed_emit_compound_literal_helper[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, readonly: bool) -> void:
        append_view(out, sview("def ", 0, -1))
        typed_emit_compound_literal_helper_name(out, ctx, readonly)
        append_view(out, sview("[T](place: mutable T&, value: T) -> ", 0, -1))
        append_view(out, sview("T&:\n", 0, -1)) if readonly else append_view(out, sview("mutable T&:\n", 0, -1))
        append_view(out, sview("    place[0] <- value\n    return place\n\n", 0, -1))
    def typed_emit_compound_assignment_value_helper[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr[r] = typed_expr_at(ctx, index)
        assignment: TypedExpr[r] = typed_expr_at(ctx, expression.lhs)
        update: TypedExpr[r] = typed_expr_at(ctx, assignment.rhs)
        target_type: sview = typed_expr_at(ctx, assignment.lhs).type_name
        value_type: sview = typed_expr_at(ctx, update.rhs).type_name
        operator_id: i64 = expression.value - 6
        identity: sview = ctx.canonical_source if ctx.canonical_source.len > 0 else sview(ctx.source, 0, -1)
        source_hash: u64 = hash_sview(identity) & 0x7fffffffffffffff
        target_hash: u64 = hash_sview(target_type) & 0x7fffffffffffffff
        value_hash: u64 = hash_sview(value_type) & 0x7fffffffffffffff
        append_view(out, sview("def __elisa_transpiler_compound_", 0, -1))
        append_view(out, typed_compound_assignment_value_name(operator_id))
        append_view(out, sview("_", 0, -1))
        append_i64(out, source_hash.i64())
        append_view(out, sview("_", 0, -1))
        append_i64(out, target_hash.i64())
        append_view(out, sview("_", 0, -1))
        append_i64(out, value_hash.i64())
        append_view(out, sview("(place: mutable ", 0, -1))
        append_c_type_contextual(out, ctx, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview("&, value: ", 0, -1))
        append_c_type_contextual(out, ctx, value_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(") -> ", 0, -1))
        append_c_type_contextual(out, ctx, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(":\n    place[0] ", 0, -1))
        append_view(out, typed_compound_assignment_value_operator(operator_id))
        append_view(out, sview(" ", 0, -1))
        if typed_compound_assignment_value_requires_conversion(ctx, update.rhs, target_type):
            append_view(out, sview("(value).", 0, -1))
            append_view(out, clang_target_type_abi_base(ctx.target_abi, target_type))
            append_view(out, sview("()", 0, -1))
        else:
            append_view(out, sview("value", 0, -1))
        append_view(out, sview("\n    return place[0]\n\n", 0, -1))
    def typed_emit_compound_assignment_value_helpers[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        for index in 0..<ctx.exprs.count.i64() |out, ctx|:
            typed_emit_compound_assignment_value_helper(out, ctx, index) if typed_compound_assignment_value_helper_is_first(ctx, index)

    def typed_emit_runtime_prelude(out: mutable darray[u8]&, needs_nonnull: bool, needs_readonly_nonnull: bool, needs_varargs: bool) -> void:
        if needs_nonnull:
            append_view(out, sview("def elisa_nonnull[T](value: mutable T&?) -> mutable T&:\n", 0, -1))
            append_view(out, sview("    if value == null:\n", 0, -1))
            append_view(out, sview("        panic(\"C null pointer assertion failed\")\n", 0, -1))
            append_view(out, sview("    return value\n\n", 0, -1))
        if needs_readonly_nonnull:
            append_view(out, sview("def elisa_nonnull_readonly[T](value: T&?) -> T&:\n", 0, -1))
            append_view(out, sview("    if value == null:\n", 0, -1))
            append_view(out, sview("        panic(\"C null pointer assertion failed\")\n", 0, -1))
            append_view(out, sview("    return value\n\n", 0, -1))
        if needs_varargs:
            append_view(out, sview("extern va_list\n\nextern va_arg[T](storage: mutable void&) -> T\n\n@intrinsic(\"llvm.va_start\")\nextern llvm_va_start(storage: mutable void&) -> void\n\nextern llvm_va_copy(destination: mutable void&, source: mutable void&) -> void\n\n@intrinsic(\"llvm.va_end\")\nextern llvm_va_end(storage: mutable void&) -> void\n\n", 0, -1))
