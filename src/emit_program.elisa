    def typed_stmt_has_name_suffix(ctx: TypedContext&, index: i64, prefix: sview, suffix: sview) -> bool:
        return false if index < 0 or index >= ctx.stmts.count.i64()
        statement: TypedStmt = typed_stmt_at(ctx, index)
        return true if statement.kind == TypedStmtKind.Declaration and typed_name_matches_suffix(statement.name, prefix, suffix)
        if statement.kind == TypedStmtKind.Block:
            for offset in 0..<statement.children_count |ctx, statement, prefix, suffix|:
                return true if typed_stmt_has_name_suffix(ctx, ctx.stmt_children[(statement.children_start + offset).usize()], prefix, suffix)
        elif statement.kind == TypedStmtKind.If:
            return true if typed_stmt_has_name_suffix(ctx, statement.aux, prefix, suffix)
            return statement.aux2 >= 0 and typed_stmt_has_name_suffix(ctx, statement.aux2, prefix, suffix)
        elif statement.kind == TypedStmtKind.For:
            return true if typed_stmt_has_name_suffix(ctx, statement.children_start, prefix, suffix)
            return true if typed_stmt_has_name_suffix(ctx, statement.aux, prefix, suffix)
            return statement.aux2 >= 0 and typed_stmt_has_name_suffix(ctx, statement.aux2, prefix, suffix)
        elif statement.kind == TypedStmtKind.While or statement.kind == TypedStmtKind.DoWhile or statement.kind == TypedStmtKind.Label:
            return typed_stmt_has_name_suffix(ctx, statement.aux if statement.kind != TypedStmtKind.Label else statement.expr, prefix, suffix)
        elif statement.kind == TypedStmtKind.Switch:
            for offset in 0..<statement.children_count |ctx, statement, prefix, suffix|:
                switch_case: TypedSwitchCase = ctx.switch_cases[(statement.children_start + offset).usize()]
                return true if typed_stmt_has_name_suffix(ctx, switch_case.body, prefix, suffix)
        return false

    def typed_parameter_alias_conflicts(ctx: TypedContext&, function: TypedFunction, parameter: TypedParam, suffix: sview) -> bool:
        for offset in 0..<function.params_count |ctx, function, parameter, suffix|:
            other: TypedParam = ctx.params[(function.params_start + offset).usize()]
            return true if not sview_eq(other.name, parameter.name) and typed_name_matches_suffix(other.name, parameter.name, suffix)
        return typed_stmt_has_name_suffix(ctx, function.body, parameter.name, suffix)

    def typed_parameter_needs_alias(ctx: TypedContext&, function: TypedFunction, parameter: TypedParam) -> bool:
        return false if c_type_pointer_count(parameter.type_name) == 0 or c_type_is_function(parameter.type_name)
        return typed_stmt_assigns_name(ctx, function.body, parameter.name)

    def typed_parameter_alias_suffix(ctx: TypedContext&, function: TypedFunction, parameter: TypedParam) -> sview:
        cursor: sview = sview("_cursor", 0, -1)
        return cursor if not typed_parameter_alias_conflicts(ctx, function, parameter, cursor) else sview("_alias", 0, -1) if not typed_parameter_alias_conflicts(ctx, function, parameter, sview("_alias", 0, -1)) else sview("_value", 0, -1)

    def typed_stmt_is_declaration_group(ctx: TypedContext&, index: i64) -> bool:
        statement: TypedStmt = typed_stmt_at(ctx, index)
        return true if statement.kind == TypedStmtKind.Declaration
        return false if statement.kind != TypedStmtKind.Block or statement.children_count == 0
        for offset in 0..<statement.children_count |ctx, statement|:
            return false if not typed_stmt_is_declaration_group(ctx, ctx.stmt_children[(statement.children_start + offset).usize()])
        return true

    def typed_stmt_guarantees_exit(ctx: TypedContext&, index: i64) -> bool:
        return false if index < 0 or index >= ctx.stmts.count.i64()
        statement: TypedStmt = typed_stmt_at(ctx, index)
        return true if statement.kind == TypedStmtKind.Return
        if statement.kind == TypedStmtKind.Block:
            for offset in 0..<statement.children_count |ctx, statement|:
                return true if typed_stmt_guarantees_exit(ctx, ctx.stmt_children[(statement.children_start + offset).usize()])
            return false
        if statement.kind == TypedStmtKind.If:
            constant: mutable i64 = 0
            if typed_eval_integer_constant(ctx, statement.expr, constant):
                return typed_stmt_guarantees_exit(ctx, statement.aux) if constant != 0
                return statement.aux2 >= 0 and typed_stmt_guarantees_exit(ctx, statement.aux2)
            return statement.aux >= 0 and statement.aux2 >= 0 and typed_stmt_guarantees_exit(ctx, statement.aux) and typed_stmt_guarantees_exit(ctx, statement.aux2)
        if statement.kind == TypedStmtKind.Switch:
            has_default: mutable bool = false
            for offset in 0..<statement.children_count |ctx, statement, has_default|:
                switch_case: TypedSwitchCase = ctx.switch_cases[(statement.children_start + offset).usize()]
                has_default <- true if switch_case.is_default
                return false if typed_stmt_contains_switch_break(ctx, switch_case.body)
                return false if not typed_stmt_guarantees_exit(ctx, switch_case.body)
            return has_default and statement.children_count > 0
        if statement.kind == TypedStmtKind.Label:
            return typed_stmt_guarantees_exit(ctx, statement.expr)
        if statement.kind == TypedStmtKind.While or statement.kind == TypedStmtKind.DoWhile or statement.kind == TypedStmtKind.For:
            return typed_expr_is_always_true(ctx, statement.expr) and typed_stmt_guarantees_exit(ctx, statement.aux)
        return false

    def typed_condition_nonnull_name(ctx: TypedContext&, index: i64, wants_true: bool) -> sview:
        return typed_null_guard_name(ctx, index, true) if wants_true else typed_null_guard_name(ctx, index, false)

    def typed_condition_nonnull_expr(ctx: TypedContext&, index: i64, wants_true: bool) -> i64:
        return -1 if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr = typed_expr_at(ctx, index)
        expected_opcode: sview = sview("!=", 0, -1) if wants_true else sview("==", 0, -1)
        return -1 if expression.kind != TypedExprKind.Binary or not sview_eq(expression.text, expected_opcode)
        lhs: TypedExpr = typed_expr_at(ctx, expression.lhs)
        rhs: TypedExpr = typed_expr_at(ctx, expression.rhs)
        # Facts are attached to places, not just identifiers. This covers
        # nullable struct fields and indexed pointer slots while keeping the
        # same conservative requirement: one side must be a null literal and
        # the other side must still have a nullable C pointer type.
        return expression.lhs if c_type_pointer_optional(lhs.type_name) and typed_expr_is_null_value(ctx, expression.rhs)
        return expression.rhs if c_type_pointer_optional(rhs.type_name) and typed_expr_is_null_value(ctx, expression.lhs)
        return -1

    def typed_push_condition_nonnull_facts(ctx: mutable TypedContext&, index: i64, wants_true: bool) -> i64:
        return 0 if index < 0 or index >= ctx.exprs.count.i64()
        # A call in the condition can mutate a pointer checked earlier in the
        # same logical expression. Keeping no fact is safer than assuming C's
        # opaque call preserved the object graph.
        return 0 if typed_expr_contains_call(ctx, index)
        expression: TypedExpr = typed_expr_at(ctx, index)
        before: i64 = ctx.current_nonnull_exprs.count.i64()
        fact: sview = typed_condition_nonnull_name(ctx, index, wants_true)
        fact_expr: i64 = typed_condition_nonnull_expr(ctx, index, wants_true)
        if fact_expr >= 0:
            # Keep the parallel fact arrays aligned. An empty name represents
            # a member/indexed place and is intentionally ignored by the name
            # fast path.
            ctx.current_nonnull_names.push(fact)
            ctx.current_nonnull_exprs.push(fact_expr)
        if expression.kind == TypedExprKind.Binary and sview_eq(expression.text, sview("and", 0, -1)) and wants_true:
            typed_push_condition_nonnull_facts(ctx, expression.lhs, true)
            typed_push_condition_nonnull_facts(ctx, expression.rhs, true)
        elif expression.kind == TypedExprKind.Binary and sview_eq(expression.text, sview("or", 0, -1)) and not wants_true:
            typed_push_condition_nonnull_facts(ctx, expression.lhs, false)
            typed_push_condition_nonnull_facts(ctx, expression.rhs, false)
        return ctx.current_nonnull_exprs.count.i64() - before

    def typed_pop_nonnull_facts(ctx: mutable TypedContext&, count: i64) -> void:
        cursor: mutable i64 = 0
        while cursor < count and ctx.current_nonnull_exprs.count > 0:
            _ = ctx.current_nonnull_exprs.pop()
            if ctx.current_nonnull_names.count > 0:
                _ = ctx.current_nonnull_names.pop()
            cursor <- cursor + 1

    def typed_invalidate_nonnull_facts(ctx: mutable TypedContext&, index: i64) -> void:
        return if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr = typed_expr_at(ctx, index)
        # A call may mutate any object reachable through a pointer argument or
        # global. Do not carry a branch-local fact across that opaque boundary.
        if typed_expr_contains_call(ctx, index):
            ctx.current_nonnull_exprs <- []
            ctx.current_nonnull_names <- []
            return
        if expression.kind == TypedExprKind.Binary and sview_eq(expression.text, sview("<-", 0, -1)):
            cursor: mutable i64 = 0
            while cursor < ctx.current_nonnull_exprs.count.i64():
                fact_expr: i64 = ctx.current_nonnull_exprs[cursor.usize()]
                lhs: TypedExpr = typed_expr_at(ctx, expression.lhs)
                same_root_write: bool = lhs.kind == TypedExprKind.Name and sview_eq(typed_expr_root_name(ctx, fact_expr), lhs.text)
                if typed_expr_is_same_place(ctx, expression.lhs, fact_expr) or same_root_write:
                    last: i64 = ctx.current_nonnull_exprs.count.i64() - 1
                    ctx.current_nonnull_exprs[cursor.usize()] <- ctx.current_nonnull_exprs[last.usize()]
                    _ = ctx.current_nonnull_exprs.pop()
                    if cursor < ctx.current_nonnull_names.count.i64():
                        last_name: i64 = ctx.current_nonnull_names.count.i64() - 1
                        ctx.current_nonnull_names[cursor.usize()] <- ctx.current_nonnull_names[last_name.usize()]
                        _ = ctx.current_nonnull_names.pop()
                else:
                    cursor <- cursor + 1
        typed_invalidate_nonnull_facts(ctx, expression.lhs) if expression.kind == TypedExprKind.Sequence
        typed_invalidate_nonnull_facts(ctx, expression.rhs) if expression.kind == TypedExprKind.Sequence

    def typed_emit_stmt_body(out: mutable darray[u8]&, ctx: mutable TypedContext&, index: i64, level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        statement: TypedStmt = typed_stmt_at(ctx, index)
        typed_emit_callback_guards(out, ctx, statement.expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console if statement.expr >= 0
        match statement.kind:
            TypedStmtKind.Block:
                if statement.children_count > 0:
                    guarded_switch: bool = ctx.current_switch_done_index >= 0 and typed_stmt_needs_switch_done(ctx, index)
                    for offset in 0..<statement.children_count |out, ctx, statement, level, guarded_switch|:
                        child_index: i64 = ctx.stmt_children[(statement.children_start + offset).usize()]
                        child: TypedStmt = typed_stmt_at(ctx, child_index)
                        if child.kind == TypedStmtKind.SwitchBreak:
                            typed_emit_stmt(out, ctx, child_index, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console if ctx.current_switch_done_index >= 0
                            break
                        child_level: mutable i64 = level
                        if guarded_switch:
                            append_indent(out, level)
                            append_view(out, sview("if not ", 0, -1))
                            typed_append_switch_done_name(out, ctx)
                            append_view(out, sview(":\n", 0, -1))
                            child_level <- level + 1
                        if ctx.current_emit_has_goto and child.kind != TypedStmtKind.Label and not typed_stmt_is_declaration_group(ctx, child_index):
                            append_indent(out, child_level)
                            append_view(out, sview("if ", 0, -1))
                            append_view(out, ctx.current_emit_goto_name)
                            append_view(out, sview(" == 0:\n", 0, -1))
                            typed_emit_stmt(out, ctx, child_index, child_level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                        else:
                            typed_emit_stmt(out, ctx, child_index, child_level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                        break if not ctx.current_emit_has_goto and typed_stmt_guarantees_exit(ctx, child_index)
                else:
                    append_indent(out, level)
                    append_view(out, sview("pass\n", 0, -1))
            TypedStmtKind.Return:
                if statement.expr >= 0 and typed_expr_at(ctx, statement.expr).kind == TypedExprKind.Binary and sview_eq(typed_expr_at(ctx, statement.expr).text, sview("<-", 0, -1)):
                    typed_emit_expression_statement(out, ctx, statement.expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_indent(out, level)
                    append_view(out, sview("return ", 0, -1))
                    typed_emit_target_value(out, ctx, typed_assignment_result(ctx, statement.expr), statement.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("\n", 0, -1))
                    return
                append_indent(out, level)
                append_view(out, sview("return", 0, -1))
                if statement.expr >= 0:
                    append_view(out, sview(" ", 0, -1))
                    typed_emit_target_value(out, ctx, statement.expr, statement.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("\n", 0, -1))
            TypedStmtKind.Declaration:
                append_indent(out, level)
                append_view(out, statement.name)
                append_view(out, sview(": mutable ", 0, -1)) if typed_declaration_is_mutable(ctx, statement) else append_view(out, sview(": ", 0, -1))
                append_c_type_contextual(out, ctx, statement.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("?", 0, -1)) if c_type_pointer_optional(statement.type_name)
                append_view(out, sview(" = ", 0, -1))
                if c_type_is_array(statement.type_name) or statement.expr < 0:
                    append_view(out, sview("zeroed", 0, -1))
                else:
                    typed_emit_target_value(out, ctx, statement.expr, statement.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("\n", 0, -1))
            TypedStmtKind.If:
                constant: mutable i64 = 0
                if typed_eval_integer_constant(ctx, statement.expr, constant):
                    if constant != 0:
                        typed_emit_stmt(out, ctx, statement.aux, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    elif statement.aux2 >= 0:
                        typed_emit_stmt(out, ctx, statement.aux2, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    else:
                        append_indent(out, level)
                        append_view(out, sview("pass\n", 0, -1))
                    return
                typed_invalidate_nonnull_facts(ctx, statement.expr) if typed_expr_contains_call(ctx, statement.expr)
                append_indent(out, level)
                append_view(out, sview("if ", 0, -1))
                typed_emit_condition(out, ctx, statement.expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(":\n", 0, -1))
                then_facts: i64 = typed_push_condition_nonnull_facts(ctx, statement.expr, true)
                typed_emit_stmt(out, ctx, statement.aux, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                typed_pop_nonnull_facts(ctx, then_facts)
                if statement.aux2 >= 0:
                    append_indent(out, level)
                    append_view(out, sview("else:\n", 0, -1))
                    else_facts: i64 = typed_push_condition_nonnull_facts(ctx, statement.expr, false)
                    typed_emit_stmt(out, ctx, statement.aux2, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    typed_pop_nonnull_facts(ctx, else_facts)
                # An early-return guard establishes the opposite fact on the
                # path that continues after the `if`. Carry that fact forward
                # instead of reasserting the same nullable pointer at every
                # later dereference.
                if statement.aux2 < 0 and typed_stmt_guarantees_exit(ctx, statement.aux):
                    _ = typed_push_condition_nonnull_facts(ctx, statement.expr, false)
                elif statement.aux2 >= 0 and typed_stmt_guarantees_exit(ctx, statement.aux2):
                    _ = typed_push_condition_nonnull_facts(ctx, statement.expr, true)
            TypedStmtKind.While:
                typed_invalidate_nonnull_facts(ctx, statement.expr) if typed_expr_contains_call(ctx, statement.expr)
                append_indent(out, level)
                if ctx.current_emit_has_goto and typed_expr_is_always_true(ctx, statement.expr):
                    append_view(out, sview("while ", 0, -1))
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" == 0", 0, -1))
                elif ctx.current_emit_has_goto:
                    append_view(out, sview("while ((", 0, -1))
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" == 0) and (", 0, -1))
                    typed_emit_condition(out, ctx, statement.expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("))", 0, -1))
                elif typed_expr_is_always_true(ctx, statement.expr):
                    append_view(out, sview("while true", 0, -1))
                else:
                    append_view(out, sview("while ", 0, -1))
                    typed_emit_condition(out, ctx, statement.expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(":\n", 0, -1))
                loop_facts: i64 = typed_push_condition_nonnull_facts(ctx, statement.expr, true)
                typed_emit_stmt(out, ctx, statement.aux, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                typed_pop_nonnull_facts(ctx, loop_facts)
            TypedStmtKind.DoWhile:
                typed_invalidate_nonnull_facts(ctx, statement.expr) if typed_expr_contains_call(ctx, statement.expr)
                append_indent(out, level)
                append_view(out, sview("while true:\n", 0, -1))
                typed_emit_stmt(out, ctx, statement.aux, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                if ctx.current_emit_has_goto:
                    append_indent(out, level + 1)
                    append_view(out, sview("break if ", 0, -1))
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" != 0\n", 0, -1))
                append_indent(out, level + 1)
                append_view(out, sview("break if not ", 0, -1))
                typed_emit_condition(out, ctx, statement.expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("\n", 0, -1))
            TypedStmtKind.For:
                typed_invalidate_nonnull_facts(ctx, statement.expr) if typed_expr_contains_call(ctx, statement.expr)
                if statement.children_start >= 0:
                    typed_emit_stmt(out, ctx, statement.children_start, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_indent(out, level)
                if ctx.current_emit_has_goto:
                    append_view(out, sview("while ((", 0, -1))
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" == 0) and (", 0, -1))
                    typed_emit_condition(out, ctx, statement.expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("))", 0, -1))
                else:
                    append_view(out, sview("while ", 0, -1))
                    typed_emit_condition(out, ctx, statement.expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(":\n", 0, -1))
                loop_facts: i64 = typed_push_condition_nonnull_facts(ctx, statement.expr, true)
                typed_emit_stmt(out, ctx, statement.aux, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                # A C `for` increment runs after each body iteration, not after
                # the loop. `continue` already carries its increment in the
                # lowered body, so this handles the fall-through path.
                typed_emit_stmt(out, ctx, statement.aux2, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console if statement.aux2 >= 0 and not typed_stmt_guarantees_exit(ctx, statement.aux)
                typed_pop_nonnull_facts(ctx, loop_facts)
            TypedStmtKind.Break:
                append_indent(out, level)
                append_view(out, sview("break\n", 0, -1))
            TypedStmtKind.Continue:
                append_indent(out, level)
                append_view(out, sview("continue\n", 0, -1))
            TypedStmtKind.Switch:
                typed_invalidate_nonnull_facts(ctx, statement.expr) if typed_expr_contains_call(ctx, statement.expr)
                saved_switch_done_index: i64 = ctx.current_switch_done_index
                needs_switch_done: bool = typed_switch_needs_done(ctx, index)
                ctx.current_switch_done_index <- index if needs_switch_done else -1
                if needs_switch_done:
                    append_indent(out, level)
                    typed_append_switch_done_name(out, ctx)
                    append_view(out, sview(": mutable bool = false\n", 0, -1))
                append_indent(out, level)
                append_view(out, sview("match ", 0, -1))
                typed_emit_expr(out, ctx, statement.expr) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview(":\n", 0, -1))
                has_default: mutable bool = false
                offset: mutable i64 = 0
                while offset < statement.children_count |out, ctx, statement, level, has_default, offset|:
                    switch_case: TypedSwitchCase = ctx.switch_cases[(statement.children_start + offset).usize()]
                    append_indent(out, level + 1)
                    if switch_case.is_default:
                        append_view(out, sview("_:\n", 0, -1))
                        has_default <- true
                    else:
                        group_end: mutable i64 = offset + 1
                        while group_end < statement.children_count |ctx, statement, switch_case, group_end|:
                            next_case: TypedSwitchCase = ctx.switch_cases[(statement.children_start + group_end).usize()]
                            break if next_case.is_default or next_case.body != switch_case.body
                            group_end <- group_end + 1
                        typed_emit_switch_case_pattern(out, ctx, statement, offset, group_end) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                        offset <- group_end - 1
                        append_view(out, sview(":\n", 0, -1))
                    typed_emit_switch_case_body(out, ctx, switch_case.body, level + 2) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    offset <- offset + 1
                if not has_default:
                    append_indent(out, level + 1)
                    append_view(out, sview("_:\n", 0, -1))
                    append_indent(out, level + 2)
                    append_view(out, sview("pass\n", 0, -1))
                ctx.current_switch_done_index <- saved_switch_done_index
            TypedStmtKind.SwitchBreak:
                if ctx.current_switch_done_index >= 0:
                    append_indent(out, level)
                    typed_append_switch_done_name(out, ctx)
                    append_view(out, sview(" <- true\n", 0, -1))
            TypedStmtKind.Goto:
                append_indent(out, level)
                append_view(out, ctx.current_emit_goto_name)
                append_view(out, sview(" <- ", 0, -1))
                append_i64(out, statement.aux + 1)
                append_view(out, sview("\n", 0, -1))
            TypedStmtKind.Label:
                if ctx.current_emit_has_goto:
                    append_indent(out, level)
                    append_view(out, sview("if ((", 0, -1))
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" == 0) or (", 0, -1))
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" == ", 0, -1))
                    append_i64(out, statement.aux + 1)
                    append_view(out, sview(")):\n", 0, -1))
                    append_indent(out, level + 1)
                    append_view(out, sview("if ", 0, -1))
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" == ", 0, -1))
                    append_i64(out, statement.aux + 1)
                    append_view(out, sview(":\n", 0, -1))
                    append_indent(out, level + 2)
                    append_view(out, ctx.current_emit_goto_name)
                    append_view(out, sview(" <- 0\n", 0, -1))
                    typed_emit_stmt(out, ctx, statement.expr, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                else:
                    typed_emit_stmt(out, ctx, statement.expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            TypedStmtKind.Expression:
                typed_invalidate_nonnull_facts(ctx, statement.expr)
                typed_emit_expression_statement(out, ctx, statement.expr, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            TypedStmtKind.Null:
                append_indent(out, level)
                append_view(out, sview("pass\n", 0, -1))
            _:
                append_indent(out, level)
                append_view(out, sview("<invalid-ir>\n", 0, -1))

    def typed_emit_stmt(out: mutable darray[u8]&, ctx: mutable TypedContext&, index: i64, level: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        if ctx.mode == TypedTranslationMode.Idiomatic and typed_stmt_directly_needs_unsafe(ctx, index):
            append_indent(out, level)
            append_view(out, sview("trusted Unsafe.StaleRef:\n", 0, -1))
            typed_emit_stmt_body(out, ctx, index, level + 1) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        else:
            typed_emit_stmt_body(out, ctx, index, level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_emit_function(out: mutable darray[u8]&, ctx: mutable TypedContext&, function: TypedFunction) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        if function.comment.len > 0:
            append_view(out, sview("#", 0, -1))
            append_view(out, function.comment)
            append_view(out, sview("\n", 0, -1))
        append_view(out, sview("def ", 0, -1))
        append_view(out, function.name)
        append_view(out, sview("(", 0, -1))
        if function.params_count > 0:
            for offset in 0..<function.params_count |out, ctx, function|:
                append_view(out, sview(", ", 0, -1)) if offset > 0
                parameter: TypedParam = ctx.params[(function.params_start + offset).usize()]
                append_view(out, parameter.name)
                if typed_parameter_is_mutable(ctx, function, parameter):
                    append_view(out, sview(": mutable ", 0, -1))
                else:
                    append_view(out, sview(": ", 0, -1))
                append_c_type_contextual(out, ctx, parameter.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("?", 0, -1)) if c_type_pointer_optional(parameter.type_name)
        if function.variadic:
            append_view(out, sview(", ...", 0, -1)) if function.params_count > 0
            append_view(out, sview("...", 0, -1)) if function.params_count == 0
        append_view(out, sview(") -> ", 0, -1))
        append_function_return_type(out, function.return_type)
        body_level: i64 = typed_emit_function_effects(out, ctx, function)
        # These are function-local emission facts. Function bodies are emitted
        # sequentially, so clearing the context-owned arrays is both sufficient
        # and stage-1-safe; copying auto-region darray values into a longer-lived
        # context field is rejected as an escaping borrow by the backend.
        ctx.current_name_aliases <- []
        ctx.current_nonnull_names <- []
        ctx.current_nonnull_exprs <- []
        if function.params_count > 0:
            for offset in 0..<function.params_count |out, ctx, function|:
                parameter: TypedParam = ctx.params[(function.params_start + offset).usize()]
                if typed_parameter_needs_alias(ctx, function, parameter):
                    suffix: sview = typed_parameter_alias_suffix(ctx, function, parameter)
                    ctx.current_name_aliases.push(TypedNameAlias{source: parameter.name, suffix: suffix})
                    append_indent(out, body_level)
                    append_view(out, parameter.name)
                    append_view(out, suffix)
                    append_view(out, sview(": mutable ", 0, -1))
                    append_c_type_contextual(out, ctx, parameter.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("?", 0, -1)) if c_type_pointer_optional(parameter.type_name)
                    append_view(out, sview(" = ", 0, -1))
                    append_view(out, parameter.name)
                    append_view(out, sview("\n", 0, -1))
        if sview_eq(function.name, sview("main", 0, -1)) and typed_has_global_initializers(ctx):
            append_indent(out, body_level)
            append_view(out, typed_global_initializer_name(ctx))
            append_view(out, sview("()\n", 0, -1))
        saved_emit_has_goto: bool = ctx.current_emit_has_goto
        saved_goto_name: sview = ctx.current_emit_goto_name
        saved_function_body: i64 = ctx.current_function_body
        ctx.current_emit_has_goto <- function.has_goto
        ctx.current_emit_goto_name <- typed_goto_state_name(ctx, function)
        ctx.current_function_body <- function.body
        ctx.current_switch_done_name <- sview("switch_done", 0, -1)
        if typed_flow_name_conflicts(ctx, function, ctx.current_switch_done_name):
            ctx.current_switch_done_name <- sview("switch_control", 0, -1)
        if function.has_goto:
            typed_emit_flow_body(out, ctx, function, body_level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        else:
            typed_emit_stmt(out, ctx, function.body, body_level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        ctx.current_emit_has_goto <- saved_emit_has_goto
        ctx.current_emit_goto_name <- saved_goto_name
        ctx.current_function_body <- saved_function_body
        ctx.current_switch_done_name <- sview("", 0, 0)
        ctx.current_switch_done_index <- -1
        ctx.current_name_aliases <- []
        ctx.current_nonnull_names <- []
        ctx.current_nonnull_exprs <- []
        if (function.has_goto or not typed_stmt_guarantees_exit(ctx, function.body)) and not sview_starts_with(c_function_return_type(function.return_type), sview("void", 0, -1)):
            append_indent(out, body_level)
            append_view(out, sview("return null\n", 0, -1)) if sview_find_byte(c_function_return_type(function.return_type), 42) >= 0 else append_view(out, sview("return 0\n", 0, -1))

    def typed_has_global_initializers(ctx: TypedContext&) -> bool:
        for index in 0..<ctx.globals.count |ctx|:
            return true if ctx.globals[index].initializer >= 0
        return false

    def typed_global_initializer_name(ctx: TypedContext&) -> sview:
        candidate: sview = sview("initialize_globals", 0, -1)
        return candidate if not typed_context_name_conflicts(ctx, candidate)
        return sview("elisa_initialize_globals", 0, -1)

    def typed_emit_global_initializers(out: mutable darray[u8]&, ctx: TypedContext&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if not typed_has_global_initializers(ctx)
        append_view(out, sview("def ", 0, -1))
        append_view(out, typed_global_initializer_name(ctx))
        append_view(out, sview("() -> void can[Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:\n", 0, -1))
        append_view(out, sview("    can Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:\n", 0, -1))
        for index in 0..<ctx.globals.count |out, ctx|:
            typed_global: TypedGlobal = ctx.globals[index.usize()]
            if typed_global.initializer >= 0:
                append_view(out, sview("        trusted Unsafe.StaleRef:\n            ", 0, -1))
                append_view(out, typed_global.name)
                append_view(out, sview(" <- ", 0, -1))
                typed_emit_initializer_value(out, ctx, typed_global.initializer, typed_global.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("\n", 0, -1))
        append_view(out, sview("\n", 0, -1))

    def typed_emit_program(out: mutable darray[u8]&, ctx: mutable TypedContext&, with_prelude: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        typed_emit_runtime_prelude(out, typed_context_needs_nonnull_helper(ctx), typed_context_needs_readonly_nonnull_helper(ctx), typed_context_needs_varargs(ctx)) if with_prelude
        typed_emit_types(out, ctx) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        typed_emit_externals(out, ctx) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if ctx.globals.count > 0:
            for index in 0..<ctx.globals.count |out, ctx|:
                typed_global: TypedGlobal = ctx.globals[index.usize()]
                if typed_global.comment.len > 0:
                    append_view(out, sview("#", 0, -1))
                    append_view(out, typed_global.comment)
                    append_view(out, sview("\n", 0, -1))
                append_view(out, sview("global mutable ", 0, -1))
                append_view(out, typed_global.name)
                append_view(out, sview(": ", 0, -1))
                append_c_type_contextual(out, ctx, typed_global.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("?", 0, -1)) if c_type_pointer_optional(typed_global.type_name)
                append_view(out, sview(" = zeroed", 0, -1))
                append_view(out, sview("\n\n", 0, -1))
        typed_emit_global_initializers(out, ctx) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        for index in 0..<ctx.functions.count |out, ctx|:
            typed_emit_function(out, ctx, ctx.functions[index.usize()]) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview("\n", 0, -1)) if index + 1 < ctx.functions.count

    def typed_append_diagnostic(out: mutable darray[u8]&, diagnostic: TypedDiagnostic) -> void:
        append_view(out, sview("elisa-c-transpiler: unsupported ", 0, -1))
        append_view(out, diagnostic.category)
        append_view(out, sview(" ", 0, -1))
        append_view(out, diagnostic.kind)
        append_view(out, sview(" at ", 0, -1))
        append_view(out, diagnostic.source)
        append_view(out, sview(":", 0, -1)) if diagnostic.source.len > 0
        append_i64(out, diagnostic.line)
        append_view(out, sview(":", 0, -1))
        append_i64(out, diagnostic.column)
        append_view(out, sview("\n", 0, -1))

    def translate_ast_mode_with_options(ast_bytes: darray[u8], source: cstr, with_prelude: bool, mode: TypedTranslationMode) -> TypedTranslation can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        output: mutable darray[u8] = []
        parsed: JsonParseResult = json_parse_checked(&perm_arena, bytes_view(ast_bytes))
        if parsed.code != JsonErrorCode.OK:
            diagnostics: mutable darray[TypedDiagnostic] = []
            diagnostics.push(TypedDiagnostic{category: sview("AST", 0, -1), kind: sview("invalid-json", 0, -1), source: sview(source, 0, -1), line: 0, column: parsed.pos})
            return TypedTranslation{output: output, diagnostics: diagnostics, failed: true}
        context: mutable TypedContext = TypedContext{exprs: [], expr_children: [], stmts: [], stmt_children: [], params: [], current_name_aliases: [], current_nonnull_names: [], current_nonnull_exprs: [], extern_params: [], globals: [], functions: [], user_function_names: [], externs: [], extern_globals: [], fields: [], records: [], enums: [], enum_consts: [], labels: [], switch_cases: [], decl_infos: [], break_scopes: [], switch_depth: 0, current_for_increment: -1, current_return_type: sview("", 0, 0), current_has_goto: false, current_emit_has_goto: false, current_structured_break_label: -1, current_emit_goto_name: sview("", 0, 0), current_switch_done_name: sview("", 0, 0), current_switch_done_index: -1, current_function_body: -1, mode: mode, source: source, root: JsonValue.Null, diagnostics: []}
        root: JsonValue = parsed.value
        context.root <- root
        typed_collect_types(&context, root, source) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        typed_collect_external_globals(&context, root)
        typed_collect_user_functions(&context, root, source) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        declarations: JsonValue = ast_children(root)
        count: i64 = json_array_len(declarations)
        if count >= 0:
            for index in 0..<count |context, declarations, source|:
                declaration: JsonValue = ast_array_item(declarations, index)
                if sview_eq(ast_kind(declaration), sview("VarDecl", 0, -1)) and ast_is_user_declaration(declaration, source):
                    name: sview = safe_identifier(ast_name(declaration))
                    if name.len > 0 and typed_global_index(context, name) < 0:
                        initializer: mutable i64 = -1
                        if ast_child_count(declaration) > 0:
                            initializer <- typed_lower_expr(&context, ast_child(declaration, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                        context.globals.push(TypedGlobal{name: name, type_name: ast_c_type(declaration), initializer: initializer, comment: ast_comment_text(declaration)})
            for index in 0..<count |output, declarations|:
                declaration: JsonValue = ast_array_item(declarations, index)
                if sview_eq(ast_kind(declaration), sview("FunctionDecl", 0, -1)) and ast_has_child(declaration, sview("CompoundStmt", 0, -1)) and ast_is_user_declaration(declaration, source):
                    typed_collect_globals(&context, declaration) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            for index in 0..<count |output, declarations|:
                declaration: JsonValue = ast_array_item(declarations, index)
                if sview_eq(ast_kind(declaration), sview("FunctionDecl", 0, -1)) and ast_has_child(declaration, sview("CompoundStmt", 0, -1)) and ast_is_user_declaration(declaration, source):
                    lowered_function: i64 = typed_lower_function(&context, declaration)
                    _ = lowered_function
        if context.diagnostics.count == 0:
            append_view(&output, sview("# Generated by the Elisa C translator.\n\n", 0, -1))
            typed_emit_program(&output, &context, with_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            output <- typed_format_output(output)
        return TypedTranslation{output: output, diagnostics: context.diagnostics, failed: context.diagnostics.count > 0}

    def translate_ast_mode(ast_bytes: darray[u8], source: cstr, with_prelude: bool) -> TypedTranslation can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        region translation:
            return translate_ast_mode_with_options(ast_bytes, source, with_prelude, TypedTranslationMode.Idiomatic) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def translate_ast(ast_bytes: darray[u8], source: cstr) -> TypedTranslation can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        region translation:
            return translate_ast_mode_with_options(ast_bytes, source, true, TypedTranslationMode.Idiomatic) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
