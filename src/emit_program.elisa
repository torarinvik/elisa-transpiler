extend CTranslator:
    def typed_emit_function[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, function: TypedFunction[r]) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        if function.link_name.len > 0 and sview_eq(function.link_name, function.name):
            append_view(out, sview("@link_name(\"__elisa_c_impl_", 0, -1))
            append_view(out, function.name)
            append_view(out, sview("__", 0, -1))
            append_i64(out, function.params_count)
            append_view(out, sview("\")\n", 0, -1))
        if function.comment.len > 0:
            append_view(out, sview("#", 0, -1))
            append_view(out, function.comment)
            append_view(out, sview("\n", 0, -1))
        append_view(out, sview("def ", 0, -1))
        if ctx.project_mode and function.internal_linkage:
            typed_emit_internal_function_name(out, ctx, function)
        elif typed_function_is_header_inline(function):
            typed_emit_header_inline_function_name(out, function.name, function.params_count)
        else:
            typed_emit_function_name(out, ctx, function.name, function.params_count)
        append_view(out, sview("(", 0, -1))
        if function.params_count > 0:
            for offset in 0..<function.params_count |out, ctx, function|:
                append_view(out, sview(", ", 0, -1)) if offset > 0
                parameter: TypedParam[r] = ctx.params[(function.params_start + offset).usize()]
                append_view(out, parameter.name)
                if typed_parameter_is_mutable(ctx, function, parameter) and not c_type_pointer_layers_composable(parameter.type_name):
                    append_view(out, sview(": mutable ", 0, -1))
                else:
                    append_view(out, sview(": ", 0, -1))
                append_c_type_contextual(out, ctx, parameter.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(parameter.type_name)
        if function.variadic:
            append_view(out, sview(", ...", 0, -1)) if function.params_count > 0
            append_view(out, sview("...", 0, -1)) if function.params_count == 0
        append_view(out, sview(") -> ", 0, -1))
        append_function_return_type(out, ctx, function.return_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        body_level: i64 = typed_emit_function_effects(out, ctx, function)
        # These are function-local emission facts. Function bodies are emitted
        # sequentially, so clearing the context-owned arrays is both sufficient
        # and stage-1-safe; copying auto-region darray values into a longer-lived
        # context field is rejected as an escaping borrow by the backend.
        ctx.current_name_aliases <- []
        ctx.current_declared_names <- []
        ctx.current_declared_scope_starts <- []
        ctx.current_nonnull_names <- []
        ctx.current_nonnull_exprs <- []
        if function.params_count > 0:
            for offset in 0..<function.params_count |out, ctx, function|:
                parameter: TypedParam[r] = ctx.params[(function.params_start + offset).usize()]
                if typed_parameter_needs_alias(ctx, function, parameter):
                    suffix: sview = typed_parameter_alias_suffix(ctx, function, parameter)
                    ctx.current_name_aliases.push(TypedNameAlias[r]{source: parameter.name, suffix: suffix})
                    append_indent(out, body_level)
                    append_view(out, parameter.name)
                    append_view(out, suffix)
                    append_view(out, sview(": mutable ", 0, -1))
                    append_c_type_contextual(out, ctx, parameter.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(parameter.type_name)
                    append_view(out, sview(" = ", 0, -1))
                    append_view(out, parameter.name)
                    append_view(out, sview("\n", 0, -1))
        if sview_eq(function.name, sview("main", 0, -1)) and (ctx.project_mode or typed_has_global_initializers(ctx)):
            append_indent(out, body_level)
            if ctx.project_mode:
                # Project manifests install one deterministic initializer
                # runner after all translated modules. Calling that runner
                # from main makes globals from every C/C++ translation unit
                # behave like their source-language static initialization.
                append_view(out, sview("elisa_init_project()\n", 0, -1))
            elif typed_has_global_initializers(ctx):
                append_view(out, typed_global_initializer_name(ctx))
                append_view(out, sview("()\n", 0, -1))
        saved_emit_has_goto: bool = ctx.current_emit_has_goto
        saved_goto_name: sview = ctx.current_emit_goto_name
        saved_function_body: i64 = ctx.current_function_body
        ctx.current_emit_has_goto <- function.has_goto
        ctx.current_emit_goto_name <- typed_goto_state_name(ctx, function)
        ctx.current_function_body <- function.body
        ctx.current_switch_done_name <- sview("switch_done", 0, -1)
        if typed_flow_name_conflicts(ctx, function, ctx.current_switch_done_name):
            ctx.current_switch_done_name <- sview("switch_control", 0, -1)
        if function.has_goto:
            typed_emit_flow_body(out, ctx, function, body_level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        else:
            typed_emit_stmt(out, ctx, function.body, body_level) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        ctx.current_emit_has_goto <- saved_emit_has_goto
        ctx.current_emit_goto_name <- saved_goto_name
        ctx.current_function_body <- saved_function_body
        ctx.current_switch_done_name <- sview("", 0, 0)
        ctx.current_switch_done_index <- -1
        ctx.current_name_aliases <- []
        ctx.current_declared_names <- []
        ctx.current_declared_scope_starts <- []
        ctx.current_nonnull_names <- []
        ctx.current_nonnull_exprs <- []
        if (function.has_goto or not typed_stmt_guarantees_exit(ctx, function.body)) and not sview_starts_with(c_function_return_type(function.return_type), sview("void", 0, -1)):
            append_indent(out, body_level)
            append_view(out, sview("return null\n", 0, -1)) if sview_find_byte(c_function_return_type(function.return_type), 42) >= 0 else append_view(out, sview("return 0\n", 0, -1))

    # Elisa deliberately internalizes ordinary program definitions. In project
    # mode a translated C/C++ unit still has to preserve the source language's
    # external-linkage surface for a neighboring object, so publish a thin
    # wrapper while leaving the actual implementation and all internal calls
    # untouched. The wrapper name is Elisa-private and the native name comes
    # from Clang's ABI spelling; no source-library names are special-cased here.
    def typed_external_wrapper_needs_adapter[@r](ctx: TypedContext[r]&, function: TypedFunction[r]) -> bool:
        # Elisa's `export fn ... = target` form names a function by source
        # spelling and arity. That is sufficient for C, but ambiguous when
        # C++ leaves several same-arity overloads under one Elisa name.
        # Detect that generic shape here; no library name is special-cased.
        for index in 0..<ctx.functions.count |ctx, function|:
            other: TypedFunction[r] = ctx.functions[index.usize()]
            if not other.internal_linkage and sview_eq(other.name, function.name) and other.params_count == function.params_count:
                differs: mutable bool = false
                for offset in 0..<function.params_count |ctx, function, other, differs|:
                    left: TypedParam[r] = ctx.params[(function.params_start + offset).usize()]
                    right: TypedParam[r] = ctx.params[(other.params_start + offset).usize()]
                    if not sview_eq(c_type_without_qualifiers(left.type_name), c_type_without_qualifiers(right.type_name)) or left.is_mutable != right.is_mutable:
                        differs <- true
                        break
                return true if differs
        return false

    def typed_emit_external_adapter_name[@r](out: mutable darray[u8]&, function: TypedFunction[r]) -> void:
        append_view(out, sview("__elisa_c_abi_adapter_", 0, -1))
        append_view(out, function.name)
        append_view(out, sview("__", 0, -1))
        append_i64(out, function.params_count)
        append_view(out, sview("__", 0, -1))
        append_i64(out, (hash_sview(function.link_name) & 0x7fffffffffffffff).i64())
    def typed_emit_external_wrapper_adapter[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, function: TypedFunction[r]) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        append_view(out, sview("def ", 0, -1))
        typed_emit_external_adapter_name(out, function)
        append_view(out, sview("(", 0, -1))
        if function.params_count > 0:
            for offset in 0..<function.params_count |out, ctx, function|:
                append_view(out, sview(", ", 0, -1)) if offset > 0
                parameter: TypedParam[r] = ctx.params[(function.params_start + offset).usize()]
                append_view(out, parameter.name)
                append_view(out, sview(": mutable ", 0, -1)) if typed_parameter_is_mutable(ctx, function, parameter) and not c_type_pointer_layers_composable(parameter.type_name) else append_view(out, sview(": ", 0, -1))
                append_c_type_contextual(out, ctx, parameter.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(parameter.type_name)
        append_view(out, sview(") -> ", 0, -1))
        append_function_return_type(out, ctx, function.return_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        body_level: i64 = typed_emit_function_effects(out, ctx, function)
        append_indent(out, body_level)
        returns_void: bool = sview_starts_with(c_function_return_type(function.return_type), sview("void", 0, -1))
        append_view(out, function.name) if returns_void else append_view(out, sview("return ", 0, -1))
        append_view(out, function.name) if not returns_void
        append_view(out, sview("(", 0, -1))
        if function.params_count > 0:
            for offset in 0..<function.params_count |out, ctx, function|:
                append_view(out, sview(", ", 0, -1)) if offset > 0
                parameter: TypedParam[r] = ctx.params[(function.params_start + offset).usize()]
                append_view(out, parameter.name)
        append_view(out, sview(")\n", 0, -1))
    def typed_emit_external_wrapper[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, function: TypedFunction[r]) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if function.link_name.len == 0 or function.variadic
        needs_adapter: bool = typed_external_wrapper_needs_adapter(ctx, function)
        typed_emit_external_wrapper_adapter(out, ctx, function) if needs_adapter
        append_view(out, sview("\n", 0, -1)) if needs_adapter
        append_view(out, sview("@link_name(\"", 0, -1))
        append_view(out, function.link_name)
        append_view(out, sview("\")\nexport fn __c_abi_", 0, -1))
        append_view(out, function.name)
        append_view(out, sview("__", 0, -1))
        append_i64(out, function.params_count)
        if ctx.source_language_is_cxx and function.link_name.len > 0 and not sview_eq(function.link_name, function.name):
            wrapper_identity: u64 = hash_sview(function.link_name) & 0x7fffffffffffffff
            append_view(out, sview("__abi_", 0, -1))
            append_i64(out, wrapper_identity.i64())
        append_view(out, sview("(", 0, -1))
        if function.params_count > 0:
            for offset in 0..<function.params_count |out, ctx, function|:
                append_view(out, sview(", ", 0, -1)) if offset > 0
                parameter: TypedParam[r] = ctx.params[(function.params_start + offset).usize()]
                append_view(out, parameter.name)
                append_view(out, sview(": mutable ", 0, -1)) if typed_parameter_is_mutable(ctx, function, parameter) and not c_type_pointer_layers_composable(parameter.type_name) else append_view(out, sview(": ", 0, -1))
                append_c_type_contextual(out, ctx, parameter.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(parameter.type_name)
        append_view(out, sview(") -> ", 0, -1))
        append_function_return_type(out, ctx, function.return_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(" = ", 0, -1))
        if needs_adapter:
            typed_emit_external_adapter_name(out, function)
        else:
            # The compact path is sufficient for unambiguous C and C++ symbols.
            append_view(out, function.name)
        append_view(out, sview("\n", 0, -1))
    def typed_has_global_initializers[@r](ctx: TypedContext[r]&) -> bool:
        for index in 0..<ctx.globals.count |ctx|:
            global_value: TypedGlobal[r] = ctx.globals[index]
            return true if global_value.initializer >= 0 and not global_value.initializer_is_direct
        return false

    # File-scope C initializers are required to be static expressions. Keep
    # the direct-global path conservative: every accepted node must be pure and
    # every nested value must be representable by the normal initializer
    # emitter. Calls, reads of other mutable objects, address arithmetic and
    # assignment sequences stay on the runtime path (or produce a diagnostic
    # for a source-level const object).
    def typed_global_initializer_expr_is_static[@r](ctx: TypedContext[r]&, index: i64, depth: i64) -> bool:
        return false if index < 0 or index >= ctx.exprs.count.i64() or depth > 128
        expression: TypedExpr[r] = ctx.exprs[index.usize()]
        return true if expression.kind == TypedExprKind.Integer or expression.kind == TypedExprKind.Floating or expression.kind == TypedExprKind.String or expression.kind == TypedExprKind.Character or expression.kind == TypedExprKind.Null or expression.kind == TypedExprKind.Zeroed
        match expression.kind:
            TypedExprKind.Name:
                # Enum constants are emitted as Elisa enum members. Other
                # names may refer to mutable storage or to a project symbol
                # whose initialization order is not represented here.
                return expression.value == 1 or expression.value == 2
            TypedExprKind.Unary:
                return false if sview_eq(expression.text, sview("&", 0, -1)) else typed_global_initializer_expr_is_static(ctx, expression.lhs, depth + 1)
            TypedExprKind.Binary:
                return false if sview_eq(expression.text, sview("<-", 0, -1)) else typed_global_initializer_expr_is_static(ctx, expression.lhs, depth + 1) and typed_global_initializer_expr_is_static(ctx, expression.rhs, depth + 1)
            TypedExprKind.Conditional:
                return typed_global_initializer_expr_is_static(ctx, expression.lhs, depth + 1) and typed_global_initializer_expr_is_static(ctx, expression.rhs, depth + 1) and typed_global_initializer_expr_is_static(ctx, expression.third, depth + 1)
            TypedExprKind.Cast:
                return typed_global_initializer_expr_is_static(ctx, expression.lhs, depth + 1)
            TypedExprKind.Sizeof:
                return true
            TypedExprKind.ObjectSizeRemaining:
                return true
            TypedExprKind.Aggregate:
                for offset in 0..<expression.args_count |ctx, expression, depth|:
                    return false if not typed_global_initializer_expr_is_static(ctx, ctx.expr_children[(expression.args_start + offset).usize()], depth + 1)
                return true
            _:
                return false
    def typed_global_initializer_is_direct[@r](ctx: TypedContext[r]&, index: i64, target_type: sview) -> bool:
        return false if index < 0
        # Keep pointer/address materialization out of this first direct path;
        # the source binding still remains immutable, but unsupported dynamic
        # initialization is reported instead of silently weakening it.
        return false if c_type_pointer_count(target_type) > 0 or c_type_is_function_pointer(target_type) or c_type_reference_count(target_type) > 0
        return false if not (c_type_is_integer(target_type) or c_type_is_floating(target_type) or c_type_is_enum(target_type) or c_type_is_array(target_type) or typed_record_index(ctx, target_type) >= 0)
        return typed_global_initializer_expr_is_static(ctx, index, 0)
    def typed_global_source_is_mutable[@r](ctx: mutable TypedContext[r]&, declaration: JsonValueHandle[r], global_type: sview, initializer: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        source_const: bool = c_type_is_const_object(global_type)
        direct: bool = typed_global_initializer_is_direct(ctx, initializer, global_type) if initializer >= 0 else false
        if source_const and initializer >= 0 and not direct:
            typed_record_diagnostic(ctx, declaration, sview("global", 0, -1), sview("const-global-initializer-requires-static-emission", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        return not source_const or (initializer >= 0 and not direct)

    def typed_project_initializer_name(source: cstr) -> sview can[Memory.Allocate, Abort.Panic]:
        path: sview = sview(source, 0, -1)
        start: mutable i64 = 0
        for index in 0..<path.len |path, start|:
            start <- index + 1 if string_view_index(path, index) == 47
        end: mutable i64 = path.len
        for index in start..<path.len |path, start, end|:
            if string_view_index(path, index) == 46:
                end <- index
                break
        out: mutable darray[u8] = []
        append_literal(&out, "elisa_init_")
        if end <= start:
            append_literal(&out, "unit")
        else:
            for index in start..<end |out, path, start, end|:
                byte: i64 = string_view_index(path, index)
                if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95:
                    out.push(byte.u8())
                else:
                    out.push(95)
        copied: cstr = string_view_copy(bytes_view(out)) can Memory.Allocate
        return sview(copied, 0, -1)
    def typed_global_initializer_name[@r](ctx: TypedContext[r]&) -> sview @r:
        return ctx.initializer_name if ctx.project_mode and ctx.initializer_name.len > 0
        candidate: sview = sview("initialize_globals", 0, -1)
        return candidate if not typed_context_name_conflicts(ctx, candidate)
        return sview("elisa_initialize_globals", 0, -1)

    # A project initializer is part of the generated embedding surface, so a
    # host may legally call it more than once. Dynamic C initialization is
    # one-time work, however. Derive the guard from the canonical translation
    # unit identity and check the complete collected symbol set before
    # returning a heap-backed name; this keeps the guard generic and avoids a
    # fixed identifier colliding with a source declaration.
    def typed_global_initializer_guard_name[@r](ctx: TypedContext[r]&) -> sview @r can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        identity: sview = ctx.canonical_source if ctx.canonical_source.len > 0 else sview(ctx.source, 0, -1)
        hash: u64 = hash_sview(identity) & 0x7fffffffffffffff
        candidate: mutable darray[u8] = []
        append_view(&candidate, sview("__elisa_transpiler_init_guard_", 0, -1))
        append_i64(&candidate, hash.i64())
        candidate_view: sview = bytes_view(candidate)
        if typed_context_name_conflicts(ctx, candidate_view):
            append_view(&candidate, sview("_guard", 0, -1))
        copied: cstr = string_view_copy(bytes_view(candidate)) can Memory.Allocate, Abort.Panic
        return sview(copied, 0, -1)
    def typed_emit_global_initializers[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if not ctx.project_mode and not typed_has_global_initializers(ctx)
        has_dynamic_initializers: bool = typed_has_global_initializers(ctx)
        guard_name: mutable sview = sview("", 0, 0)
        guard_name <- typed_global_initializer_guard_name(ctx) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console if has_dynamic_initializers
        if has_dynamic_initializers:
            append_view(out, sview("global mutable ", 0, -1))
            append_view(out, guard_name)
            append_view(out, sview(": bool = false\n\n", 0, -1))
        append_view(out, sview("def ", 0, -1))
        append_view(out, typed_global_initializer_name(ctx))
        append_view(out, sview("() -> void can[Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:\n", 0, -1))
        append_view(out, sview("    can Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:\n", 0, -1))
        if not typed_has_global_initializers(ctx):
            append_view(out, sview("        pass\n\n", 0, -1))
            return
        append_view(out, sview("        if ", 0, -1))
        append_view(out, guard_name)
        append_view(out, sview(":\n            return\n        ", 0, -1))
        append_view(out, guard_name)
        append_view(out, sview(" <- true\n", 0, -1))
        for index in 0..<ctx.globals.count |out, ctx|:
            typed_global: TypedGlobal[r] = ctx.globals[index.usize()]
            if typed_global.initializer >= 0:
                continue if typed_global.initializer_is_direct
                append_view(out, sview("        trusted Unsafe.StaleRef:\n            ", 0, -1))
                typed_emit_project_global_name(out, ctx, typed_global) if typed_global.project_private else append_view(out, typed_global.name)
                append_view(out, sview(" <- ", 0, -1))
                typed_emit_initializer_value(out, ctx, typed_global.initializer, typed_global.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("\n", 0, -1))
        append_view(out, sview("\n", 0, -1))
    def typed_collect_user_globals_in_scope[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], source: cstr, inside_anonymous_namespace: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        count: i64 = ast_child_count(node)
        if count < 0:
            return
        for index in 0..<count |ctx, node, source|:
            declaration: JsonValueHandle[r] = ast_child(node, index)
            if sview_eq(ast_kind(declaration), sview("VarDecl", 0, -1)) and ast_is_user_declaration(declaration, source) and (not ast_is_extern_decl(declaration) or not json_handle_is_null(ast_field(declaration, sview("init", 0, -1)))):
                name: sview = safe_identifier(ast_name(declaration))
                global_type: sview = typed_c_type(ctx, declaration) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                project_private: bool = ast_is_static_decl(declaration) or inside_anonymous_namespace or typed_project_cpp_namespace_const_has_internal_linkage(ctx, declaration, global_type)
                raw_declaration_id: sview = ast_string(ast_field(declaration, sview("id", 0, -1)))
                declaration_id: mutable sview = typed_decl_canonical_id(ctx, raw_declaration_id)
                declaration_id <- raw_declaration_id if declaration_id.len == 0
                already_collected: bool = typed_global_declaration_index(ctx, declaration_id) >= 0 if project_private else typed_global_index(ctx, name) >= 0
                if name.len > 0 and not already_collected:
                    initializer: mutable i64 = -1
                    if ast_child_count(declaration) > 0:
                        for child_index in 0..<ast_child_count(declaration) |ctx, declaration, initializer|:
                            initializer_node: JsonValueHandle[r] = ast_child(declaration, child_index)
                            continue if ast_is_comment_node(initializer_node)
                            initializer <- typed_lower_expr(ctx, initializer_node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                            break
                    identity_hash: i64 = typed_global_identity_hash(ctx, declaration, name, global_type) if project_private else 0
                    initializer_is_direct: bool = typed_global_initializer_is_direct(ctx, initializer, global_type) if initializer >= 0 else false
                    is_mutable: bool = typed_global_source_is_mutable(ctx, declaration, global_type, initializer) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    ctx.globals.push(TypedGlobal[r]{name: name, type_name: global_type, comment: ast_comment_text(declaration), declaration_id: declaration_id, initializer: initializer, is_mutable: is_mutable, initializer_is_direct: initializer_is_direct, identity_hash: identity_hash, project_private: project_private})
            elif ast_is_declaration_scope(declaration):
                nested_anonymous_namespace: bool = inside_anonymous_namespace or ast_is_anonymous_namespace(declaration)
                typed_collect_user_globals_in_scope(ctx, declaration, source, nested_anonymous_namespace) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
