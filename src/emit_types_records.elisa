extend CTranslator:
    def typed_collect_external_globals[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], inside_anonymous_namespace: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        # Referenced external globals are registered while lowering their DeclRefExpr.
        # Clang also marks implementation-detail declarations from system headers as
        # used (for example Darwin's _DefaultRuneLocale), even when the source-level
        # expression is folded away. Eagerly exporting those declarations both leaks
        # private libc types and can make an otherwise valid translation uncompilable.
        if ctx.project_mode and sview_eq(ast_kind(node), sview("VarDecl", 0, -1)) and not inside_anonymous_namespace and ast_is_user_declaration(node, ctx.source):
            typed_project_register_external_object(ctx, node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                child: JsonValueHandle[r] = ast_child(node, index)
                nested_anonymous_namespace: bool = inside_anonymous_namespace or ast_is_anonymous_namespace(child)
                typed_collect_external_globals(ctx, child, nested_anonymous_namespace) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_collect_user_functions_in_scope[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], source: cstr, inside_anonymous_namespace: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        count: i64 = ast_child_count(node)
        if count < 0:
            return
        for index in 0..<count |ctx, node, source|:
            declaration: JsonValueHandle[r] = ast_child(node, index)
            if sview_eq(ast_kind(declaration), sview("FunctionDecl", 0, -1)):
                if ast_is_user_declaration(declaration, source):
                    if not inside_anonymous_namespace and not ast_is_static_decl(declaration):
                        typed_project_register_external_function(ctx, declaration) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    if ast_has_child(declaration, sview("CompoundStmt", 0, -1)):
                        name: sview = ast_name(declaration)
                        if typed_user_function_index(ctx, name) < 0:
                            ctx.user_function_names.push(name)
                        signature: sview = typed_c_type(ctx, declaration) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                        result_type: sview = typed_resolve_type_aliases(ctx, c_function_return_type(signature)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                        declaration_id: sview = typed_decl_identity(ctx, declaration)
                        params_count: mutable i64 = 0
                        declaration_child_count: i64 = ast_child_count(declaration)
                        if declaration_child_count >= 0:
                            for child_index in 0..<declaration_child_count |declaration, params_count|:
                                parameter: JsonValueHandle[r] = ast_child(declaration, child_index)
                                params_count <- params_count + 1 if sview_eq(ast_kind(parameter), sview("ParmVarDecl", 0, -1))
                        variadic: bool = ast_bool(ast_field(declaration, sview("variadic", 0, -1)))
                        has_signature: mutable bool = false
                        for existing in ctx.user_function_signatures |declaration_id, name, signature, has_signature|:
                            if (declaration_id.len > 0 and sview_eq(existing.declaration_id, declaration_id)) or (declaration_id.len == 0 and sview_eq(existing.name, name) and sview_eq(c_type_without_qualifiers(existing.type_name), c_type_without_qualifiers(signature))):
                                has_signature <- true
                                break
                        ctx.user_function_signatures.push(TypedUserFunctionSignature[r]{name: name, type_name: signature, result_type: result_type, declaration_id: declaration_id, function_index: -1, params_count: params_count, variadic: variadic}) if not has_signature
            elif ast_is_declaration_scope(declaration):
                nested_anonymous_namespace: bool = inside_anonymous_namespace or ast_is_anonymous_namespace(declaration)
                typed_collect_user_functions_in_scope(ctx, declaration, source, nested_anonymous_namespace) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_collect_user_functions[@r](ctx: mutable TypedContext[r]&, root: JsonValueHandle[r], source: cstr) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        typed_collect_user_functions_in_scope(ctx, root, source, false) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def ast_is_static_decl[@r](node: JsonValueHandle[r]) -> bool:
        return sview_eq(ast_string(ast_field(node, sview("storageClass", 0, -1))), sview("static", 0, -1))
    def ast_is_anonymous_namespace[@r](node: JsonValueHandle[r]) -> bool:
        return sview_eq(ast_kind(node), sview("NamespaceDecl", 0, -1)) and ast_string(ast_field(node, sview("name", 0, -1))).len == 0
    def ast_contains_kind[@r](node: JsonValueHandle[r], wanted: sview) -> bool:
        return true if sview_eq(ast_kind(node), wanted)
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                return true if ast_contains_kind(ast_child(node, index), wanted)
        return false
    def ast_contains_static_decl[@r](node: JsonValueHandle[r]) -> bool:
        return true if ast_is_static_decl(node)
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                return true if ast_contains_static_decl(ast_child(node, index))
        return false
    def ast_contains_varargs_builtin[@r](node: JsonValueHandle[r]) -> bool:
        if sview_eq(ast_kind(node), sview("CallExpr", 0, -1)) and ast_child_count(node) > 0:
            callee: sview = ast_expr_name(ast_child(node, 0))
            return true if sview_starts_with(callee, sview("__builtin_va_", 0, -1))
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                return true if ast_contains_varargs_builtin(ast_child(node, index))
        return false

    def append_i64(out: mutable darray[u8]&, value: i64) -> void:
        magnitude: mutable i64 = value
        if magnitude < 0:
            out.push(45)
            magnitude <- 0 - magnitude
        if magnitude == 0:
            out.push(48)
            return
        digits: mutable i64[24] = zeroed
        count: mutable i64 = 0
        while magnitude > 0 |magnitude, digits, count|:
            digits[count] <- magnitude % 10
            magnitude <- magnitude / 10
            count <- count + 1
        for index in 0..<count |out, digits, count|:
            out.push((digits[count - index - 1] + 48).u8())
    def typed_emit_external_alias[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, binding_kind: TypedBindingKind, index: i64) -> void:
        if binding_kind == TypedBindingKind.ExternalGlobal:
            append_view(out, ctx.extern_globals[index.usize()].name)
        else:
            external: TypedExtern[r] = ctx.externs[index.usize()]
            if sview_starts_with(external.link_name, sview("_Z", 0, -1)):
                append_view(out, sview("__c_external_", 0, -1))
                append_view(out, external.name)
                append_view(out, sview("__abi_", 0, -1))
                append_i64(out, (hash_sview(external.link_name) & 0x7fffffffffffffff).i64())
            else:
                append_view(out, external.name)
    def append_function_return_type[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, function_type: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return_type: sview = typed_resolve_type_aliases(ctx, c_function_return_type(function_type)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview("mutable ", 0, -1)) if not c_type_is_function_pointer(return_type) and not c_type_pointer_layers_composable(return_type) and sview_find_byte(return_type, 42) >= 0 and not c_type_is_const_pointer(return_type)
        append_c_type_contextual(out, ctx, return_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(return_type)

    def c_matching_parenthesis_close(value: sview, open_paren: i64) -> i64:
        return -1 if open_paren < 0 or open_paren >= value.len or string_view_index(value, open_paren) != 40
        depth: mutable i64 = 0
        for index in open_paren..<value.len |value, open_paren, depth|:
            byte: i64 = string_view_index(value, index)
            depth <- depth + 1 if byte == 40
            if byte == 41:
                depth <- depth - 1
                return index if depth == 0
        return -1
    def c_function_return_type(function_type: sview) -> sview:
        # A return typedef can expand into `R (*)(Args) (FunctionArgs)`. The
        # first parenthesis belongs to the returned function pointer, while
        # the final parameter group belongs to the declared function. Keep
        # the entire callback declarator as the result type in that case.
        callback_marker: i64 = c_function_pointer_marker(function_type)
        callback_params: i64 = c_function_pointer_params_start(function_type)
        if callback_marker >= 0 and callback_params >= 0:
            callback_close: i64 = c_matching_parenthesis_close(function_type, callback_params)
            after_callback: mutable i64 = callback_close + 1
            while after_callback < function_type.len and (string_view_index(function_type, after_callback) == 32 or string_view_index(function_type, after_callback) == 9):
                after_callback <- after_callback + 1
            if callback_close >= 0 and after_callback < function_type.len and string_view_index(function_type, after_callback) == 40:
                return sview_trim_trailing(string_view_prefix(function_type, after_callback), 32)
            return sview_trim_trailing(string_view_prefix(function_type, callback_marker), 32)
        open_paren: i64 = sview_find_byte(function_type, 40)
        return sview_trim_trailing(string_view_prefix(function_type, open_paren), 32) if open_paren > 0 else function_type
    def append_external_bindings[@r](out: mutable darray[u8]&, root: JsonValueHandle[r]) -> void:
        # External signatures are collected from Clang FunctionDecl nodes while
        # lowering calls. There are intentionally no translator-owned C bindings.
        pass
    def typed_emit_externals[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, project_mode: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        for index in 0..<ctx.extern_globals.count |out, ctx|:
            external_global: TypedExternGlobal[r] = ctx.extern_globals[index.usize()]
            # A project definition is the canonical declaration for its link
            # name. C commonly exposes an incomplete array through a header
            # (`extern T values[]`) and defines the completed array in one
            # translation unit. In Elisa those spellings have different ABI
            # types (`T&?` versus `array[T, N]`), so retaining the later extern
            # would shadow the real global in the backend. The project table
            # already knows definitions emitted by earlier modules; keep the
            # reference implicit in the manifest instead.
            continue if project_mode and typed_project_global_seen(external_global.link_name)
            continue if project_mode and typed_project_external_global_seen(external_global.link_name)
            if project_mode:
                typed_project_mark_external_global(external_global.link_name) can Memory.Allocate, Abort.Panic
            if typed_global_index(ctx, external_global.link_name) < 0:
                append_view(out, sview("@link_name(\"", 0, -1))
                append_view(out, external_global.link_name)
                append_view(out, sview("\")\nextern ", 0, -1))
                typed_emit_external_alias(out, ctx, TypedBindingKind.ExternalGlobal, index)
                append_view(out, sview(": ", 0, -1))
                append_view(out, sview("mutable ", 0, -1)) if external_global.is_mutable
                append_c_type_contextual(out, ctx, external_global.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(external_global.type_name)
                append_view(out, sview("\n", 0, -1))
        append_view(out, sview("\n", 0, -1)) if ctx.extern_globals.count > 0
        if ctx.externs.count > 0:
            append_view(out, sview("# Discovered C ABI bindings.\n", 0, -1))
        for index in 0..<ctx.externs.count |out, ctx|:
            external: TypedExtern[r] = ctx.externs[index.usize()]
            continue if project_mode and typed_project_extern_seen(external.link_name)
            if project_mode:
                typed_project_mark_extern(external.link_name) can Memory.Allocate, Abort.Panic
            append_view(out, sview("@link_name(\"", 0, -1))
            append_view(out, external.link_name)
            append_view(out, sview("\")\nextern ", 0, -1))
            typed_emit_external_alias(out, ctx, TypedBindingKind.External, index)
            append_view(out, sview("(", 0, -1))
            if external.params_count > 0:
                for offset in 0..<external.params_count |out, ctx, external|:
                    if offset > 0:
                        append_view(out, sview(", ", 0, -1))
                    parameter: TypedParam[r] = ctx.extern_params[(external.params_start + offset).usize()]
                    append_view(out, parameter.name)
                    append_view(out, sview(": ", 0, -1))
                    if parameter.is_mutable and not c_type_pointer_layers_composable(parameter.type_name):
                        append_view(out, sview("mutable ", 0, -1))
                    append_c_type_contextual(out, ctx, parameter.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(parameter.type_name)
            if external.variadic:
                append_view(out, sview(", ...", 0, -1)) if external.params_count > 0
                append_view(out, sview("...", 0, -1)) if external.params_count == 0
            append_view(out, sview(") -> ", 0, -1))
            append_function_return_type(out, ctx, external.return_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview("\n", 0, -1))
        append_view(out, sview("\n", 0, -1)) if ctx.externs.count > 0
    def typed_emit_types[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, project_mode: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        for index in 0..<ctx.records.count |out, ctx|:
            record: TypedRecord[r] = ctx.records[index.usize()]
            continue if project_mode and typed_project_type_seen(record.name)
            if project_mode:
                typed_project_mark_type(record.name) can Memory.Allocate, Abort.Panic
                typed_project_mark_record_fields(ctx, record) can Memory.Allocate, Abort.Panic
            if record.comment.len > 0:
                append_view(out, sview("#", 0, -1))
                append_view(out, record.comment)
                append_view(out, sview("\n", 0, -1))
            append_view(out, sview("struct ", 0, -1))
            append_elisa_type_name(out, record.name)
            append_view(out, sview(" layout(packed):\n", 0, -1)) if typed_record_name_is_packed(ctx, record.name) else append_view(out, sview(":\n", 0, -1))
            if record.fields_count == 0:
                # Elisa requires at least one field in a struct body. This is
                # only an opaque declaration used for pointers or ABI values
                # whose definition is outside the translated source unit.
                append_view(out, sview("    _opaque: u8\n", 0, -1))
            else:
                for offset in 0..<record.fields_count |out, ctx, record|:
                    field: TypedField[r] = ctx.fields[(record.fields_start + offset).usize()]
                    append_view(out, sview("    ", 0, -1))
                    append_view(out, field.name)
                    append_view(out, sview(": mutable ", 0, -1)) if project_mode or typed_record_field_is_mutable(ctx, index, field.name) else append_view(out, sview(": ", 0, -1))
                    append_c_type_contextual(out, ctx, field.type_name) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview("?", 0, -1)) if c_type_pointer_outer_optional_suffix_needed(field.type_name)
                    append_view(out, sview("\n", 0, -1))
            append_view(out, sview("\n", 0, -1))

        for index in 0..<ctx.enums.count |out, ctx|:
            enumeration: TypedEnum[r] = ctx.enums[index.usize()]
            continue if project_mode and typed_project_type_seen(enumeration.name)
            if project_mode:
                typed_project_mark_type(enumeration.name) can Memory.Allocate, Abort.Panic
            append_view(out, sview("const enum ", 0, -1))
            append_elisa_type_name(out, enumeration.name)
            append_view(out, sview(" of ", 0, -1))
            append_view(out, c_type_abi_base(enumeration.storage_type))
            append_view(out, sview(":\n", 0, -1))
            emitted: mutable i64 = 0
            for constant_index in 0..<ctx.enum_consts.count |out, ctx, enumeration, emitted|:
                constant: TypedEnumConst[r] = ctx.enum_consts[constant_index.usize()]
                if sview_eq(constant.enum_name, enumeration.name):
                    append_view(out, sview("    ", 0, -1))
                    append_view(out, constant.name)
                    append_view(out, sview(" = ", 0, -1))
                    append_i64(out, constant.value)
                    append_view(out, sview("\n", 0, -1))
                    emitted <- emitted + 1
            append_view(out, sview("    pass\n", 0, -1)) if emitted == 0
            append_view(out, sview("\n", 0, -1))
