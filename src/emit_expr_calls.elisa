extend CTranslator:
    def typed_call_fixed_parameter_count[@r](ctx: TypedContext[r]&, callee: sview, callee_index: i64, call_value: i64) -> i64:
        selected_function_index: i64 = typed_call_selected_function_index(ctx, call_value)
        if selected_function_index >= 0:
            return ctx.functions[selected_function_index.usize()].params_count
        selected_external_index: i64 = typed_call_external_index(call_value)
        if selected_external_index >= 0 and selected_external_index < ctx.externs.count.i64():
            return ctx.externs[selected_external_index.usize()].params_count
        if callee_index >= 0 and callee_index < ctx.exprs.count.i64():
            function_type: sview = typed_expr_at(ctx, callee_index).type_name
            for position in 0..<64 |function_type, position|:
                parameter_type: sview = c_function_parameter_type(function_type, position)
                return position if parameter_type.len == 0 or sview_eq(parameter_type, sview("...", 0, -1))
        user_function_index: i64 = typed_user_function_index(ctx, callee)
        return ctx.functions[user_function_index.usize()].params_count if user_function_index >= 0
        for index in 0..<ctx.externs.count |ctx, callee|:
            external: TypedExtern[r] = ctx.externs[index.usize()]
            return external.params_count if sview_eq(external.name, callee) or sview_eq(external.link_name, callee)
        return -1
    def typed_call_is_variadic[@r](ctx: TypedContext[r]&, callee: sview, callee_index: i64, call_value: i64) -> bool:
        selected_function_index: i64 = typed_call_selected_function_index(ctx, call_value)
        return ctx.functions[selected_function_index.usize()].variadic if selected_function_index >= 0
        selected_external_index: i64 = typed_call_external_index(call_value)
        if selected_external_index >= 0 and selected_external_index < ctx.externs.count.i64():
            return ctx.externs[selected_external_index.usize()].variadic
        if callee_index >= 0 and callee_index < ctx.exprs.count.i64():
            return sview_find_byte(typed_expr_at(ctx, callee_index).type_name, 46) >= 0
        user_function_index: i64 = typed_user_function_index(ctx, callee)
        return ctx.functions[user_function_index.usize()].variadic if user_function_index >= 0
        for index in 0..<ctx.externs.count |ctx, callee|:
            external: TypedExtern[r] = ctx.externs[index.usize()]
            return external.variadic if sview_eq(external.name, callee) or sview_eq(external.link_name, callee)
        return false
    def typed_call_is_variadic_extra[@r](ctx: TypedContext[r]&, position: i64, callee: sview, callee_index: i64, call_value: i64) -> bool:
        return typed_call_is_variadic(ctx, callee, callee_index, call_value) and position >= typed_call_fixed_parameter_count(ctx, callee, callee_index, call_value)
    def typed_default_argument_promotion_type[@r](ctx: TypedContext[r]&, type_name: sview) -> sview @r:
        base: sview = c_type_named_base(type_name)
        return sview("i32", 0, -1) if sview_eq(base, sview("bool", 0, -1)) or sview_eq(base, sview("_Bool", 0, -1)) or c_type_is_enum(type_name)
        return sview("f64", 0, -1) if c_type_is_floating(type_name) and sview_eq(base, sview("float", 0, -1))
        return sview("i32", 0, -1) if c_type_is_integer(type_name) and clang_target_type_integer_width(ctx.target_abi, type_name) < ctx.target_abi.int_bits
        return sview("", 0, 0)
    def typed_callback_callee[@r](ctx: TypedContext[r]&, index: i64) -> i64:
        return -1 if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr[r] = typed_expr_at(ctx, index)
        return typed_callback_callee(ctx, expression.lhs) if expression.kind == TypedExprKind.Cast
        return index if expression.kind == TypedExprKind.Member and c_type_is_function_pointer(expression.type_name)
        return index if expression.kind == TypedExprKind.Name and c_type_is_function_pointer(expression.type_name)
        return -1
    def typed_direct_function_matches_target[@r](ctx: TypedContext[r]&, index: i64, target_type: sview) -> bool:
        return false if index < 0 or index >= ctx.exprs.count.i64() or not c_type_is_function_pointer(target_type)
        expression: TypedExpr[r] = typed_expr_at(ctx, index)
        if expression.kind == TypedExprKind.Cast:
            return typed_direct_function_matches_target(ctx, expression.lhs, target_type)
        return false if expression.kind != TypedExprKind.Name
        function_index: i64 = typed_user_function_index(ctx, expression.text)
        return false if function_index < 0
        function: TypedFunction[r] = ctx.functions[function_index.usize()]
        target_return: sview = c_function_return_type(target_type)
        function_return: sview = c_function_return_type(function.return_type)
        return false if not sview_eq(c_type_without_qualifiers(target_return), c_type_without_qualifiers(function_return))
        for parameter_index in 0..<64 |ctx, function, target_type, parameter_index|:
            target_parameter: sview = c_function_parameter_type(target_type, parameter_index)
            if target_parameter.len == 0:
                return parameter_index >= function.params_count and not function.variadic
            if sview_eq(target_parameter, sview("void", 0, -1)):
                # C's `(void)` prototype is an explicit zero-parameter
                # signature. A named Elisa function with zero parameters has
                # the same callable ABI, so keep the direct function value
                # instead of inserting an optional-Fn-to-opaque-pointer cast.
                return function.params_count == 0 and not function.variadic
            if sview_eq(target_parameter, sview("...", 0, -1)):
                return function.variadic
            return false if parameter_index >= function.params_count
            function_parameter: TypedParam[r] = ctx.params[(function.params_start + parameter_index).usize()]
            return false if not c_type_call_compatible(ctx, function_parameter.type_name, target_parameter)
            expected_mutable: bool = c_type_pointer_count(target_parameter) > 0 and c_type_pointer_can_write(target_parameter)
            return false if typed_parameter_is_mutable(ctx, function, function_parameter) != expected_mutable
        return false
    def typed_emit_callback_guards[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64, level: i64) -> void can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console]:
        # A deeply nested callback expression should not consume the host call
        # stack during emission. Push children in reverse order to preserve the
        # recursive walk's pre-order output while visiting each IR node once.
        return if index < 0 or index >= ctx.exprs.count.i64()
        pending: mutable darray[i64] = []
        seen: mutable darray[bool] = []
        for expression_index in 0..<ctx.exprs.count |seen|:
            seen.push(false)
        pending.push(index)
        while pending.count > 0.usize() |out, ctx, pending, seen, level|:
            current: i64 = pending[pending.count - 1.usize()]
            _ = pending.pop()
            continue if current < 0 or current >= ctx.exprs.count.i64() or seen[current.usize()]
            seen[current.usize()] <- true
            expression: TypedExpr[r] = typed_expr_at(ctx, current)
            if expression.kind == TypedExprKind.Call and expression.value == 1:
                callback: i64 = typed_callback_callee(ctx, expression.lhs)
                if callback >= 0 and not typed_name_is_currently_nonnull(ctx, callback):
                    # Calling a null C function pointer is undefined behavior. Make
                    # that precondition explicit so Elisa's flow checker can safely
                    # narrow the first-class optional fn for the indirect call.
                    append_indent(out, level)
                    append_view(out, sview("assert ", 0, -1))
                    typed_emit_expr(out, ctx, callback) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    append_view(out, sview(" != null\n", 0, -1))
            if expression.args_count > 0 and expression.args_start >= 0:
                offset: mutable i64 = expression.args_count - 1
                while offset >= 0 |ctx, expression, pending, offset|:
                    child_index: i64 = expression.args_start + offset
                    if child_index >= 0 and child_index < ctx.expr_children.count.i64():
                        pending.push(ctx.expr_children[child_index.usize()])
                    offset <- offset - 1
            pending.push(expression.third) if expression.third >= 0
            pending.push(expression.rhs) if expression.rhs >= 0
            pending.push(expression.lhs) if expression.lhs >= 0
    def typed_emit_array_decay_value[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64, target_type: sview, target_optional: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        # C array-to-pointer conversion is the address of the first element,
        # not the array value itself. Keep this conversion shared by call
        # arguments and ordinary initialization/assignment boundaries.
        append_view(out, sview("(&(", 0, -1))
        typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(")[0]).cast[", 0, -1))
        append_view(out, sview("mutable ", 0, -1)) if not c_type_pointer_layers_composable(target_type) and c_type_pointer_can_write(target_type)
        append_c_type_contextual(out, ctx, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        # Composable C pointer types carry nullability on every reference
        # layer in append_c_type_contextual. Keep this legacy boundary suffix
        # only for pointer shapes that still use the flattened fallback.
        append_view(out, sview("?", 0, -1)) if target_optional and not c_type_pointer_layers_composable(target_type)
        append_view(out, sview("]", 0, -1))
    def typed_emit_call_cast[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64, target_type: sview, target_optional: bool, force_cast: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        argument: TypedExpr[r] = typed_expr_at(ctx, index)
        if c_type_reference_count(target_type) > 0:
            # A C++ reference parameter is passed as the address of the
            # referred object. This is distinct from C's `T **`: the callee
            # sees a T* value through `T*&`, so the expression emitter handles
            # the extra slot when the reference parameter is used in its body.
            append_view(out, sview("(&(", 0, -1))
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview("))", 0, -1))
            append_view(out, sview(".cast[", 0, -1))
            append_view(out, sview("mutable ", 0, -1)) if c_type_reference_can_write(target_type)
            append_c_type_contextual(out, ctx, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview("]", 0, -1))
            return
        # Calls are C ABI boundaries. Keep the conversion explicit for values
        # whose Elisa reference shape differs from the C spelling: a translated
        # call result may carry a local aggregate's region, while `&pointer`,
        # string/array decay, and nested character indexing have Elisa-specific
        # stack/reference shapes. Ordinary local assignments still use
        # typed_emit_target_value's compatibility checks and can remain cast-free.
        address_of_nested_pointer: bool = typed_expr_is_address_of_pointer(ctx, index) and c_type_pointer_count(target_type) >= 1 and target_optional
        nested_char_index: bool = typed_expr_is_nested_char_index(ctx, index) and c_type_pointer_count(target_type) == 1 and c_type_is_char_pointer(target_type)
        # Elisa currently lowers both `char *` and `const char *` parameters to
        # reference slots. A literal or array-decay expression therefore needs
        # an explicit cast for either spelling, including the const-qualified C
        # form.
        mutable_text_shape: bool = typed_expr_is_string_value(ctx, index) or typed_expr_is_array_decay_value(ctx, index)
        # Elisa string literals are u8-backed even when Clang's C spelling is
        # `char[N]`. They need the target-aware cast below at the C boundary;
        # ordinary named char arrays already use the target ABI element type.
        decayed_readonly_compatible: bool = mutable_text_shape and not typed_expr_is_string_value(ctx, index) and argument.kind == TypedExprKind.Cast and c_type_is_array(typed_expr_at(ctx, argument.lhs).type_name) and c_type_array_decay_compatible(ctx, typed_expr_at(ctx, argument.lhs).type_name, target_type) and not c_type_pointer_can_write(target_type)
        direct_function_compatible: bool = typed_direct_function_matches_target(ctx, index, target_type)
        existing_function_pointer: bool = c_type_is_function_pointer(argument.type_name) and not (argument.kind == TypedExprKind.Cast and c_type_is_function(typed_expr_at(ctx, argument.lhs).type_name))
        already_converted: bool = argument.kind == TypedExprKind.Cast and not c_type_is_function_pointer(target_type) and c_type_call_compatible(ctx, argument.type_name, target_type)
        same_cast_target: bool = argument.kind == TypedExprKind.Cast and c_type_pointer_count(argument.type_name) == c_type_pointer_count(target_type) and sview_eq(c_type_without_qualifiers(argument.type_name), c_type_without_qualifiers(target_type)) and c_type_pointer_qualifiers_match(argument.type_name, target_type)
        if direct_function_compatible:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        if same_cast_target and not mutable_text_shape and not address_of_nested_pointer and not nested_char_index:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        # A read-only parameter does not require a cast when the argument is
        # already ABI-compatible. This is especially important for the common
        # C conversion `T *` -> `const T *`: it preserves the source capability
        # without manufacturing a redundant Elisa cast at every call site.
        if not address_of_nested_pointer and not nested_char_index and (not mutable_text_shape or decayed_readonly_compatible) and c_type_call_compatible(ctx, argument.type_name, target_type) and (target_optional or not typed_expr_may_be_null(ctx, index)) and (not force_cast or not c_type_pointer_can_write(target_type) or typed_expr_can_pass_mutable(ctx, index) or direct_function_compatible or existing_function_pointer or already_converted or decayed_readonly_compatible):
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        if c_type_is_array(argument.type_name) and argument.kind != TypedExprKind.String:
            typed_emit_array_decay_value(out, ctx, index, target_type, target_optional) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        append_view(out, sview("(", 0, -1))
        if not target_optional and typed_nonnull_supported(argument.type_name):
            typed_emit_nonnull_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        else:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(")", 0, -1))
        append_view(out, sview(".cast[", 0, -1))
        # Preserve the capability of the target C pointer. Read-only C pointer
        # values retain Elisa's nullable reference shape; writable pointers
        # receive the `mutable` capability at the cast boundary.
        append_view(out, sview("mutable ", 0, -1)) if not c_type_pointer_layers_composable(target_type) and not c_type_is_function(target_type) and c_type_pointer_can_write(target_type)
        append_c_type_contextual(out, ctx, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview("?", 0, -1)) if target_optional and not c_type_pointer_layers_composable(target_type)
        append_view(out, sview("]", 0, -1))
    def typed_emit_scalar_conversion[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64, target_type: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        # C enum conversions and ordinary arithmetic conversions are explicit
        # at Elisa's nominal type boundary. Use Clang's selected target scalar
        # type rather than assuming every enum/int conversion is i32.
        if sview_eq(c_type_named_base(target_type), sview("bool", 0, -1)) or sview_eq(c_type_named_base(target_type), sview("_Bool", 0, -1)):
            typed_emit_condition(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        append_view(out, sview("(", 0, -1))
        if typed_expr_is_boolean(ctx, index):
            append_view(out, sview("1 if ", 0, -1))
            typed_emit_condition(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            append_view(out, sview(" else 0", 0, -1))
        else:
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(").", 0, -1))
        append_view(out, clang_target_type_abi_base(ctx.target_abi, target_type))
        append_view(out, sview("()", 0, -1))
    def typed_compound_assignment_value_requires_conversion[@r](ctx: TypedContext[r]&, index: i64, target_type: sview) -> bool:
        # Elisa's compound operators require operands with the same concrete
        # scalar type. C instead promotes the RHS before applying `op=` and
        # converts the result back to the destination type. Keep that boundary
        # explicit so `i32 += i16`, `u8 += i32`, and signed/unsigned pairs do
        # not reach the backend as mixed-width LLVM operations.
        value_type: sview = typed_expr_at(ctx, index).type_name
        target_numeric: bool = c_type_is_integer(target_type) or c_type_is_floating(target_type)
        value_numeric: bool = c_type_is_integer(value_type) or c_type_is_floating(value_type) or c_type_is_enum(value_type)
        return false if not target_numeric or not value_numeric
        return true if typed_expr_is_boolean(ctx, index) or c_type_is_enum(value_type)
        return not sview_eq(clang_target_type_abi_base(ctx.target_abi, value_type), clang_target_type_abi_base(ctx.target_abi, target_type))
    def typed_emit_compound_assignment_value[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64, target_type: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        if typed_compound_assignment_value_requires_conversion(ctx, index, target_type):
            typed_emit_scalar_conversion(out, ctx, index, target_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_emit_c_enum_conversion[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64, target_enum_index: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression: TypedExpr[r] = typed_expr_at(ctx, index)
        source_enum_index: i64 = typed_enum_value_index(ctx, expression.type_name)
        if source_enum_index == target_enum_index and (expression.kind == TypedExprKind.Name or expression.kind == TypedExprKind.Member or expression.kind == TypedExprKind.ArrayIndex or expression.kind == TypedExprKind.Call):
            # These nodes already emit a nominal enum value. Arithmetic and
            # compound-assignment nodes may retain the enum result type in C's
            # AST while their Elisa spelling is the underlying integer; route
            # those through storage and reconstruct the C enum value.
            typed_emit_expr(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        # Elisa enums are nominal types. Even when Clang has folded a C
        # integer constant, the target slot still requires an explicit
        # underlying-integer-to-enum conversion; a raw literal is rejected by
        # the current compiler in globals, aggregates, locals, and arguments.
        # Keep this boundary centralized so enum conversion behavior does not
        # depend on the source program or on the particular constant form.
        target_enum: TypedEnum[r] = ctx.enums[target_enum_index.usize()]
        typed_emit_scalar_conversion(out, ctx, index, target_enum.underlying_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        append_view(out, sview(".", 0, -1))
        append_elisa_type_name(out, target_enum.name)
        append_view(out, sview("()", 0, -1))
    def typed_emit_call_arg[@r](out: mutable darray[u8]&, ctx: TypedContext[r]&, index: i64, position: i64, callee_index: i64, callee: sview, call_value: i64) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        argument: TypedExpr[r] = typed_expr_at(ctx, index)
        if typed_call_is_variadic_extra(ctx, position, callee, callee_index, call_value):
            promoted_type: sview = typed_default_argument_promotion_type(ctx, argument.type_name)
            source_is_numeric: bool = c_type_is_integer(argument.type_name) or c_type_is_floating(argument.type_name) or c_type_is_enum(argument.type_name)
            force_literal_context: bool = argument.kind == TypedExprKind.Integer or argument.kind == TypedExprKind.Floating
            if promoted_type.len > 0 and source_is_numeric and (force_literal_context or not sview_eq(clang_target_type_abi_base(ctx.target_abi, argument.type_name), promoted_type)):
                typed_emit_scalar_conversion(out, ctx, index, promoted_type) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return
        expected_type: mutable sview = typed_call_parameter_type(ctx, callee, position)
        selected_function_index: i64 = typed_call_selected_function_index(ctx, call_value)
        if selected_function_index >= 0:
            selected_function: TypedFunction[r] = ctx.functions[selected_function_index.usize()]
            if position < selected_function.params_count:
                selected_parameter: TypedParam[r] = ctx.params[(selected_function.params_start + position).usize()]
                expected_type <- selected_parameter.type_name
        selected_external_index: i64 = typed_call_external_index(call_value)
        if selected_external_index >= 0 and selected_external_index < ctx.externs.count.i64():
            selected_external: TypedExtern[r] = ctx.externs[selected_external_index.usize()]
            if position < selected_external.params_count:
                selected_parameter: TypedParam[r] = ctx.extern_params[(selected_external.params_start + position).usize()]
                expected_type <- selected_parameter.type_name
        if callee_index >= 0:
            indirect_expected: sview = c_function_parameter_type(typed_expr_at(ctx, callee_index).type_name, position)
            expected_type <- indirect_expected if indirect_expected.len > 0
        expected_mutable: mutable bool = typed_call_parameter_is_mutable(ctx, callee, position)
        if selected_function_index >= 0:
            selected_function: TypedFunction[r] = ctx.functions[selected_function_index.usize()]
            if position < selected_function.params_count:
                expected_mutable <- ctx.params[(selected_function.params_start + position).usize()].is_mutable
        if selected_external_index >= 0 and selected_external_index < ctx.externs.count.i64():
            selected_external: TypedExtern[r] = ctx.externs[selected_external_index.usize()]
            if position < selected_external.params_count:
                expected_mutable <- ctx.extern_params[(selected_external.params_start + position).usize()].is_mutable
        if typed_expr_is_string_value(ctx, index) and c_type_is_char_pointer(expected_type) and not c_type_pointer_can_write(expected_type):
            # String literal bytes use Elisa's u8-backed string representation.
            # At a C ABI boundary, explicitly reinterpret them as the target's
            # plain-char pointer type (which may be i8 on this target).
            typed_emit_call_cast(out, ctx, index, expected_type, c_type_pointer_optional(expected_type), false) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        expected_enum_index: i64 = typed_enum_value_index(ctx, expected_type)
        if sview_eq(c_type_named_base(expected_type), sview("bool", 0, -1)) or sview_eq(c_type_named_base(expected_type), sview("_Bool", 0, -1)):
            typed_emit_condition(out, ctx, index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        if expected_enum_index >= 0:
            typed_emit_c_enum_conversion(out, ctx, index, expected_enum_index) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        source_is_enum: bool = typed_enum_value_index(ctx, argument.type_name) >= 0 or (argument.kind == TypedExprKind.Name and argument.value == 2)
        selected_overload: bool = typed_call_signature_index(call_value) >= 0 or selected_external_index >= 0
        target_is_numeric: bool = c_type_is_integer(expected_type) or c_type_is_floating(expected_type)
