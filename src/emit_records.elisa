    def typed_enum_decl_storage_type[@r](node: JsonValueHandle[r], abi: ClangTargetABI) -> sview @r:
        # Clang reports an explicit C++ enum base directly. For ordinary C
        # enums, EnumConstantDecl's type is the common integer type Clang
        # selected for that enum (for example `unsigned int` when a value is
        # above INT_MAX). Keep the source spelling in typed IR; the emitter
        # maps it to Elisa's ABI scalar only at the boundary.
        fixed_type_node: JsonValueHandle[r] = ast_field(node, sview("fixedUnderlyingType", 0, -1))
        fixed_type: sview = ast_string(ast_field(fixed_type_node, sview("qualType", 0, -1)))
        return fixed_type if c_type_is_integer(fixed_type)
        count: i64 = ast_child_count(node)
        minimum: mutable i64 = 0
        maximum: mutable i64 = 0
        previous: mutable i64 = -1
        have_value: mutable bool = false
        if count >= 0:
            for index in 0..<count |node|:
                constant: JsonValueHandle[r] = ast_child(node, index)
                if sview_eq(ast_kind(constant), sview("EnumConstantDecl", 0, -1)):
                    constant_type: sview = ast_qual_type(constant)
                    value: i64 = ast_enum_value(constant, previous + 1)
                    previous <- value
                    minimum <- value if not have_value or value < minimum
                    maximum <- value if not have_value or value > maximum
                    have_value <- true
                    return constant_type if c_type_is_integer(constant_type) and not abi.short_enums
