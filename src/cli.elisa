extend CTranslator:
    def emit_view_fd(value: sview, fd: i64) -> void can[Console, Unsafe.PointerCast]:
        return if value.len == 0
        raw: void& = value.data.cast[void&] can Unsafe.PointerCast
        _ = write(fd, raw, value.len.usize()) can Console

    def emit_view(value: sview) -> void can[Console, Unsafe.PointerCast]:
        emit_view_fd(value, 1) can Console, Unsafe.PointerCast

    def cli_emit_clang_diagnostics(diagnostics: darray[u8]) -> void can[Console, Unsafe.PointerCast]:
        return if diagnostics.count == 0.usize()
        emit_view_fd(bytes_view(diagnostics), 2) can Console, Unsafe.PointerCast
        emit_view_fd(sview("\n", 0, -1), 2) can Console, Unsafe.PointerCast if diagnostics[diagnostics.count - 1.usize()] != 10

    def cli_emit_json_value_limit_error(source: sview, max_values: usize) -> void can[Console, Unsafe.PointerCast]:
        output: mutable darray[u8] = []
        append_view(&output, sview("elisa-c-transpiler: projected AST exceeded --max-frontend-json-values ", 0, -1))
        append_i64(&output, max_values.i64())
        append_view(&output, sview(" while processing ", 0, -1))
        append_view(&output, source)
        append_view(&output, sview("\n", 0, -1))
        emit_view_fd(bytes_view(output), 2) can Console, Unsafe.PointerCast

    def cli_emit_compile_database_json_value_limit_error(path: sview, max_values: usize) -> void can[Console, Unsafe.PointerCast]:
        output: mutable darray[u8] = []
        append_view(&output, sview("elisa-c-transpiler: compilation database exceeded --max-frontend-json-values ", 0, -1))
        append_i64(&output, max_values.i64())
        append_view(&output, sview(" while reading ", 0, -1))
        append_view(&output, path)
        append_view(&output, sview("\n", 0, -1))
        emit_view_fd(bytes_view(output), 2) can Console, Unsafe.PointerCast

    def cli_emit_input_source_limit_error(source: sview, max_sources: usize) -> void can[Console, Unsafe.PointerCast]:
        output: mutable darray[u8] = []
        append_view(&output, sview("elisa-c-transpiler: input source count exceeded --max-input-sources ", 0, -1))
        append_i64(&output, max_sources.i64())
        append_view(&output, sview(" while processing ", 0, -1))
        append_view(&output, source)
        append_view(&output, sview("\n", 0, -1))
        emit_view_fd(bytes_view(output), 2) can Console, Unsafe.PointerCast

    def cli_emit_invalid_compilation_database(path: sview) -> void can[Console, Unsafe.PointerCast]:
        output: mutable darray[u8] = []
        append_view(&output, sview("elisa-c-transpiler: invalid or malformed compilation database while reading ", 0, -1))
        append_view(&output, path)
        append_view(&output, sview("\n", 0, -1))
        emit_view_fd(bytes_view(output), 2) can Console, Unsafe.PointerCast

    def cli_emit_invalid_compile_command(source: sview, command_is_text: bool) -> void can[Console, Unsafe.PointerCast]:
        if command_is_text:
            emit_view_fd(sview("elisa-c-transpiler: unsupported or malformed syntax in compilation command for ", 0, -1), 2)
        else:
            emit_view_fd(sview("elisa-c-transpiler: invalid compilation command for ", 0, -1), 2)
        emit_view_fd(source, 2)
        emit_view_fd(sview("\n", 0, -1), 2)

    def cli_emit_malformed_clang_ast(source: sview) -> void can[Console, Unsafe.PointerCast]:
        output: mutable darray[u8] = []
        append_view(&output, sview("elisa-c-transpiler: Clang emitted invalid or over-depth AST JSON while processing ", 0, -1))
        append_view(&output, source)
        append_view(&output, sview("\n", 0, -1))
        emit_view_fd(bytes_view(output), 2) can Console, Unsafe.PointerCast

    def cli_emit_ast_capture_failure(source: sview) -> void can[Console, Unsafe.PointerCast]:
        output: mutable darray[u8] = []
        append_view(&output, sview("elisa-c-transpiler: failed to launch Clang or capture its AST while processing ", 0, -1))
        append_view(&output, source)
        append_view(&output, sview("\n", 0, -1))
        emit_view_fd(bytes_view(output), 2) can Console, Unsafe.PointerCast

    def emit_cstr(value: cstr) -> void can[Console, Unsafe.PointerCast]:
        emit_view(sview(value, 0, -1)) can Console, Unsafe.PointerCast

    def cli_is_option(value: sview, wanted: sview) -> bool:
        return sview_eq(value, wanted)

    def cli_write_bytes(path: sview, bytes: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        path_cstr: cstr = ctx_string_from_view(path) can Memory.Allocate, Abort.Panic
        stream: CFile? = c_fopen(path_cstr, "wb")
        return false if stream == null
        handle: CFile = stream
        if bytes.count > 0.usize():
            payload: sview = bytes_view(bytes)
            raw_payload: void& = payload.data.cast[void&] can Unsafe.PointerCast
            written: usize = c_fwrite(raw_payload, 1.usize(), bytes.count, handle) can Unsafe.PointerCast
            if written != bytes.count:
                _ = c_fclose(handle)
                return false
        return c_fclose(handle) == 0

    def cli_copy_path(out: mutable darray[u8]&, source: sview) -> cstr can[Unsafe.PointerCast]:
        append_view(out, source)
        out.push(0)
        return (&out[0]).cast[cstr]

    def cli_append_initializer_stem(out: mutable darray[u8]&, source: sview) -> void:
        start: mutable i64 = 0
        for index in 0..<source.len |source, start|:
            start <- index + 1 if string_view_index(source, index) == 47
        end: mutable i64 = source.len
        for index in start..<source.len |source, start, end|:
            if string_view_index(source, index) == 46:
                end <- index
                break
        append_view(out, sview("elisa_init_", 0, -1))
        if end <= start:
            append_view(out, sview("unit", 0, -1))
            return
        for index in start..<end |out, source, start, end|:
            byte: i64 = string_view_index(source, index)
            if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57) or byte == 95:
                out.push(byte.u8())
            else:
                out.push(95)

    def cli_append_initializer_name_for_sources(out: mutable darray[u8]&, sources: darray[CliSource], source_index: i64) -> void:
        source: CliSource = sources[source_index.usize()]
        cli_append_initializer_stem(out, source.path)
        cli_module_disambiguator(out, sources, source_index)

    def run(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast, Console]:
        region translation:
            if argc < 2:
                emit_cstr("usage: elisa-c-transpiler [--fidelity|--idiomatic] [--frontend-stats] [--explain-rewrites] [--frontend-timeout-seconds N] [--max-frontend-output-bytes N] [--max-frontend-json-values N] [--max-input-sources N] [--cpp-lib-dir DIR --elisa-std-dir DIR] [--output-dir DIR] [--compile-commands PATH] <input.c>...".cast[cstr])
                emit_cstr("\n".cast[cstr])
                return 2

            argv_slots: mutable cstr&& = argv.cast[mutable cstr&&]
            first_argument: sview = sview(argv_slots[1.usize()].cast[cstr], 0, -1)
            direct_input: mutable bool = argc == 2
            if direct_input:
                direct_input <- false if cli_is_option(first_argument, sview("--help", 0, -1))
                if first_argument.len > 0:
                    direct_input <- false if string_view_index(first_argument, 0) == 45
            if direct_input:
                input: cstr = argv_slots[1.usize()].cast[cstr]
                clang_succeeded: mutable bool = false
                clang_limit_exceeded: mutable bool = false
                malformed_ast: mutable bool = false
                capture_failed: mutable bool = false
                timeout_exceeded: mutable bool = false
                raw_output_bytes: mutable usize = 0.usize()
                target_macros: mutable darray[u8] = []
                target_macros_succeeded: mutable bool = false
                clang_diagnostics: mutable darray[u8] = []
                record_layout_dump: mutable darray[u8] = []
                ast_bytes: darray[u8] = run_clang_ast(input, cli_default_frontend_output_limit(), cli_default_frontend_timeout_seconds(), &clang_succeeded, &clang_limit_exceeded, &malformed_ast, &capture_failed, &timeout_exceeded, &raw_output_bytes, &target_macros, &target_macros_succeeded, &clang_diagnostics, &record_layout_dump) can Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console
                cli_emit_clang_diagnostics(clang_diagnostics) can Console, Unsafe.PointerCast
                if not clang_succeeded:
                    if timeout_exceeded:
                        cli_emit_frontend_timeout_error(sview(input, 0, -1), cli_default_frontend_timeout_seconds()) can Console, Unsafe.PointerCast, Memory.Allocate, Abort.Panic
                    elif clang_limit_exceeded:
                        emit_view_fd(sview("elisa-c-transpiler: Clang output exceeded --max-frontend-output-bytes while processing ", 0, -1), 2)
                        emit_view_fd(sview(input, 0, -1), 2)
                        emit_view_fd(sview("\n", 0, -1), 2)
                    elif capture_failed:
                        cli_emit_ast_capture_failure(sview(input, 0, -1)) can Console, Unsafe.PointerCast
                    else:
                        emit_view_fd(sview("elisa-c-transpiler: Clang failed while processing ", 0, -1), 2)
                        emit_view_fd(sview(input, 0, -1), 2)
                        emit_view_fd(sview("\n", 0, -1), 2)
                    return 1
                if malformed_ast:
                    cli_emit_malformed_clang_ast(sview(input, 0, -1)) can Console, Unsafe.PointerCast
                    return 1
                if ast_bytes.count == 0.usize():
                    emit_cstr("clang produced no AST\n".cast[cstr])
                    return 1
                target_abi: ClangTargetABI = cli_target_abi_load(target_macros, target_macros_succeeded, sview(input, 0, -1)) can Console, Unsafe.PointerCast
                return 1 if not target_abi.valid
                region source_translation:
                    translation: mutable TypedTranslation[source_translation] = TypedTranslation[source_translation]{output: [], source_map: [], typed_ir_dump: [], diagnostics: [], ast_json_values: -1, ast_arena_used_bytes: 0.usize(), needs_cpp_unordered_map: false, needs_runtime_nonnull: false, needs_runtime_readonly_nonnull: false, needs_runtime_varargs: false, failed: false, frontend_json_value_limit_exceeded: false}
                    translate_ast_mode_with_options(&translation, ast_bytes, record_layout_dump, input, true, TypedTranslationMode.Idiomatic, clang_fp_options_default(), false, cli_default_frontend_json_value_limit(), false, false, false, sview("", 0, 0), sview("", 0, 0), target_abi, clang_target_language_is_cxx(target_macros, target_macros_succeeded)) can Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console
                    if translation.frontend_json_value_limit_exceeded:
                        cli_emit_json_value_limit_error(sview(input, 0, -1), cli_default_frontend_json_value_limit()) can Console, Unsafe.PointerCast
                        return 1
                    if translation.failed:
                        emit_typed_diagnostics(translation.diagnostics)
                        return 1
                    emit_view(bytes_view(translation.output))
                    return 0
            sources: mutable darray[CliSource] = []
            output_directory: mutable sview = sview("", 0, 0)
            compile_commands: mutable sview = sview("", 0, 0)
            source_map_path: mutable sview = sview("", 0, 0)
            source_map_project_state: mutable CliSourceMapProjectState = CliSourceMapProjectState{output: [], source_bytes_hashed: 0.usize(), json_bytes: 0.usize(), units: []}
            max_frontend_output_bytes: mutable usize = cli_default_frontend_output_limit()
            max_frontend_json_values: mutable usize = cli_default_frontend_json_value_limit()
            max_input_sources: mutable usize = cli_default_input_source_limit()
            max_frontend_timeout_seconds: mutable usize = cli_default_frontend_timeout_seconds()
            mode: mutable TypedTranslationMode = TypedTranslationMode.Idiomatic
            frontend_stats: mutable bool = false
            explain_rewrites: mutable bool = false
            dump_typed_ir: mutable bool = false
            diagnostics_json: mutable bool = false
            cpp_compatibility_library_directory <- ""
            cpp_compatibility_std_directory <- ""
            index: mutable i64 = 1
            while index < argc |argv_slots, sources, output_directory, compile_commands, source_map_path, max_frontend_output_bytes, max_frontend_json_values, max_input_sources, max_frontend_timeout_seconds, mode, frontend_stats, dump_typed_ir, diagnostics_json, index|:
                argument: sview = sview(argv_slots[index.usize()].cast[cstr], 0, -1)
                if cli_is_option(argument, sview("--output-dir", 0, -1)) and index + 1 < argc:
                    output_directory <- sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1)
                    index <- index + 2
                elif cli_is_option(argument, sview("--compile-commands", 0, -1)) and index + 1 < argc:
                    compile_commands <- sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1)
                    index <- index + 2
                elif cli_is_option(argument, sview("--source-map-json", 0, -1)) and index + 1 < argc:
                    source_map_path <- sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1)
                    if source_map_path.len == 0:
                        emit_view_fd(sview("elisa-c-transpiler: --source-map-json requires a nonempty output path\n", 0, -1), 2)
                        return 2
                    index <- index + 2
                elif cli_is_option(argument, sview("--source-map-json", 0, -1)):
                    emit_view_fd(sview("elisa-c-transpiler: --source-map-json requires an output path\n", 0, -1), 2)
                    return 2
                elif cli_is_option(argument, sview("--frontend-timeout-seconds", 0, -1)) and index + 1 < argc:
                    requested_timeout: mutable usize = 0.usize()
                    if not cli_parse_frontend_timeout_seconds(sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1), &requested_timeout):
                        emit_view_fd(sview("elisa-c-transpiler: --frontend-timeout-seconds requires a positive decimal integer no greater than 86400\n", 0, -1), 2)
                        return 2
                    max_frontend_timeout_seconds <- requested_timeout
                    index <- index + 2
                elif cli_is_option(argument, sview("--max-frontend-output-bytes", 0, -1)) and index + 1 < argc:
                    requested_limit: mutable usize = 0.usize()
                    if not cli_parse_positive_usize(sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1), &requested_limit):
                        emit_view_fd(sview("elisa-c-transpiler: --max-frontend-output-bytes requires a positive decimal integer\n", 0, -1), 2)
                        return 2
                    max_frontend_output_bytes <- requested_limit
                    index <- index + 2
                elif cli_is_option(argument, sview("--max-frontend-json-values", 0, -1)) and index + 1 < argc:
                    requested_limit: mutable usize = 0.usize()
                    if not cli_parse_positive_usize(sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1), &requested_limit):
                        emit_view_fd(sview("elisa-c-transpiler: --max-frontend-json-values requires a positive decimal integer\n", 0, -1), 2)
                        return 2
                    max_frontend_json_values <- requested_limit
                    index <- index + 2
                elif cli_is_option(argument, sview("--max-input-sources", 0, -1)) and index + 1 < argc:
                    requested_limit: mutable usize = 0.usize()
                    if not cli_parse_input_source_limit(sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1), &requested_limit):
                        emit_view_fd(sview("elisa-c-transpiler: --max-input-sources requires a positive decimal integer no greater than 4096\n", 0, -1), 2)
                        return 2
                    max_input_sources <- requested_limit
                    index <- index + 2
                elif cli_is_option(argument, sview("--max-input-sources", 0, -1)):
                    emit_view_fd(sview("elisa-c-transpiler: --max-input-sources requires a value\n", 0, -1), 2)
                    return 2
                elif cli_is_option(argument, sview("--frontend-stats", 0, -1)):
                    frontend_stats <- true
                    index <- index + 1
                elif cli_is_option(argument, sview("--explain-rewrites", 0, -1)):
                    explain_rewrites <- true
                    index <- index + 1
                elif cli_is_option(argument, sview("--dump-typed-ir", 0, -1)):
                    dump_typed_ir <- true
                    index <- index + 1
                elif cli_is_option(argument, sview("--diagnostics-json", 0, -1)):
                    diagnostics_json <- true
                    index <- index + 1
                elif cli_is_option(argument, sview("--cpp-lib-dir", 0, -1)) and index + 1 < argc:
                    cpp_compatibility_library_directory <- argv_slots[(index + 1).usize()].cast[cstr]
                    index <- index + 2
                elif cli_is_option(argument, sview("--elisa-std-dir", 0, -1)) and index + 1 < argc:
                    cpp_compatibility_std_directory <- argv_slots[(index + 1).usize()].cast[cstr]
                    index <- index + 2
                elif cli_is_option(argument, sview("--fidelity", 0, -1)):
                    mode <- TypedTranslationMode.Fidelity
                    index <- index + 1
                elif cli_is_option(argument, sview("--idiomatic", 0, -1)):
                    mode <- TypedTranslationMode.Idiomatic
                    index <- index + 1
                elif cli_is_option(argument, sview("--help", 0, -1)):
                    emit_cstr("usage: elisa-c-transpiler [--fidelity|--idiomatic] [--frontend-stats] [--explain-rewrites] [--dump-typed-ir] [--diagnostics-json] [--source-map-json PATH] [--frontend-timeout-seconds N] [--max-frontend-output-bytes N] [--max-frontend-json-values N] [--max-input-sources N] [--cpp-lib-dir DIR --elisa-std-dir DIR] [--output-dir DIR] [--compile-commands PATH] <input.c>...\n".cast[cstr])
                    return 0
                elif argument.len > 0 and string_view_index(argument, 0) == 45:
                    emit_cstr("elisa-c-transpiler: unknown option\n".cast[cstr])
                    return 2
                else:
                    canonical_path_bytes: mutable darray[u8] = []
                    canonical_path_valid: bool = ast_json_resolve_path(argument, sview("", 0, 0), &canonical_path_bytes) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
                    canonical_path: sview = sview(ctx_string_from_view(bytes_view(canonical_path_bytes)), 0, -1) if canonical_path_valid else sview("", 0, 0)
                    sources.push(CliSource{path: argument, canonical_path: canonical_path, directory: sview("", 0, 0), command: sview("", 0, 0), argv_signature: sview("", 0, 0), arguments: [], has_arguments: false, command_valid: true, short_enums: false, floating_point_options: clang_fp_options_default()})
                    index <- index + 1
            if sources.count > max_input_sources:
                cli_emit_input_source_limit_error(sview("command line", 0, -1), max_input_sources) can Console, Unsafe.PointerCast
                return 2
            if (sview(cpp_compatibility_library_directory, 0, -1).len > 0) != (sview(cpp_compatibility_std_directory, 0, -1).len > 0):
                emit_view_fd(sview("elisa-c-transpiler: --cpp-lib-dir and --elisa-std-dir must be provided together\n", 0, -1), 2)
                return 2
            if compile_commands.len > 0:
                command_path: mutable darray[u8] = []
                command_cstr: cstr = cli_copy_path(&command_path, compile_commands)
                commands_succeeded: mutable bool = false
                commands_limit_exceeded: mutable bool = false
                commands_bytes: mutable darray[u8] = []
                run_file_output(command_cstr, &commands_bytes, &commands_succeeded, &commands_limit_exceeded, max_frontend_output_bytes) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                if not commands_succeeded:
                    emit_view_fd(sview("elisa-c-transpiler: compilation database exceeded --max-frontend-output-bytes: ", 0, -1), 2) if commands_limit_exceeded else emit_view_fd(sview("elisa-c-transpiler: failed to read compilation database ", 0, -1), 2)
                    emit_view_fd(compile_commands, 2)
                    emit_view_fd(sview("\n", 0, -1), 2)
                    return 1
                duplicate_conflict: mutable bool = false
                conflicting_source: mutable sview = sview("", 0, 0)
                commands_json_value_limit_exceeded: mutable bool = false
                source_entry_limit_exceeded: mutable bool = false
                invalid_database: mutable bool = false
                invalid_compile_command: mutable bool = false
                invalid_compile_command_is_text: mutable bool = false
                invalid_compile_command_source: mutable sview = sview("", 0, 0)
                source_operand_mismatch: mutable bool = false
                mismatched_source: mutable sview = sview("", 0, 0)
                response_failure: mutable ClangResponseFailure = ClangResponseFailure.None
                response_failure_source: mutable sview = sview("", 0, 0)
                response_failure_path: mutable darray[u8] = []
                remaining_input_sources: usize = (max_input_sources.i64() - sources.count.i64()).usize()
                compile_sources: darray[CliSource] = cli_compile_command_sources(commands_bytes, max_frontend_output_bytes, max_frontend_json_values, remaining_input_sources, &commands_json_value_limit_exceeded, &source_entry_limit_exceeded, &invalid_database, &invalid_compile_command, &invalid_compile_command_is_text, &invalid_compile_command_source, &duplicate_conflict, &conflicting_source, &source_operand_mismatch, &mismatched_source, &response_failure, &response_failure_source, &response_failure_path) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                if commands_json_value_limit_exceeded:
                    cli_emit_compile_database_json_value_limit_error(compile_commands, max_frontend_json_values) can Console, Unsafe.PointerCast
                    return 1
                if source_entry_limit_exceeded:
                    cli_emit_input_source_limit_error(compile_commands, max_input_sources) can Console, Unsafe.PointerCast
                    return 1
                if invalid_database:
                    cli_emit_invalid_compilation_database(compile_commands) can Console, Unsafe.PointerCast
                    return 1
                if response_failure != ClangResponseFailure.None:
                    cli_emit_response_file_failure(response_failure_source, response_failure_path, response_failure) can Console, Unsafe.PointerCast
                    return 1
                if invalid_compile_command:
                    cli_emit_invalid_compile_command(invalid_compile_command_source, invalid_compile_command_is_text) can Console, Unsafe.PointerCast
                    return 1
                if source_operand_mismatch:
                    emit_view_fd(sview("elisa-c-transpiler: compilation database file is not an input operand in its compile command: ", 0, -1), 2)
                    emit_view_fd(mismatched_source, 2)
                    emit_view_fd(sview("\n", 0, -1), 2)
                    return 1
                if duplicate_conflict:
                    emit_view_fd(sview("elisa-c-transpiler: conflicting compilation database entries for ", 0, -1), 2)
                    emit_view_fd(conflicting_source, 2)
                    emit_view_fd(sview("\n", 0, -1), 2)
                    return 1
                for compile_index in 0..<compile_sources.count |sources, compile_sources|:
                    sources.push(compile_sources[compile_index])
            return 2 if sources.count == 0
            if sources.count > 1 and output_directory.len == 0:
                emit_cstr("elisa-c-transpiler: multiple inputs require --output-dir\n".cast[cstr])
                return 2
            project_mode: bool = output_directory.len > 0 or compile_commands.len > 0 or sources.count > 1
            return 2 if not (cli_source_map_validate_request(source_map_path, output_directory, sources) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
            if source_map_path.len > 0 and output_directory.len > 0:
                source_map_project_state <- cli_source_map_project_new(sources.count) can Memory.Allocate, Abort.Panic
            transaction_id: mutable i64 = 0
            transaction_id <- clang_getpid().i64() if output_directory.len > 0
            colliding_name_first: mutable i64 = -1
            colliding_name_second: mutable i64 = -1
            if cli_project_name_hash_collision(sources, &colliding_name_first, &colliding_name_second):
                emit_view_fd(sview("elisa-c-transpiler: project inputs have indistinguishable stable output identities: ", 0, -1), 2)
                emit_view_fd(sources[colliding_name_first.usize()].path, 2)
                emit_view_fd(sview(" and ", 0, -1), 2)
                emit_view_fd(sources[colliding_name_second.usize()].path, 2)
                emit_view_fd(sview("\n", 0, -1), 2)
                return 1
            cli_sort_project_sources(sources) if project_mode
            manifest_sources: mutable darray[CliSource] = []
            # Reserve project manifest ownership in the outer translation
