extend CTranslator:
    struct CliSource:
        path: sview
        directory: sview
        command: sview

    def emit_view_fd(value: sview, fd: i64) -> void can[Console, Unsafe.PointerCast]:
        return if value.len == 0
        raw: void& = value.data.cast[void&] can Unsafe.PointerCast
        _ = write(fd, raw, value.len.usize()) can Console

    def emit_view(value: sview) -> void can[Console, Unsafe.PointerCast]:
        emit_view_fd(value, 1) can Console, Unsafe.PointerCast

    def emit_typed_diagnostics(diagnostics: darray[TypedDiagnostic]) -> void can[Console, Unsafe.PointerCast]:
        output: mutable darray[u8] = []
        for index in 0..<diagnostics.count |output, diagnostics|:
            typed_append_diagnostic(&output, diagnostics[index])
        emit_view_fd(bytes_view(output), 2) can Console, Unsafe.PointerCast

    def emit_cstr(value: cstr) -> void can[Console, Unsafe.PointerCast]:
        emit_view(sview(value, 0, -1)) can Console, Unsafe.PointerCast

    def cli_is_option(value: sview, wanted: sview) -> bool:
        return sview_eq(value, wanted)

    def cli_compile_command_sources(raw: darray[u8]) -> darray[CliSource] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        sources: mutable darray[CliSource] = []
        parsed: JsonParseResult = json_parse_checked(&perm_arena, bytes_view(raw))
        return sources if parsed.code != JsonErrorCode.OK
        count: i64 = json_array_len(parsed.value)
        return sources if count < 0
        for index in 0..<count |sources, parsed|:
            entry: JsonValue = ast_array_item(parsed.value, index)
            file: sview = ast_string(ast_field(entry, sview("file", 0, -1)))
            directory: sview = ast_string(ast_field(entry, sview("directory", 0, -1)))
            command: sview = ast_string(ast_field(entry, sview("command", 0, -1)))
            # The compile command runs from `directory`, so Clang records a
            # relative file spelling relative to that directory. Preserve that
            # spelling for AST provenance; only synthesize a cwd-relative path
            # when an entry has no command and must use the simple frontend.
            if file.len > 0 and (command.len > 0 or directory.len == 0 or string_view_index(file, 0) == 47):
                sources.push(CliSource{path: file, directory: directory, command: command})
            elif file.len > 0:
                joined: mutable darray[u8] = []
                append_view(&joined, directory)
                append_view(&joined, sview("/", 0, -1)) if directory.len > 0 and string_view_index(directory, directory.len - 1) != 47
                append_view(&joined, file)
                sources.push(CliSource{path: sview(ctx_string_from_view(bytes_view(joined)), 0, -1), directory: directory, command: command})
        return sources

    def cli_module_stem(source: sview) -> sview:
        start: mutable i64 = 0
        dot: mutable i64 = -1
        for index in 0..<source.len |source, start, dot|:
            start <- index + 1 if string_view_index(source, index) == 47
            dot <- index if string_view_index(source, index) == 46
        end: i64 = dot if dot > start else source.len
        return string_view_prefix(string_view_suffix(source, start), end - start)

    def cli_module_name(out: mutable darray[u8]&, source: sview) -> void:
        append_view(out, cli_module_stem(source))
        append_view(out, sview(".elisa", 0, -1))

    def cli_module_name_for_sources(out: mutable darray[u8]&, sources: darray[CliSource], source_index: i64) -> void:
        source: sview = sources[source_index.usize()].path
        stem: sview = cli_module_stem(source)
        occurrence: mutable i64 = 1
        for index in 0..<source_index |sources, stem, occurrence|:
            occurrence <- occurrence + 1 if sview_eq(cli_module_stem(sources[index.usize()].path), stem)
        append_view(out, stem)
        append_view(out, sview("_", 0, -1)) if occurrence > 1
        append_i64(out, occurrence) if occurrence > 1
        append_view(out, sview(".elisa", 0, -1))

    def cli_output_path_for_sources(out: mutable darray[u8]&, directory: sview, sources: darray[CliSource], source_index: i64) -> void:
        append_view(out, directory)
        append_view(out, sview("/", 0, -1)) if directory.len > 0 and string_view_index(directory, directory.len - 1) != 47
        cli_module_name_for_sources(out, sources, source_index)
        out.push(0)

    def cli_output_path(out: mutable darray[u8]&, directory: sview, source: sview) -> void:
        append_view(out, directory)
        append_view(out, sview("/", 0, -1)) if directory.len > 0 and string_view_index(directory, directory.len - 1) != 47
        cli_module_name(out, source)
        out.push(0)

    def cli_write_bytes(path: sview, bytes: darray[u8]) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        path_cstr: cstr = ctx_string_from_view(path) can Memory.Allocate, Abort.Panic
        stream: mutable heap void&? = c_fopen(path_cstr, "wb")
        return false if stream == null
        handle: mutable heap void& = stream
        if bytes.count > 0.usize():
            payload: sview = bytes_view(bytes)
            raw_payload: void& = payload.data.cast[void&] can Unsafe.PointerCast
            written: usize = c_fwrite(raw_payload, 1.usize(), bytes.count, handle) can Unsafe.PointerCast
            if written != bytes.count:
                _ = c_fclose(handle)
                return false
        return c_fclose(handle) == 0

    def cli_copy_path(out: mutable darray[u8]&, source: sview) -> cstr:
        append_view(out, source)
        out.push(0)
        return (&out[0]).cast[cstr]

    def cli_emit_project_manifest(directory: sview, sources: darray[CliSource]) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        manifest: mutable darray[u8] = []
        append_view(&manifest, sview("# Generated by the Elisa C translator.\n", 0, -1))
        # The manifest is shared by all generated modules, so retain both
        # optional runtime fragments even when an individual module does not
        # use them.
        typed_emit_runtime_prelude(&manifest, true, true)
        for index in 0..<sources.count |manifest, sources|:
            module: mutable darray[u8] = []
            cli_module_name_for_sources(&module, sources, index)
            append_view(&manifest, sview("include \"", 0, -1))
            append_view(&manifest, bytes_view(module))
            append_view(&manifest, sview("\"\n", 0, -1))
        manifest_path: mutable darray[u8] = []
        append_view(&manifest_path, directory)
        append_view(&manifest_path, sview("/elisa_project.elisa", 0, -1))
        manifest_path.push(0)
        return cli_write_bytes(bytes_view(manifest_path), manifest)

    def run(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
        region translation:
            if argc < 2:
                emit_cstr("usage: elisa-c-transpiler [--fidelity|--idiomatic] [--output-dir DIR] [--compile-commands PATH] <input.c>...".cast[cstr])
                emit_cstr("\n".cast[cstr])
                return 2

            argv_slots: mutable cstr&& = argv.cast[mutable cstr&&]
            if argc == 2 and not cli_is_option(sview(argv_slots[1.usize()].cast[cstr], 0, -1), sview("--help", 0, -1)):
                input: cstr = argv_slots[1.usize()].cast[cstr]
                ast_bytes: darray[u8] = run_clang_ast(input)
                if ast_bytes.count == 0.usize():
                    emit_cstr("clang produced no AST\n".cast[cstr])
                    return 1
                translation: TypedTranslation = translate_ast_mode_with_options(ast_bytes, input, true, TypedTranslationMode.Idiomatic) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                if translation.failed:
                    emit_typed_diagnostics(translation.diagnostics)
                    return 1
                emit_view(bytes_view(translation.output))
                return 0
            sources: mutable darray[CliSource] = []
            output_directory: mutable sview = sview("", 0, 0)
            compile_commands: mutable sview = sview("", 0, 0)
            mode: mutable TypedTranslationMode = TypedTranslationMode.Idiomatic
            index: mutable i64 = 1
            while index < argc |argv_slots, sources, output_directory, compile_commands, mode, index|:
                argument: sview = sview(argv_slots[index.usize()].cast[cstr], 0, -1)
                if cli_is_option(argument, sview("--output-dir", 0, -1)) and index + 1 < argc:
                    output_directory <- sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1)
                    index <- index + 2
                elif cli_is_option(argument, sview("--compile-commands", 0, -1)) and index + 1 < argc:
                    compile_commands <- sview(argv_slots[(index + 1).usize()].cast[cstr], 0, -1)
                    index <- index + 2
                elif cli_is_option(argument, sview("--fidelity", 0, -1)):
                    mode <- TypedTranslationMode.Fidelity
                    index <- index + 1
                elif cli_is_option(argument, sview("--idiomatic", 0, -1)):
                    mode <- TypedTranslationMode.Idiomatic
                    index <- index + 1
                elif cli_is_option(argument, sview("--help", 0, -1)):
                    emit_cstr("usage: elisa-c-transpiler [--fidelity|--idiomatic] [--output-dir DIR] [--compile-commands PATH] <input.c>...\n".cast[cstr])
                    return 0
                elif argument.len > 0 and string_view_index(argument, 0) == 45:
                    emit_cstr("elisa-c-transpiler: unknown option\n".cast[cstr])
                    return 2
                else:
                    sources.push(CliSource{path: argument, directory: sview("", 0, 0), command: sview("", 0, 0)})
                    index <- index + 1
            if compile_commands.len > 0:
                command_path: mutable darray[u8] = []
                command_cstr: cstr = cli_copy_path(&command_path, compile_commands)
                command: mutable darray[u8] = []
                append_literal(&command, "cat ")
                append_shell_quoted(&command, command_cstr)
                command.push(0)
                compile_sources: darray[CliSource] = cli_compile_command_sources(run_command_output((&command[0]).cast[cstr])) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                for compile_index in 0..<compile_sources.count |sources, compile_sources|:
                    sources.push(compile_sources[compile_index])
            return 2 if sources.count == 0
            if sources.count > 1 and output_directory.len == 0:
                emit_cstr("elisa-c-transpiler: multiple inputs require --output-dir\n".cast[cstr])
                return 2
            manifest_sources: mutable darray[CliSource] = []
            for source_index in 0..<sources.count |sources, output_directory, manifest_sources|:
                source_entry: CliSource = sources[source_index]
                source: sview = source_entry.path
                source_path: mutable darray[u8] = []
                input: cstr = cli_copy_path(&source_path, source)
                ast_bytes: darray[u8] = run_clang_ast(input) if source_entry.command.len == 0 else run_clang_ast_command(source_entry.directory, source_entry.command)
                if ast_bytes.count == 0.usize():
                    emit_cstr("clang produced no AST\n".cast[cstr])
                    return 1
                translation: TypedTranslation = translate_ast_mode_with_options(ast_bytes, input, output_directory.len == 0, mode) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                if translation.failed:
                    emit_typed_diagnostics(translation.diagnostics)
                    return 1
                if output_directory.len == 0:
                    emit_view(bytes_view(translation.output))
                else:
                    generated_path: mutable darray[u8] = []
                    cli_output_path_for_sources(&generated_path, output_directory, sources, source_index)
                    return 1 if not cli_write_bytes(bytes_view(generated_path), translation.output)
                    manifest_sources.push(source_entry)
            if output_directory.len > 0:
                return 1 if not cli_emit_project_manifest(output_directory, manifest_sources)
            return 0
