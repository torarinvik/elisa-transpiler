extend CTranslator:
    struct TypedContentHash:
        value: u64
        available: bool

    struct TypedSourceRange[@r]:
        file: sview @r
        included_from: sview @r
        start_offset: i64
        end_offset: i64

    struct TypedIRSourceOrigin[@r]:
        node: JsonValueHandle[r]
        translation_unit: sview @r
        source: TypedSourceRange[r]
        spelling: TypedSourceRange[r]
        expansion: TypedSourceRange[r]
        synthesized_reason: sview @r

    struct TypedGeneratedSourceSpan[@r]:
        generated_start: i64
        generated_end: i64
        translation_unit: sview @r
        source_file: sview @r
        source_included_from: sview @r
        source_start_offset: i64
        source_end_offset: i64
        spelling_file: sview @r
        spelling_included_from: sview @r
        spelling_start_offset: i64
        spelling_end_offset: i64
        expansion_file: sview @r
        expansion_included_from: sview @r
        expansion_start_offset: i64
        expansion_end_offset: i64
        synthesized_reason: sview @r

    def typed_copy_view_to_region[@r](value: sview) -> sview @r can[Memory.Allocate, Abort.Panic]:
        return sview("", 0, 0) if value.len == 0
        copied: darray[u8] @r = clone[darray[u8] @r](value) can Memory.Allocate, Abort.Panic
        return bytes_view(copied)
