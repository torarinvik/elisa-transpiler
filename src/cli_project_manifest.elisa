extend CTranslator:
    def cli_emit_project_initializer(manifest: mutable darray[u8]&, sources: darray[CliSource]) -> void:
        append_view(manifest, sview("\ndef elisa_init_project() -> void can[Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef]:\n", 0, -1))
        append_view(manifest, sview("    can Abort.Panic, Global, Unsafe.PointerCast, Unsafe.BufferReinterpret, Unsafe.StaleRef:\n", 0, -1))
        if sources.count == 0.usize():
            append_view(manifest, sview("        pass\n", 0, -1))
            return
        for index in 0..<sources.count |manifest, sources|:
            append_view(manifest, sview("        ", 0, -1))
            cli_append_initializer_name_for_sources(manifest, sources, index)
            append_view(manifest, sview("()\n", 0, -1))

    def cli_emit_project_manifest(directory: sview, sources: darray[CliSource], needs_cpp_unordered_map: bool, needs_runtime_nonnull: bool, needs_runtime_readonly_nonnull: bool, needs_runtime_varargs: bool, transaction_id: i64) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        manifest: mutable darray[u8] = []
        append_view(&manifest, sview("# Generated by the Elisa C translator.\n", 0, -1))
        # The manifest is shared by all generated modules, so retain both
        # optional runtime fragments even when an individual module does not
        # use them.
        typed_emit_runtime_prelude(&manifest, needs_runtime_nonnull, needs_runtime_readonly_nonnull, needs_runtime_varargs)
        typed_emit_cpp_compatibility(&manifest, needs_cpp_unordered_map)
        for index in 0..<sources.count |manifest, sources|:
            module: mutable darray[u8] = []
            cli_module_name_for_sources(&module, sources, index)
            append_view(&manifest, sview("include \"", 0, -1))
            append_view(&manifest, bytes_view(module))
            append_view(&manifest, sview("\"\n", 0, -1))
        cli_emit_project_initializer(&manifest, sources)
        manifest_path: mutable darray[u8] = []
        cli_staged_manifest_path(&manifest_path, directory, transaction_id)
        return cli_write_bytes(bytes_view(manifest_path), manifest)
