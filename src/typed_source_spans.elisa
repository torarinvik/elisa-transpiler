extend CTranslator:
    def typed_copy_generated_source_spans[@source, @target](spans: darray[TypedGeneratedSourceSpan[source]] @source) -> darray[TypedGeneratedSourceSpan[target]] @target can[Memory.Allocate, Abort.Panic]:
        copied: mutable darray[TypedGeneratedSourceSpan[target]] @target = []
        for index in 0..<spans.count |spans, copied|:
            span: TypedGeneratedSourceSpan[source] = spans[index]
            translation_unit_bytes: darray[u8] @target = clone[darray[u8] @target](span.translation_unit) can Memory.Allocate, Abort.Panic
            source_file_bytes: darray[u8] @target = clone[darray[u8] @target](span.source_file) can Memory.Allocate, Abort.Panic
            source_include_bytes: darray[u8] @target = clone[darray[u8] @target](span.source_included_from) can Memory.Allocate, Abort.Panic
            spelling_file_bytes: darray[u8] @target = clone[darray[u8] @target](span.spelling_file) can Memory.Allocate, Abort.Panic
            spelling_include_bytes: darray[u8] @target = clone[darray[u8] @target](span.spelling_included_from) can Memory.Allocate, Abort.Panic
            expansion_file_bytes: darray[u8] @target = clone[darray[u8] @target](span.expansion_file) can Memory.Allocate, Abort.Panic
            expansion_include_bytes: darray[u8] @target = clone[darray[u8] @target](span.expansion_included_from) can Memory.Allocate, Abort.Panic
            synthesized_reason_bytes: darray[u8] @target = clone[darray[u8] @target](span.synthesized_reason) can Memory.Allocate, Abort.Panic
            translation_unit_copy: sview @target = bytes_view(translation_unit_bytes)
            source_file_copy: sview @target = bytes_view(source_file_bytes)
            source_include_copy: sview @target = bytes_view(source_include_bytes)
            spelling_file_copy: sview @target = bytes_view(spelling_file_bytes)
            spelling_include_copy: sview @target = bytes_view(spelling_include_bytes)
            expansion_file_copy: sview @target = bytes_view(expansion_file_bytes)
            expansion_include_copy: sview @target = bytes_view(expansion_include_bytes)
            synthesized_reason_copy: sview @target = bytes_view(synthesized_reason_bytes)
            copied.push(TypedGeneratedSourceSpan[target]{
                generated_start: span.generated_start + 0,
                generated_end: span.generated_end + 0,
                translation_unit: translation_unit_copy,
                source_file: source_file_copy,
                source_included_from: source_include_copy,
                source_start_offset: span.source_start_offset + 0,
                source_end_offset: span.source_end_offset + 0,
                spelling_file: spelling_file_copy,
                spelling_included_from: spelling_include_copy,
                spelling_start_offset: span.spelling_start_offset + 0,
                spelling_end_offset: span.spelling_end_offset + 0,
                expansion_file: expansion_file_copy,
                expansion_included_from: expansion_include_copy,
                expansion_start_offset: span.expansion_start_offset + 0,
                expansion_end_offset: span.expansion_end_offset + 0,
                synthesized_reason: synthesized_reason_copy
            })
        return copied

    def typed_copy_diagnostics[@source, @target](diagnostics: darray[TypedDiagnostic[source]] @source) -> darray[TypedDiagnostic[target]] @target can[Memory.Allocate, Abort.Panic]:
        copied: mutable darray[TypedDiagnostic[target]] @target = []
        for index in 0..<diagnostics.count |diagnostics, copied|:
            diagnostic: TypedDiagnostic[source] = diagnostics[index]
            category_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.category) can Memory.Allocate, Abort.Panic
            kind_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.kind) can Memory.Allocate, Abort.Panic
            subject_type_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.subject_type) can Memory.Allocate, Abort.Panic
            required_capability_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.required_capability) can Memory.Allocate, Abort.Panic
            translation_unit_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.translation_unit) can Memory.Allocate, Abort.Panic
            source_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.source) can Memory.Allocate, Abort.Panic
            canonical_source_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.canonical_source) can Memory.Allocate, Abort.Panic
            spelling_source_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.spelling_source) can Memory.Allocate, Abort.Panic
            spelling_canonical_source_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.spelling_canonical_source) can Memory.Allocate, Abort.Panic
            spelling_included_from_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.spelling_included_from) can Memory.Allocate, Abort.Panic
            spelling_included_from_canonical_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.spelling_included_from_canonical) can Memory.Allocate, Abort.Panic
            expansion_source_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.expansion_source) can Memory.Allocate, Abort.Panic
            expansion_canonical_source_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.expansion_canonical_source) can Memory.Allocate, Abort.Panic
            expansion_included_from_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.expansion_included_from) can Memory.Allocate, Abort.Panic
            expansion_included_from_canonical_bytes: darray[u8] @target = clone[darray[u8] @target](diagnostic.expansion_included_from_canonical) can Memory.Allocate, Abort.Panic
            category_copy: sview @target = bytes_view(category_bytes)
            kind_copy: sview @target = bytes_view(kind_bytes)
            subject_type_copy: sview @target = bytes_view(subject_type_bytes)
            required_capability_copy: sview @target = bytes_view(required_capability_bytes)
            translation_unit_copy: sview @target = bytes_view(translation_unit_bytes)
            source_copy: sview @target = bytes_view(source_bytes)
            canonical_source_copy: sview @target = bytes_view(canonical_source_bytes)
            spelling_source_copy: sview @target = bytes_view(spelling_source_bytes)
            spelling_canonical_source_copy: sview @target = bytes_view(spelling_canonical_source_bytes)
            spelling_included_from_copy: sview @target = bytes_view(spelling_included_from_bytes)
            spelling_included_from_canonical_copy: sview @target = bytes_view(spelling_included_from_canonical_bytes)
            expansion_source_copy: sview @target = bytes_view(expansion_source_bytes)
            expansion_canonical_source_copy: sview @target = bytes_view(expansion_canonical_source_bytes)
            expansion_included_from_copy: sview @target = bytes_view(expansion_included_from_bytes)
            expansion_included_from_canonical_copy: sview @target = bytes_view(expansion_included_from_canonical_bytes)
            copied.push(TypedDiagnostic[target]{
                category: category_copy,
                kind: kind_copy,
                subject_type: subject_type_copy,
                required_capability: required_capability_copy,
                translation_unit: translation_unit_copy,
                translation_unit_content_hash: diagnostic.translation_unit_content_hash,
                source: source_copy,
                canonical_source: canonical_source_copy,
                source_content_hash: diagnostic.source_content_hash,
                spelling_source: spelling_source_copy,
                spelling_canonical_source: spelling_canonical_source_copy,
                spelling_source_content_hash: diagnostic.spelling_source_content_hash,
                spelling_included_from: spelling_included_from_copy,
                spelling_included_from_canonical: spelling_included_from_canonical_copy,
                spelling_included_from_content_hash: diagnostic.spelling_included_from_content_hash,
                expansion_source: expansion_source_copy,
                expansion_canonical_source: expansion_canonical_source_copy,
                expansion_source_content_hash: diagnostic.expansion_source_content_hash,
                expansion_included_from: expansion_included_from_copy,
                expansion_included_from_canonical: expansion_included_from_canonical_copy,
                expansion_included_from_content_hash: diagnostic.expansion_included_from_content_hash,
                range_start_offset: diagnostic.range_start_offset,
                range_end_offset: diagnostic.range_end_offset,
                line: diagnostic.line,
                column: diagnostic.column,
                spelling_line: diagnostic.spelling_line,
                spelling_column: diagnostic.spelling_column,
                expansion_line: diagnostic.expansion_line,
                expansion_column: diagnostic.expansion_column
            })
        return copied

    def typed_append_copied_diagnostics[@source, @target](out: mutable darray[TypedDiagnostic[target]]& @target, diagnostics: darray[TypedDiagnostic[source]] @source) -> void can[Memory.Allocate, Abort.Panic]:
        copied: darray[TypedDiagnostic[target]] @target = typed_copy_diagnostics(diagnostics) can Memory.Allocate, Abort.Panic
        for index in 0..<copied.count |out, copied|:
            out.push(copied[index])

    def typed_begin_statement_source_span[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, index: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
        return -1 if not ctx.source_mapping_enabled or index < 0 or index >= ctx.stmt_source_origins.count.i64()
        origin: TypedIRSourceOrigin[r] = ctx.stmt_source_origins[index.usize()]
        return -1 if json_handle_is_null(origin.node)
        span_index: i64 = ctx.generated_source_spans.count.i64()
        reason: sview @r = origin.synthesized_reason
        ctx.generated_source_spans.push(TypedGeneratedSourceSpan[r]{generated_start: out.count.i64(), generated_end: -1, translation_unit: origin.translation_unit, source_file: origin.source.file, source_included_from: origin.source.included_from, source_start_offset: origin.source.start_offset, source_end_offset: origin.source.end_offset, spelling_file: origin.spelling.file, spelling_included_from: origin.spelling.included_from, spelling_start_offset: origin.spelling.start_offset, spelling_end_offset: origin.spelling.end_offset, expansion_file: origin.expansion.file, expansion_included_from: origin.expansion.included_from, expansion_start_offset: origin.expansion.start_offset, expansion_end_offset: origin.expansion.end_offset, synthesized_reason: reason})
        return span_index

    def typed_finish_statement_source_span[@r](out: mutable darray[u8]&, ctx: mutable TypedContext[r]&, span_index: i64) -> void can[Memory.Allocate, Abort.Panic]:
        return if span_index < 0 or span_index >= ctx.generated_source_spans.count.i64()
        span: TypedGeneratedSourceSpan[r] = ctx.generated_source_spans[span_index.usize()]
        ctx.generated_source_spans[span_index.usize()] <- TypedGeneratedSourceSpan[r]{generated_start: span.generated_start, generated_end: out.count.i64(), translation_unit: span.translation_unit, source_file: span.source_file, source_included_from: span.source_included_from, source_start_offset: span.source_start_offset, source_end_offset: span.source_end_offset, spelling_file: span.spelling_file, spelling_included_from: span.spelling_included_from, spelling_start_offset: span.spelling_start_offset, spelling_end_offset: span.spelling_end_offset, expansion_file: span.expansion_file, expansion_included_from: span.expansion_included_from, expansion_start_offset: span.expansion_start_offset, expansion_end_offset: span.expansion_end_offset, synthesized_reason: span.synthesized_reason}
