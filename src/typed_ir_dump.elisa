extend CTranslator:
    def typed_dump_append_view(out: mutable darray[u8]&, value: sview) -> void:
        for index in 0..<value.len |out, value|:
            out.push(string_view_index(value, index).u8())

    def typed_dump_expr_kind(kind: TypedExprKind) -> sview:
        match kind:
            TypedExprKind.Invalid:
                return "Invalid"
            TypedExprKind.Integer:
                return "Integer"
            TypedExprKind.Floating:
                return "Floating"
            TypedExprKind.String:
                return "String"
            TypedExprKind.Character:
                return "Character"
            TypedExprKind.Name:
                return "Name"
            TypedExprKind.Binary:
                return "Binary"
            TypedExprKind.Unary:
                return "Unary"
            TypedExprKind.ArrayIndex:
                return "ArrayIndex"
            TypedExprKind.Conditional:
                return "Conditional"
            TypedExprKind.Member:
                return "Member"
            TypedExprKind.Call:
                return "Call"
            TypedExprKind.Sizeof:
                return "Sizeof"
            TypedExprKind.ObjectSizeRemaining:
                return "ObjectSizeRemaining"
            TypedExprKind.Cast:
                return "Cast"
            TypedExprKind.Aggregate:
                return "Aggregate"
            TypedExprKind.Sequence:
                return "Sequence"
            TypedExprKind.Null:
                return "Null"
            TypedExprKind.Zeroed:
                return "Zeroed"
        return "UnknownExpr"

    def typed_dump_stmt_kind(kind: TypedStmtKind) -> sview:
        match kind:
            TypedStmtKind.Invalid:
                return "Invalid"
            TypedStmtKind.Block:
                return "Block"
            TypedStmtKind.Return:
                return "Return"
            TypedStmtKind.Declaration:
                return "Declaration"
            TypedStmtKind.If:
                return "If"
            TypedStmtKind.Expression:
                return "Expression"
            TypedStmtKind.For:
                return "For"
            TypedStmtKind.While:
                return "While"
            TypedStmtKind.DoWhile:
                return "DoWhile"
            TypedStmtKind.Break:
                return "Break"
            TypedStmtKind.Continue:
                return "Continue"
            TypedStmtKind.Goto:
                return "Goto"
            TypedStmtKind.Label:
                return "Label"
            TypedStmtKind.Switch:
                return "Switch"
            TypedStmtKind.SwitchBreak:
                return "SwitchBreak"
            TypedStmtKind.Null:
                return "Null"
        return "UnknownStmt"

    def typed_dump_append_i64(out: mutable darray[u8]&, value: i64) -> void:
        if value == -9223372036854775808:
            typed_dump_append_view(out, sview("-9223372036854775808", 0, -1))
            return
        magnitude: mutable i64 = value
        if magnitude < 0:
            out.push(45)
            magnitude <- 0 - magnitude
        if magnitude == 0:
            out.push(48)
            return
        digits: mutable i64[24] = zeroed
        count: mutable i64 = 0
        while magnitude > 0 |magnitude, digits, count|:
            digits[count] <- magnitude % 10
            magnitude <- magnitude / 10
            count <- count + 1
        for index in 0..<count |out, digits, count|:
            out.push((digits[count - index - 1] + 48).u8())

    def typed_dump_append_hex(out: mutable darray[u8]&, value: sview) -> void:
        digits: sview = "0123456789abcdef"
        for index in 0..<value.len |out, value, digits|:
            byte: i64 = string_view_index(value, index)
            out.push(string_view_index(digits, byte / 16).u8())
            out.push(string_view_index(digits, byte % 16).u8())

    def typed_dump_append_hex_u64(out: mutable darray[u8]&, value: u64) -> void:
        digits: sview = "0123456789abcdef"
        for index in 0..<16 |out, value, digits|:
            shift: i64 = (15 - index) * 4
            digit: i64 = ((value >> shift.u64()) & 15.u64()).i64()
            out.push(string_view_index(digits, digit).u8())

    def typed_dump_append_content_hash(out: mutable darray[u8]&, name: sview, hash: TypedContentHash) -> void:
        typed_dump_append_view(out, sview(" ", 0, -1))
        typed_dump_append_view(out, name)
        typed_dump_append_view(out, sview("=", 0, -1))
        if hash.available:
            typed_dump_append_hex_u64(out, hash.value)
        else:
            typed_dump_append_view(out, sview("null", 0, -1))

    def typed_dump_append_bool(out: mutable darray[u8]&, value: bool) -> void:
        if value:
            typed_dump_append_view(out, sview("true", 0, -1))
        else:
            typed_dump_append_view(out, sview("false", 0, -1))

    def typed_dump_append_fp_option(out: mutable darray[u8]&, name: sview, value: sview) -> void:
        typed_dump_append_view(out, sview("fp_option ", 0, -1))
        typed_dump_append_view(out, name)
        typed_dump_append_view(out, sview("=", 0, -1))
        typed_dump_append_view(out, value)
        typed_dump_append_view(out, sview("\n", 0, -1))

    def typed_dump_append_fp_options(out: mutable darray[u8]&, options: ClangFPOptionVector) -> void:
        typed_dump_append_fp_option(out, sview("exception_behavior", 0, -1), clang_fp_exception_setting_name(options.exception_behavior))
        typed_dump_append_fp_option(out, sview("fenv_access", 0, -1), clang_fp_boolean_setting_name(options.fenv_access))
        typed_dump_append_fp_option(out, sview("rounding_mode", 0, -1), clang_fp_rounding_setting_name(options.rounding_mode))
        typed_dump_append_fp_option(out, sview("rounding_math", 0, -1), clang_fp_boolean_setting_name(options.rounding_math))
        typed_dump_append_fp_option(out, sview("contract", 0, -1), clang_fp_contract_setting_name(options.contract))
        typed_dump_append_fp_option(out, sview("explicit_contract", 0, -1), clang_fp_contract_setting_name(options.explicit_contract))
        typed_dump_append_fp_option(out, sview("contract_explicitly_seen", 0, -1), "true" if options.contract_explicitly_seen else "false")
        typed_dump_append_fp_option(out, sview("denormal", 0, -1), clang_fp_denormal_setting_name(options.denormal))
        typed_dump_append_fp_option(out, sview("denormal_fp32", 0, -1), clang_fp_denormal_setting_name(options.denormal_fp32))
        typed_dump_append_fp_option(out, sview("math_errno", 0, -1), clang_fp_boolean_setting_name(options.math_errno))
        typed_dump_append_fp_option(out, sview("honor_nans", 0, -1), clang_fp_boolean_setting_name(options.honor_nans))
        typed_dump_append_fp_option(out, sview("honor_infinities", 0, -1), clang_fp_boolean_setting_name(options.honor_infinities))
        typed_dump_append_fp_option(out, sview("finite_math_only", 0, -1), clang_fp_boolean_setting_name(options.finite_math_only))
        typed_dump_append_fp_option(out, sview("signed_zeros", 0, -1), clang_fp_boolean_setting_name(options.signed_zeros))
        typed_dump_append_fp_option(out, sview("associative_math", 0, -1), clang_fp_boolean_setting_name(options.associative_math))
        typed_dump_append_fp_option(out, sview("reciprocal_math", 0, -1), clang_fp_boolean_setting_name(options.reciprocal_math))
        typed_dump_append_fp_option(out, sview("approximate_functions", 0, -1), clang_fp_boolean_setting_name(options.approximate_functions))
        typed_dump_append_fp_option(out, sview("trapping_math", 0, -1), clang_fp_boolean_setting_name(options.trapping_math))
        typed_dump_append_fp_option(out, sview("cx_limited_range", 0, -1), clang_fp_boolean_setting_name(options.cx_limited_range))
        typed_dump_append_fp_option(out, sview("float_store", 0, -1), clang_fp_boolean_setting_name(options.float_store))
        typed_dump_append_fp_option(out, sview("strict_float_cast_overflow", 0, -1), clang_fp_boolean_setting_name(options.strict_float_cast_overflow))
        typed_dump_append_fp_option(out, sview("single_precision_constant", 0, -1), clang_fp_boolean_setting_name(options.single_precision_constant))
        typed_dump_append_fp_option(out, sview("protect_parens", 0, -1), clang_fp_boolean_setting_name(options.protect_parens))
        typed_dump_append_fp_option(out, sview("complex_arithmetic", 0, -1), clang_fp_complex_setting_name(options.complex_arithmetic))
        typed_dump_append_fp_option(out, sview("eval_method", 0, -1), clang_fp_eval_setting_name(options.eval_method))
        typed_dump_append_fp_option(out, sview("excess_precision", 0, -1), clang_fp_excess_precision_setting_name(options.excess_precision))
        typed_dump_append_fp_option(out, sview("driver_link_effect", 0, -1), clang_fp_driver_link_effect_name(options.driver_link_effect))
        typed_dump_append_fp_option(out, sview("unknown_option_seen", 0, -1), "true" if options.unknown_option_seen else "false")

    def typed_dump_diagnostic(out: mutable darray[u8]&, index: i64, diagnostic: TypedDiagnostic) -> void:
        typed_dump_append_view(out, sview("diagnostic ", 0, -1))
        typed_dump_append_i64(out, index)
        typed_dump_append_view(out, sview(" category_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.category)
        typed_dump_append_view(out, sview(" kind_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.kind)
        typed_dump_append_view(out, sview(" subject_type_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.subject_type)
        typed_dump_append_view(out, sview(" required_capability_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.required_capability)
        typed_dump_append_view(out, sview(" translation_unit_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.translation_unit)
        typed_dump_append_content_hash(out, sview("translation_unit_content_hash", 0, -1), diagnostic.translation_unit_content_hash)
        typed_dump_append_view(out, sview(" range_start_offset=", 0, -1))
        typed_dump_append_i64(out, diagnostic.range_start_offset)
        typed_dump_append_view(out, sview(" range_end_offset=", 0, -1))
        typed_dump_append_i64(out, diagnostic.range_end_offset)
        typed_dump_append_view(out, sview(" source_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.source)
        typed_dump_append_view(out, sview(" physical_source_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.canonical_source)
        typed_dump_append_content_hash(out, sview("source_content_hash", 0, -1), diagnostic.source_content_hash)
        typed_dump_append_view(out, sview(" spelling_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.spelling_source)
        typed_dump_append_view(out, sview(" spelling_physical_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.spelling_canonical_source)
        typed_dump_append_content_hash(out, sview("spelling_source_content_hash", 0, -1), diagnostic.spelling_source_content_hash)
        typed_dump_append_view(out, sview(" spelling_included_from_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.spelling_included_from)
        typed_dump_append_view(out, sview(" spelling_included_from_physical_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.spelling_included_from_canonical)
        typed_dump_append_content_hash(out, sview("spelling_included_from_content_hash", 0, -1), diagnostic.spelling_included_from_content_hash)
        typed_dump_append_view(out, sview(" expansion_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.expansion_source)
        typed_dump_append_view(out, sview(" expansion_physical_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.expansion_canonical_source)
        typed_dump_append_content_hash(out, sview("expansion_source_content_hash", 0, -1), diagnostic.expansion_source_content_hash)
        typed_dump_append_view(out, sview(" expansion_included_from_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.expansion_included_from)
        typed_dump_append_view(out, sview(" expansion_included_from_physical_hex=", 0, -1))
        typed_dump_append_hex(out, diagnostic.expansion_included_from_canonical)
        typed_dump_append_content_hash(out, sview("expansion_included_from_content_hash", 0, -1), diagnostic.expansion_included_from_content_hash)
        typed_dump_append_view(out, sview(" location=", 0, -1))
        typed_dump_append_i64(out, diagnostic.line)
        typed_dump_append_view(out, sview(":", 0, -1))
        typed_dump_append_i64(out, diagnostic.column)
        typed_dump_append_view(out, sview(" spelling_location=", 0, -1))
        typed_dump_append_i64(out, diagnostic.spelling_line)
        typed_dump_append_view(out, sview(":", 0, -1))
        typed_dump_append_i64(out, diagnostic.spelling_column)
        typed_dump_append_view(out, sview(" expansion_location=", 0, -1))
        typed_dump_append_i64(out, diagnostic.expansion_line)
        typed_dump_append_view(out, sview(":", 0, -1))
        typed_dump_append_i64(out, diagnostic.expansion_column)
        typed_dump_append_view(out, sview("\n", 0, -1))

    # Stable, line-oriented diagnostic format. Textual fields are hex encoded,
    # so arbitrary source names/operators cannot inject new records or depend on
    # terminal escaping. The version tag is intentionally independent of Elisa
    # source formatting and can be consumed by regression tooling.
    def typed_dump_ir[@r](ctx: TypedContext[r]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
        out: mutable darray[u8] = []
        typed_dump_append_view(&out, sview("typed-ir-v16\nsource_hex=", 0, -1))
        typed_dump_append_hex(&out, sview(ctx.source, 0, -1))
        typed_dump_append_view(&out, sview("\n", 0, -1))
        typed_dump_append_view(&out, sview("floating_point_mode=", 0, -1))
        typed_dump_append_view(&out, clang_fp_mode_name(ctx.floating_point_options.mode))
        typed_dump_append_view(&out, sview("\n", 0, -1))
        typed_dump_append_fp_options(&out, ctx.floating_point_options)
        typed_dump_append_view(&out, sview("counts exprs=", 0, -1))
        typed_dump_append_i64(&out, ctx.exprs.count.i64())
        typed_dump_append_view(&out, sview(" expr_children=", 0, -1))
        typed_dump_append_i64(&out, ctx.expr_children.count.i64())
        typed_dump_append_view(&out, sview(" stmts=", 0, -1))
        typed_dump_append_i64(&out, ctx.stmts.count.i64())
        typed_dump_append_view(&out, sview(" stmt_children=", 0, -1))
        typed_dump_append_i64(&out, ctx.stmt_children.count.i64())
        typed_dump_append_view(&out, sview(" functions=", 0, -1))
        typed_dump_append_i64(&out, ctx.functions.count.i64())
        typed_dump_append_view(&out, sview(" params=", 0, -1))
        typed_dump_append_i64(&out, ctx.params.count.i64())
        typed_dump_append_view(&out, sview(" externs=", 0, -1))
        typed_dump_append_i64(&out, ctx.externs.count.i64())
        typed_dump_append_view(&out, sview(" extern_params=", 0, -1))
        typed_dump_append_i64(&out, ctx.extern_params.count.i64())
        typed_dump_append_view(&out, sview(" extern_globals=", 0, -1))
        typed_dump_append_i64(&out, ctx.extern_globals.count.i64())
        typed_dump_append_view(&out, sview(" records=", 0, -1))
        typed_dump_append_i64(&out, ctx.records.count.i64())
        typed_dump_append_view(&out, sview(" record_layouts=", 0, -1))
        typed_dump_append_i64(&out, ctx.record_layouts.count.i64())
        typed_dump_append_view(&out, sview(" fields=", 0, -1))
        typed_dump_append_i64(&out, ctx.fields.count.i64())
        typed_dump_append_view(&out, sview(" globals=", 0, -1))
        typed_dump_append_i64(&out, ctx.globals.count.i64())
        typed_dump_append_view(&out, sview(" enums=", 0, -1))
        typed_dump_append_i64(&out, ctx.enums.count.i64())
        typed_dump_append_view(&out, sview(" enum_consts=", 0, -1))
        typed_dump_append_i64(&out, ctx.enum_consts.count.i64())
        typed_dump_append_view(&out, sview(" type_aliases=", 0, -1))
        typed_dump_append_i64(&out, ctx.type_aliases.count.i64())
        typed_dump_append_view(&out, sview(" signatures=", 0, -1))
        typed_dump_append_i64(&out, ctx.user_function_signatures.count.i64())
        typed_dump_append_view(&out, sview(" decl_infos=", 0, -1))
        typed_dump_append_i64(&out, ctx.decl_infos.count.i64())
        typed_dump_append_view(&out, sview(" labels=", 0, -1))
        typed_dump_append_i64(&out, ctx.labels.count.i64())
        typed_dump_append_view(&out, sview(" switch_cases=", 0, -1))
        typed_dump_append_i64(&out, ctx.switch_cases.count.i64())
        typed_dump_append_view(&out, sview(" mode=", 0, -1))
        typed_dump_append_i64(&out, ctx.mode.i8().i64())
        typed_dump_append_view(&out, sview(" project_mode=", 0, -1))
        typed_dump_append_bool(&out, ctx.project_mode)
        typed_dump_append_view(&out, sview(" cpp_unordered_map=", 0, -1))
        typed_dump_append_bool(&out, ctx.needs_cpp_unordered_map)
        typed_dump_append_view(&out, sview("\n", 0, -1))

        for index in 0..<ctx.diagnostics.count.i64() |ctx, out|:
            typed_dump_diagnostic(&out, index, ctx.diagnostics[index.usize()])

        for index in 0..<ctx.exprs.count.i64() |ctx, out|:
            expression: TypedExpr[r] = ctx.exprs[index.usize()]
            typed_dump_append_view(&out, sview("expr ", 0, -1))
            typed_dump_append_i64(&out, index)
            typed_dump_append_view(&out, sview(" kind=", 0, -1))
            typed_dump_append_view(&out, typed_dump_expr_kind(expression.kind))
            typed_dump_append_view(&out, sview(" lhs=", 0, -1))
            typed_dump_append_i64(&out, expression.lhs)
            typed_dump_append_view(&out, sview(" rhs=", 0, -1))
            typed_dump_append_i64(&out, expression.rhs)
            typed_dump_append_view(&out, sview(" third=", 0, -1))
            typed_dump_append_i64(&out, expression.third)
            typed_dump_append_view(&out, sview(" args_start=", 0, -1))
            typed_dump_append_i64(&out, expression.args_start)
            typed_dump_append_view(&out, sview(" args_count=", 0, -1))
            typed_dump_append_i64(&out, expression.args_count)
            typed_dump_append_view(&out, sview(" value=", 0, -1))
            typed_dump_append_i64(&out, expression.value)
            typed_dump_append_view(&out, sview(" type_hex=", 0, -1))
            typed_dump_append_hex(&out, expression.type_name)
            typed_dump_append_view(&out, sview(" text_hex=", 0, -1))
            typed_dump_append_hex(&out, expression.text)
            typed_dump_append_view(&out, sview("\n", 0, -1))

        for index in 0..<ctx.expr_children.count.i64() |ctx, out|:
            typed_dump_append_view(&out, sview("expr-child ", 0, -1))
            typed_dump_append_i64(&out, index)
            typed_dump_append_view(&out, sview(" value=", 0, -1))
            typed_dump_append_i64(&out, ctx.expr_children[index.usize()])
            typed_dump_append_view(&out, sview("\n", 0, -1))

        for index in 0..<ctx.stmts.count.i64() |ctx, out|:
            statement: TypedStmt[r] = ctx.stmts[index.usize()]
            typed_dump_append_view(&out, sview("stmt ", 0, -1))
            typed_dump_append_i64(&out, index)
            typed_dump_append_view(&out, sview(" kind=", 0, -1))
            typed_dump_append_view(&out, typed_dump_stmt_kind(statement.kind))
            typed_dump_append_view(&out, sview(" expr=", 0, -1))
            typed_dump_append_i64(&out, statement.expr)
            typed_dump_append_view(&out, sview(" aux=", 0, -1))
            typed_dump_append_i64(&out, statement.aux)
            typed_dump_append_view(&out, sview(" aux2=", 0, -1))
            typed_dump_append_i64(&out, statement.aux2)
            typed_dump_append_view(&out, sview(" children_start=", 0, -1))
            typed_dump_append_i64(&out, statement.children_start)
            typed_dump_append_view(&out, sview(" children_count=", 0, -1))
            typed_dump_append_i64(&out, statement.children_count)
            typed_dump_append_view(&out, sview(" name_hex=", 0, -1))
            typed_dump_append_hex(&out, statement.name)
            typed_dump_append_view(&out, sview(" type_hex=", 0, -1))
            typed_dump_append_hex(&out, statement.type_name)
            typed_dump_append_view(&out, sview("\n", 0, -1))

        for index in 0..<ctx.stmt_children.count.i64() |ctx, out|:
            typed_dump_append_view(&out, sview("stmt-child ", 0, -1))
            typed_dump_append_i64(&out, index)
            typed_dump_append_view(&out, sview(" value=", 0, -1))
            typed_dump_append_i64(&out, ctx.stmt_children[index.usize()])
            typed_dump_append_view(&out, sview("\n", 0, -1))

        for index in 0..<ctx.functions.count.i64() |ctx, out|:
            function: TypedFunction[r] = ctx.functions[index.usize()]
            typed_dump_append_view(&out, sview("function ", 0, -1))
            typed_dump_append_i64(&out, index)
            typed_dump_append_view(&out, sview(" params_start=", 0, -1))
            typed_dump_append_i64(&out, function.params_start)
            typed_dump_append_view(&out, sview(" params_count=", 0, -1))
            typed_dump_append_i64(&out, function.params_count)
            typed_dump_append_view(&out, sview(" declaration_identity=", 0, -1))
            typed_dump_append_bool(&out, function.declaration_id.len > 0)
            typed_dump_append_view(&out, sview(" body=", 0, -1))
            typed_dump_append_i64(&out, function.body)
            typed_dump_append_view(&out, sview(" labels=", 0, -1))
            typed_dump_append_i64(&out, function.label_count)
            typed_dump_append_view(&out, sview(" variadic=", 0, -1))
            typed_dump_append_bool(&out, function.variadic)
            typed_dump_append_view(&out, sview(" internal_linkage=", 0, -1))
            typed_dump_append_bool(&out, function.internal_linkage)
            typed_dump_append_view(&out, sview(" global_effect=", 0, -1))
            typed_dump_append_bool(&out, function.has_global_effect)
            typed_dump_append_view(&out, sview(" unsafe_effect=", 0, -1))
            typed_dump_append_bool(&out, function.has_unsafe_effect)
            typed_dump_append_view(&out, sview(" name_hex=", 0, -1))
            typed_dump_append_hex(&out, function.name)
            typed_dump_append_view(&out, sview(" link_name_hex=", 0, -1))
            typed_dump_append_hex(&out, function.link_name)
            typed_dump_append_view(&out, sview(" return_type_hex=", 0, -1))
            typed_dump_append_hex(&out, function.return_type)
            typed_dump_append_view(&out, sview("\n", 0, -1))

        for index in 0..<ctx.params.count.i64() |ctx, out|:
