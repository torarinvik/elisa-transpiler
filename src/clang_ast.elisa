module CTranslator:
    @link_name("popen")
    extern popen(command: cstr, mode: cstr) -> mutable heap void&?
    @link_name("pclose")
    extern pclose(stream: void&) -> int
    @link_name("fread")
    extern fread(buffer: mutable void&, size: usize, count: usize, stream: void&) -> usize

    def append_cstr(out: mutable darray[u8]&, value: cstr) -> void:
        index: mutable usize = 0.usize()
        while true |out, index, value|:
            byte: u8 = string_index(value, index.i64()).u8()
            break if byte == 0
            out.push(byte)
            index <- index + 1.usize()

    def append_literal(out: mutable darray[u8]&, value: sview) -> void:
        for index in 0..<value.len |out, value|:
            out.push(string_view_index(value, index).u8())

    # Quote one path for the shell command passed to popen. Single-quoted shell
    # strings are literal; an embedded quote is represented as '\''.
    def append_shell_quoted(out: mutable darray[u8]&, value: cstr) -> void:
        out.push(39)
        index: mutable usize = 0.usize()
        while true |out, index, value|:
            byte: u8 = string_index(value, index.i64()).u8()
            break if byte == 0
            if byte == 39:
                out.push(39)
                out.push(92)
                out.push(39)
                out.push(39)
            else:
                out.push(byte)
            index <- index + 1.usize()
        out.push(39)

    def run_clang_ast(path: cstr) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
        command: mutable darray[u8] = []
        append_literal(&command, "clang -std=c11 -D_DEFAULT_SOURCE -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -Wno-everything -Xclang -ast-dump=json -fsyntax-only ")
        append_shell_quoted(&command, path)
        command.push(0)

        stream: mutable heap void&? = popen((&command[0]).cast[cstr], "r")
        if stream == null:
            return []
        handle: mutable heap void& = stream
        ast: mutable darray[u8] = []
        chunk: mutable u8[8192] = zeroed
        while true |ast, chunk, handle|:
            count: usize = fread((&chunk[0]).cast[mutable void&], 1.usize(), 8192.usize(), handle)
            break if count == 0.usize()
            for index in 0..<count |ast, chunk|:
                ast.push(chunk[index])
        _ = pclose(handle)
        return ast

    def ast_field(node: JsonValue, key: sview) -> JsonValue:
        match node:
            JsonValue.Object(members_bits, count):
                for index in 0..<count:
                    member: JsonMember = json_member_copy(members_bits, index)
                    return member.value if sview_eq(json_member_key_view(member), key)
            _:
                pass
        return JsonValue.Null

    def ast_array_item(value: JsonValue, index: i64) -> JsonValue:
        match value:
            JsonValue.Array(items_bits, count):
                return json_value_copy(items_bits, index) if index >= 0 and index < count
            _:
                pass
        return JsonValue.Null

    def ast_string(value: JsonValue) -> sview:
        trusted Unsafe.PointerCast:
            match value:
                JsonValue.String(data_bits, length):
                    return StringView{data: data_bits.cast[u8&], len: length}
                _:
                    return sview("", 0, 0)

    def ast_kind(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("kind", 0, -1)))

    def ast_name(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("name", 0, -1)))

    def ast_qual_type(node: JsonValue) -> sview:
        type_node: JsonValue = ast_field(node, sview("type", 0, -1))
        return ast_string(ast_field(type_node, sview("qualType", 0, -1)))

    def ast_abi_qual_type(node: JsonValue) -> sview:
        # Clang keeps typedef spelling in qualType, while desugaredQualType
        # carries the ABI shape needed for pointer and function-pointer lowering.
        type_node: JsonValue = ast_field(node, sview("type", 0, -1))
        desugared: sview = ast_string(ast_field(type_node, sview("desugaredQualType", 0, -1)))
        return desugared if desugared.len > 0 else ast_qual_type(node)

    def ast_children(node: JsonValue) -> JsonValue:
        return ast_field(node, sview("inner", 0, -1))

    def ast_child_count(node: JsonValue) -> i64:
        return json_array_len(ast_children(node))

    def ast_child(node: JsonValue, index: i64) -> JsonValue:
        return ast_array_item(ast_children(node), index)

    def ast_find_child(node: JsonValue, wanted: sview) -> JsonValue:
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                child: JsonValue = ast_child(node, index)
                return child if sview_eq(ast_kind(child), wanted)
        return JsonValue.Null

    def ast_has_child(node: JsonValue, wanted: sview) -> bool:
        return ast_find_child(node, wanted) != JsonValue.Null

    def ast_location_file(node: JsonValue) -> sview:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        direct: sview = ast_string(ast_field(location, sview("file", 0, -1)))
        return direct if direct.len > 0
        spelling: sview = ast_string(ast_field(ast_field(location, sview("spellingLoc", 0, -1)), sview("file", 0, -1)))
        return spelling if spelling.len > 0
        return ast_string(ast_field(ast_field(location, sview("expansionLoc", 0, -1)), sview("file", 0, -1)))

    def ast_included_from_file(node: JsonValue) -> sview:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        included_from: JsonValue = ast_field(location, sview("includedFrom", 0, -1))
        direct: mutable sview = ast_string(ast_field(included_from, sview("file", 0, -1)))
        return direct if direct.len > 0
        spelling: JsonValue = ast_field(location, sview("spellingLoc", 0, -1))
        direct <- ast_string(ast_field(ast_field(spelling, sview("includedFrom", 0, -1)), sview("file", 0, -1)))
        return direct if direct.len > 0
        expansion: JsonValue = ast_field(location, sview("expansionLoc", 0, -1))
        return ast_string(ast_field(ast_field(expansion, sview("includedFrom", 0, -1)), sview("file", 0, -1)))

    def ast_location_has_origin(node: JsonValue) -> bool:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        return ast_field(location, sview("spellingLoc", 0, -1)) != JsonValue.Null or ast_field(location, sview("expansionLoc", 0, -1)) != JsonValue.Null

    def ast_is_user_declaration(node: JsonValue, source: cstr) -> bool:
        file: sview = ast_location_file(node)
        included_from: sview = ast_included_from_file(node)
        source_view: sview = sview(source, 0, -1)
        # Clang omits `file` for declarations in the main source file in some AST
        # nodes. An omitted file plus an omitted include origin is still ours.
        return sview_eq(file, source_view) or (file.len == 0 and included_from.len == 0 and not ast_location_has_origin(node))

    def safe_identifier(name: sview) -> sview:
        # Elisa reserves a few ordinary C identifiers. Prefixing only collisions
        # keeps the generated source close to the original C.
        if sview_eq(name, sview("error", 0, -1)):
            return sview("c_error", 0, -1)
        if sview_eq(name, sview("match", 0, -1)):
            return sview("c_match", 0, -1)
        if sview_eq(name, sview("pass", 0, -1)):
            return sview("c_pass", 0, -1)
        if sview_eq(name, sview("return", 0, -1)):
            return sview("c_return", 0, -1)
        if sview_eq(name, sview("new", 0, -1)):
            return sview("c_new", 0, -1)
        return name

    def ast_expr_name(node: JsonValue) -> sview:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("DeclRefExpr", 0, -1)):
            referenced: JsonValue = ast_field(node, sview("referencedDecl", 0, -1))
            name: mutable sview = ast_name(referenced)
            name <- ast_name(node) if name.len == 0
            return name
        if sview_eq(kind, sview("ImplicitCastExpr", 0, -1)) or sview_eq(kind, sview("ParenExpr", 0, -1)) or sview_eq(kind, sview("CStyleCastExpr", 0, -1)) or sview_eq(kind, sview("ConstantExpr", 0, -1)):
            return ast_expr_name(ast_child(node, 0))
        return sview("", 0, 0)

    def ast_unwrapped_type(node: JsonValue) -> sview:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("ImplicitCastExpr", 0, -1)) or sview_eq(kind, sview("ParenExpr", 0, -1)) or sview_eq(kind, sview("ConstantExpr", 0, -1)):
            return ast_unwrapped_type(ast_child(node, 0))
        return ast_qual_type(node)

    def ast_is_empty(node: JsonValue) -> bool:
        return ast_kind(node).len == 0

    def ast_cast_kind(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("castKind", 0, -1)))

    def ast_target_label_id(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("targetLabelDeclId", 0, -1)))

    def ast_enum_value(node: JsonValue, fallback: i64) -> i64:
        count: i64 = ast_child_count(node)
        if count > 0:
            child: JsonValue = ast_child(node, 0)
            value: JsonValue = ast_field(child, sview("value", 0, -1))
            value_text: sview = ast_string(value)
            if value_text.len > 0:
                # Clang gives enum values as decimal strings. The source corpus uses
                # only ordinary integer constants, so the small parser below is enough
                # and avoids re-parsing the C spelling.
                result: mutable i64 = 0
                sign: mutable i64 = 1
                start: mutable i64 = 0
                if string_view_index(value_text, 0) == 45:
                    sign <- -1
                    start <- 1
                for index in start..<value_text.len |result, value_text|:
                    digit: i64 = string_view_index(value_text, index) - 48
                    result <- result * 10 + digit if digit >= 0 and digit <= 9
                return result * sign
        return fallback

    # -----------------------------------------------------------------------------
    # Typed lowering IR
    # -----------------------------------------------------------------------------
    #
    # The Clang JSON tree is intentionally not emitted directly. Lowering first
    # produces these flat, index-based nodes. Indexes keep the IR non-recursive,
    # which fits Elisa's value model while still allowing arbitrarily nested C
    # expressions and statements.

    const enum TypedExprKind of i8:
        Invalid
        Integer
        Floating
        String
        Character
        Name
        Binary
        Unary
        ArrayIndex
        Conditional
        Member
        Call
        Sizeof
        Cast
        Aggregate
        Null

    const enum TypedStmtKind of i8:
        Invalid
        Block
        Return
        Declaration
        If
        Expression
        For
        While
        DoWhile
        Break
        Continue
        Null

    struct TypedExpr:
        kind: TypedExprKind
        text: sview
        type_name: sview
        lhs: i64
        rhs: i64
        third: i64
        args_start: i64
        args_count: i64
        value: i64

    struct TypedStmt:
        kind: TypedStmtKind
        expr: i64
        aux: i64
        aux2: i64
        children_start: i64
        children_count: i64
        name: sview
        type_name: sview

    struct TypedParam:
        name: sview
        type_name: sview
        is_mutable: bool

    struct TypedField:
        name: sview
        type_name: sview

    struct TypedRecord:
        name: sview
        fields_start: i64
        fields_count: i64

    struct TypedEnumConst:
        name: sview
        enum_name: sview
        value: i64

    struct TypedEnum:
        name: sview
        underlying_type: sview

    struct TypedExtern:
        name: sview
        return_type: sview
        params_start: i64
        params_count: i64
        variadic: bool

    struct TypedExternGlobal:
        name: sview
        type_name: sview

    struct TypedLabel:
        id: sview
        node: JsonValue

    struct TypedGlobal:
        name: sview
        type_name: sview
        initializer: i64

    struct TypedFunction:
        name: sview
        return_type: sview
        params_start: i64
        params_count: i64
        body: i64
        variadic: bool
        has_global_effect: bool
        has_unsafe_effect: bool

    struct TypedDiagnostic:
        category: sview
        kind: sview
        line: i64
        column: i64

    struct TypedContext:
        exprs: mutable darray[TypedExpr]
        expr_children: mutable darray[i64]
        stmts: mutable darray[TypedStmt]
        stmt_children: mutable darray[i64]
        params: mutable darray[TypedParam]
        extern_params: mutable darray[TypedParam]
        globals: mutable darray[TypedGlobal]
        functions: mutable darray[TypedFunction]
        user_function_names: mutable darray[sview]
        externs: mutable darray[TypedExtern]
        extern_globals: mutable darray[TypedExternGlobal]
        fields: mutable darray[TypedField]
        records: mutable darray[TypedRecord]
        enums: mutable darray[TypedEnum]
        enum_consts: mutable darray[TypedEnumConst]
        labels: mutable darray[TypedLabel]
        switch_depth: mutable i64
        current_for_increment: mutable i64
        current_return_type: mutable sview
        source: cstr
        root: mutable JsonValue
        diagnostics: mutable darray[TypedDiagnostic]

    struct TypedTranslation:
        output: darray[u8]
        diagnostics: darray[TypedDiagnostic]
        failed: bool

    def typed_number(value: JsonValue) -> i64:
        match value:
            JsonValue.Number(number):
                return number.i64()
            _:
                return 0

    def ast_bool(value: JsonValue) -> bool:
        match value:
            JsonValue.Bool(result):
                return result
            _:
                return false

    def ast_location_line(node: JsonValue) -> i64:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        line: i64 = typed_number(ast_field(location, sview("line", 0, -1)))
        return line if line > 0
        range: JsonValue = ast_field(node, sview("range", 0, -1))
        begin: JsonValue = ast_field(range, sview("begin", 0, -1))
        return typed_number(ast_field(begin, sview("line", 0, -1)))

    def ast_location_column(node: JsonValue) -> i64:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        column: i64 = typed_number(ast_field(location, sview("col", 0, -1)))
        return column if column > 0
        range: JsonValue = ast_field(node, sview("range", 0, -1))
        begin: JsonValue = ast_field(range, sview("begin", 0, -1))
        return typed_number(ast_field(begin, sview("col", 0, -1)))

    def typed_record_unsupported(ctx: mutable TypedContext&, node: JsonValue, category: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        ctx.diagnostics.push(TypedDiagnostic{category: category, kind: ast_kind(node), line: ast_location_line(node), column: ast_location_column(node)})

    def typed_push_expr(ctx: mutable TypedContext&, value: TypedExpr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        ctx.exprs.push(value)
        return ctx.exprs.count.i64() - 1

    def typed_push_stmt(ctx: mutable TypedContext&, value: TypedStmt) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        ctx.stmts.push(value)
        return ctx.stmts.count.i64() - 1

    def typed_push_function(ctx: mutable TypedContext&, value: TypedFunction) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        ctx.functions.push(value)
        return ctx.functions.count.i64() - 1

    def typed_global_index(ctx: TypedContext&, name: sview) -> i64:
        for index in 0..<ctx.globals.count |ctx, name|:
            if sview_eq(ctx.globals[index].name, name):
                return index
        return -1

    def typed_user_function_index(ctx: TypedContext&, name: sview) -> i64:
        for index in 0..<ctx.user_function_names.count |ctx, name|:
            if sview_eq(ctx.user_function_names[index], name):
                return index
        return -1

    def typed_enum_const_name(ctx: TypedContext&, name: sview) -> sview:
        for index in 0..<ctx.enum_consts.count |ctx, name|:
            constant: TypedEnumConst = ctx.enum_consts[index]
            if sview_eq(constant.name, name):
                return safe_identifier(constant.enum_name)
        return sview("", 0, 0)

    def typed_enum_const_value(ctx: TypedContext&, name: sview) -> i64:
        for index in 0..<ctx.enum_consts.count |ctx, name|:
            constant: TypedEnumConst = ctx.enum_consts[index]
            if sview_eq(constant.name, name):
                return constant.value
        return -1

    def external_parameter_name(ordinal: i64) -> sview:
        return sview("arg0", 0, -1) if ordinal == 0
        return sview("arg1", 0, -1) if ordinal == 1
        return sview("arg2", 0, -1) if ordinal == 2
        return sview("arg3", 0, -1) if ordinal == 3
        return sview("arg4", 0, -1) if ordinal == 4
        return sview("arg5", 0, -1) if ordinal == 5
        return sview("arg6", 0, -1) if ordinal == 6
        return sview("arg7", 0, -1) if ordinal == 7
        return sview("arg8", 0, -1) if ordinal == 8
        return sview("arg9", 0, -1) if ordinal == 9
        return sview("arg", 0, -1)

    def typed_binary_assignment_opcode(opcode: sview) -> sview:
        return sview("+", 0, -1) if sview_eq(opcode, sview("+=", 0, -1))
        return sview("-", 0, -1) if sview_eq(opcode, sview("-=", 0, -1))
        return sview("*", 0, -1) if sview_eq(opcode, sview("*=", 0, -1))
        return sview("/", 0, -1) if sview_eq(opcode, sview("/=", 0, -1))
        return sview("%", 0, -1) if sview_eq(opcode, sview("%=", 0, -1))
        return sview("&", 0, -1) if sview_eq(opcode, sview("&=", 0, -1))
        return sview("|", 0, -1) if sview_eq(opcode, sview("|=", 0, -1))
        return sview("^", 0, -1) if sview_eq(opcode, sview("^=", 0, -1))
        return sview("<<", 0, -1) if sview_eq(opcode, sview("<<=", 0, -1))
        return sview(">>", 0, -1) if sview_eq(opcode, sview(">>=", 0, -1))
        return sview("", 0, 0)

    def typed_surface_opcode(opcode: sview) -> sview:
        return sview("and", 0, -1) if sview_eq(opcode, sview("&&", 0, -1))
        return sview("or", 0, -1) if sview_eq(opcode, sview("||", 0, -1))
        return opcode

    def typed_callee_name(node: JsonValue) -> sview:
        return ast_expr_name(node)

    def ast_find_function(node: JsonValue, wanted: sview) -> JsonValue:
        if sview_eq(ast_kind(node), sview("FunctionDecl", 0, -1)) and sview_eq(ast_name(node), wanted):
            return node
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                found: JsonValue = ast_find_function(ast_child(node, index), wanted)
                return found if found != JsonValue.Null
        return JsonValue.Null

    def typed_external_index(ctx: TypedContext&, name: sview) -> i64:
        for index in 0..<ctx.externs.count |ctx, name|:
            if sview_eq(ctx.externs[index].name, name):
                return index
        return -1

    def typed_external_global_index(ctx: TypedContext&, name: sview) -> i64:
        for index in 0..<ctx.extern_globals.count |ctx, name|:
            if sview_eq(ctx.extern_globals[index].name, name):
                return index
        return -1

    def typed_emit_external_alias(out: mutable darray[u8]&, prefix: sview, index: i64) -> void:
        append_view(out, prefix)
        append_i64(out, index)

    def typed_add_external_global(ctx: mutable TypedContext&, name: sview, type_name: sview) -> void:
        return if name.len == 0 or typed_external_global_index(ctx, name) >= 0
        ctx.extern_globals.push(TypedExternGlobal{name: safe_identifier(name), type_name: type_name})

    def typed_add_external(ctx: mutable TypedContext&, name: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if name.len == 0 or typed_user_function_index(ctx, name) >= 0 or typed_external_index(ctx, name) >= 0
        return if sview_starts_with(name, sview("__builtin_va_", 0, -1))
        declaration: JsonValue = ast_find_function(ctx.root, name)
        function_type: mutable sview = ast_qual_type(declaration)
        if function_type.len == 0:
            function_type <- sview("int (...) ", 0, -1)
        params_start: i64 = ctx.extern_params.count.i64()
        parameter_count: i64 = ast_child_count(declaration)
        if declaration != JsonValue.Null and parameter_count >= 0:
            ordinal: mutable i64 = 0
            for index in 0..<parameter_count |ctx, declaration, params_start, ordinal|:
                parameter: JsonValue = ast_child(declaration, index)
                if sview_eq(ast_kind(parameter), sview("ParmVarDecl", 0, -1)):
                    parameter_name: mutable sview = safe_identifier(ast_name(parameter))
                    if parameter_name.len == 0:
                        parameter_name <- external_parameter_name(ordinal)
                    if ast_name(parameter).len == 0 or sview_eq(parameter_name, sview("arg", 0, -1)):
                        # Clang may use the same synthetic spelling for several
                        # unnamed parameters. The ordinal keeps emitted names unique.
                        parameter_name <- external_parameter_name(ordinal)
                    spelled_parameter_type: sview = ast_qual_type(parameter)
                    parameter_type: sview = spelled_parameter_type if sview_eq(spelled_parameter_type, sview("va_list", 0, -1)) or sview_eq(spelled_parameter_type, sview("__builtin_va_list", 0, -1)) else ast_abi_qual_type(parameter)
                    is_va_list: bool = sview_eq(parameter_type, sview("va_list", 0, -1)) or sview_eq(parameter_type, sview("__builtin_va_list", 0, -1))
                    ctx.extern_params.push(TypedParam{name: parameter_name, type_name: parameter_type, is_mutable: not is_va_list and not c_type_is_const_pointer(parameter_type)})
                    ordinal <- ordinal + 1
        variadic: bool = sview_find_byte(function_type, 46) >= 0
        ctx.externs.push(TypedExtern{name: safe_identifier(name), return_type: function_type, params_start: params_start, params_count: ctx.extern_params.count.i64() - params_start, variadic: variadic})
