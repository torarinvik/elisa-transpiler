module CTranslator:
    @link_name("popen")
    extern popen(command: cstr, mode: cstr) -> mutable heap void&?
    @link_name("pclose")
    extern pclose(stream: void&) -> int
    @link_name("fread")
    extern fread(buffer: mutable void&, size: usize, count: usize, stream: void&) -> usize
    @link_name("fopen")
    extern c_fopen(path: cstr, mode: cstr) -> mutable heap void&?
    @link_name("fwrite")
    extern c_fwrite(buffer: void&, size: usize, count: usize, stream: void&) -> usize
    @link_name("fclose")
    extern c_fclose(stream: void&) -> int

    def append_cstr(out: mutable darray[u8]&, value: cstr) -> void:
        index: mutable usize = 0.usize()
        while true |out, index, value|:
            byte: u8 = string_index(value, index.i64()).u8()
            break if byte == 0
            out.push(byte)
            index <- index + 1.usize()

    def append_literal(out: mutable darray[u8]&, value: sview) -> void:
        for index in 0..<value.len |out, value|:
            out.push(string_view_index(value, index).u8())

    # Quote one path for the shell command passed to popen. Single-quoted shell
    # strings are literal; an embedded quote is represented as '\''.
    def append_shell_quoted_view(out: mutable darray[u8]&, value: sview) -> void:
        out.push(39)
        index: mutable usize = 0.usize()
        while index < value.len.usize() |out, index, value|:
            byte: u8 = string_view_index(value, index.i64()).u8()
            if byte == 39:
                out.push(39)
                out.push(92)
                out.push(39)
                out.push(39)
            else:
                out.push(byte)
            index <- index + 1.usize()
        out.push(39)

    def append_shell_quoted(out: mutable darray[u8]&, value: cstr) -> void:
        append_shell_quoted_view(out, sview(value, 0, -1))

    def run_command_output(command: cstr) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
        stream: mutable heap void&? = popen(command, "r")
        if stream == null:
            return []
        handle: mutable heap void& = stream
        output: mutable darray[u8] = []
        chunk: mutable u8[8192] = zeroed
        while true |output, chunk, handle|:
            count: usize = fread((&chunk[0]).cast[mutable void&], 1.usize(), 8192.usize(), handle)
            break if count == 0.usize()
            for index in 0..<count |output, chunk|:
                output.push(chunk[index])
        _ = pclose(handle)
        return output

    def run_clang_ast(path: cstr) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
        command: mutable darray[u8] = []
        append_literal(&command, "clang -std=c11 -D_DEFAULT_SOURCE -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -Wno-everything -Xclang -fparse-all-comments -Xclang -ast-dump=json -fsyntax-only ")
        append_shell_quoted(&command, path)
        command.push(0)
        stream: mutable heap void&? = popen((&command[0]).cast[cstr], "r")
        if stream == null:
            return []
        handle: mutable heap void& = stream
        ast: mutable darray[u8] = []
        chunk: mutable u8[8192] = zeroed
        while true |ast, chunk, handle|:
            count: usize = fread((&chunk[0]).cast[mutable void&], 1.usize(), 8192.usize(), handle)
            break if count == 0.usize()
            for index in 0..<count |ast, chunk|:
                ast.push(chunk[index])
        _ = pclose(handle)
        return ast

    def run_clang_ast_command(directory: sview, compile_command: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
        command: mutable darray[u8] = []
        if directory.len > 0:
            append_literal(&command, "cd ")
            append_shell_quoted_view(&command, directory)
            append_literal(&command, " && ")
        append_view(&command, compile_command)
        append_literal(&command, " -Wno-unused-command-line-argument -Xclang -fparse-all-comments -Xclang -ast-dump=json -fsyntax-only")
        command.push(0)
        return run_command_output((&command[0]).cast[cstr])

    def ast_field(node: JsonValue, key: sview) -> JsonValue:
        match node:
            JsonValue.Object(members_bits, count):
                for index in 0..<count:
                    member: JsonMember = json_member_copy(members_bits, index)
                    return member.value if sview_eq(json_member_key_view(member), key)
            _:
                pass
        return JsonValue.Null

    def ast_array_item(value: JsonValue, index: i64) -> JsonValue:
        match value:
            JsonValue.Array(items_bits, count):
                return json_value_copy(items_bits, index) if index >= 0 and index < count
            _:
                pass
        return JsonValue.Null

    def ast_string(value: JsonValue) -> sview:
        trusted Unsafe.PointerCast:
            match value:
                JsonValue.String(data_bits, length):
                    return StringView{data: data_bits.cast[u8&], len: length}
                _:
                    return sview("", 0, 0)

    def ast_kind(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("kind", 0, -1)))

    def ast_name(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("name", 0, -1)))

    def ast_qual_type(node: JsonValue) -> sview:
        type_node: JsonValue = ast_field(node, sview("type", 0, -1))
        return ast_string(ast_field(type_node, sview("qualType", 0, -1)))

    def ast_type_object_c_type(type_node: JsonValue) -> sview:
        spelled: sview = ast_string(ast_field(type_node, sview("qualType", 0, -1)))
        desugared: sview = ast_string(ast_field(type_node, sview("desugaredQualType", 0, -1)))
        return spelled if sview_eq(spelled, sview("va_list", 0, -1)) or sview_eq(spelled, sview("__builtin_va_list", 0, -1)) else desugared if desugared.len > 0 else spelled

    def ast_abi_qual_type(node: JsonValue) -> sview:
        # Clang keeps typedef spelling in qualType, while desugaredQualType
        # carries the ABI shape needed for pointer and function-pointer lowering.
        return ast_type_object_c_type(ast_field(node, sview("type", 0, -1)))

    def ast_c_type(node: JsonValue) -> sview:
        # Keep va_list's spelling: its platform-specific desugared array shape is
        # intentionally represented by Elisa's dedicated va_list ABI type. For
        # ordinary typedefs, use Clang's desugared spelling so anonymous records
        # and aliases such as `error` retain their actual struct shape.
        spelled: sview = ast_qual_type(node)
        return spelled if sview_eq(spelled, sview("va_list", 0, -1)) or sview_eq(spelled, sview("__builtin_va_list", 0, -1)) else ast_abi_qual_type(node)

    def ast_children(node: JsonValue) -> JsonValue:
        return ast_field(node, sview("inner", 0, -1))

    def ast_child_count(node: JsonValue) -> i64:
        return json_array_len(ast_children(node))

    def ast_child(node: JsonValue, index: i64) -> JsonValue:
        return ast_array_item(ast_children(node), index)

    def ast_comment_text(node: JsonValue) -> sview:
        if sview_eq(ast_kind(node), sview("TextComment", 0, -1)):
            return ast_string(ast_field(node, sview("text", 0, -1)))
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                comment: sview = ast_comment_text(ast_child(node, index))
                return comment if comment.len > 0
        return sview("", 0, 0)

    def ast_find_child(node: JsonValue, wanted: sview) -> JsonValue:
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                child: JsonValue = ast_child(node, index)
                return child if sview_eq(ast_kind(child), wanted)
        return JsonValue.Null

    def ast_find_record_by_id(node: JsonValue, wanted: sview) -> JsonValue:
        if sview_eq(ast_kind(node), sview("RecordDecl", 0, -1)) and sview_eq(ast_string(ast_field(node, sview("id", 0, -1))), wanted) and ast_child_count(node) > 0:
            return node
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                found: JsonValue = ast_find_record_by_id(ast_child(node, index), wanted)
                return found if found != JsonValue.Null
        return JsonValue.Null

    def ast_find_decl_by_id(node: JsonValue, wanted: sview) -> JsonValue:
        if wanted.len > 0 and sview_eq(ast_string(ast_field(node, sview("id", 0, -1))), wanted):
            return node
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                found: JsonValue = ast_find_decl_by_id(ast_child(node, index), wanted)
                return found if found != JsonValue.Null
        return JsonValue.Null

    def ast_has_child(node: JsonValue, wanted: sview) -> bool:
        return ast_find_child(node, wanted) != JsonValue.Null

    def ast_location_file(node: JsonValue) -> sview:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        direct: mutable sview = ast_string(ast_field(location, sview("file", 0, -1)))
        return direct if direct.len > 0
        spelling: mutable sview = ast_string(ast_field(ast_field(location, sview("spellingLoc", 0, -1)), sview("file", 0, -1)))
        return spelling if spelling.len > 0
        expansion: sview = ast_string(ast_field(ast_field(location, sview("expansionLoc", 0, -1)), sview("file", 0, -1)))
        return expansion if expansion.len > 0
        range: JsonValue = ast_field(node, sview("range", 0, -1))
        begin: JsonValue = ast_field(range, sview("begin", 0, -1))
        direct <- ast_string(ast_field(begin, sview("file", 0, -1)))
        return direct if direct.len > 0
        spelling <- ast_string(ast_field(ast_field(begin, sview("spellingLoc", 0, -1)), sview("file", 0, -1)))
        return spelling if spelling.len > 0
        return ast_string(ast_field(ast_field(begin, sview("expansionLoc", 0, -1)), sview("file", 0, -1)))

    def ast_included_from_file(node: JsonValue) -> sview:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        included_from: JsonValue = ast_field(location, sview("includedFrom", 0, -1))
        direct: mutable sview = ast_string(ast_field(included_from, sview("file", 0, -1)))
        return direct if direct.len > 0
        spelling: JsonValue = ast_field(location, sview("spellingLoc", 0, -1))
        direct <- ast_string(ast_field(ast_field(spelling, sview("includedFrom", 0, -1)), sview("file", 0, -1)))
        return direct if direct.len > 0
        expansion: JsonValue = ast_field(location, sview("expansionLoc", 0, -1))
        return ast_string(ast_field(ast_field(expansion, sview("includedFrom", 0, -1)), sview("file", 0, -1)))

    def ast_location_has_origin(node: JsonValue) -> bool:
        location: JsonValue = ast_field(node, sview("loc", 0, -1))
        return ast_field(location, sview("spellingLoc", 0, -1)) != JsonValue.Null or ast_field(location, sview("expansionLoc", 0, -1)) != JsonValue.Null

    def ast_same_source_directory(file: sview, source: sview) -> bool:
        file_slash: mutable i64 = -1
        source_slash: mutable i64 = -1
        for index in 0..<file.len |file, file_slash|:
            file_slash <- index if string_view_index(file, index) == 47
        for index in 0..<source.len |source, source_slash|:
            source_slash <- index if string_view_index(source, index) == 47
        return file_slash >= 0 and file_slash == source_slash and sview_eq(string_view_prefix(file, file_slash), string_view_prefix(source, source_slash))

    def ast_is_embedded_user_record(node: JsonValue, source: cstr) -> bool:
        return false if not sview_eq(ast_kind(node), sview("RecordDecl", 0, -1)) or ast_name(node).len == 0
        return false if sview_starts_with(ast_name(node), sview("__", 0, -1))
        file: sview = ast_location_file(node)
        included_from: sview = ast_included_from_file(node)
        source_view: sview = sview(source, 0, -1)
        return file.len == 0 and (sview_eq(included_from, source_view) or ast_same_source_directory(included_from, source_view)) and ast_child_count(node) > 0

    def ast_is_embedded_user_declaration(node: JsonValue, source: cstr) -> bool:
        # When a C implementation is included with `#include "foo.c"`, Clang
        # reports the including source as `includedFrom` for the implementation
        # declarations. The same provenance is also used for some declarations
        # from system headers, so require the shape of a real definition and
        # reject implementation-detail names from the platform headers.
        file: sview = ast_location_file(node)
        included_from: sview = ast_included_from_file(node)
        source_view: sview = sview(source, 0, -1)
        return false if file.len != 0 or (not sview_eq(included_from, source_view) and not ast_same_source_directory(included_from, source_view))
        return false if sview_starts_with(ast_name(node), sview("__", 0, -1))
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("FunctionDecl", 0, -1)):
            return ast_has_child(node, sview("CompoundStmt", 0, -1))
        if sview_eq(kind, sview("VarDecl", 0, -1)):
            return true
        if sview_eq(kind, sview("RecordDecl", 0, -1)) or sview_eq(kind, sview("EnumDecl", 0, -1)) or sview_eq(kind, sview("TypedefDecl", 0, -1)):
            return ast_child_count(node) > 0
        return false

    def ast_is_user_declaration(node: JsonValue, source: cstr) -> bool:
        file: sview = ast_location_file(node)
        included_from: sview = ast_included_from_file(node)
        source_view: sview = sview(source, 0, -1)
        # Clang omits `file` for declarations in the main source file in some AST
        # nodes. An omitted file plus an omitted include origin is still ours.
        # Headers beside the translated source are part of the same C program and
        # must contribute their record layouts and declarations as well. A node
        # with only `includedFrom` pointing at the source is still a header
        # declaration; accepting it would pull in incomplete system-only records
        # such as Darwin's opaque `fssearchblock` and `searchstate` structs.
        return sview_eq(file, source_view) or ast_same_source_directory(file, source_view) or ast_is_embedded_user_declaration(node, source) or (file.len == 0 and included_from.len == 0 and not ast_location_has_origin(node))

    def safe_identifier(name: sview) -> sview:
        # Elisa reserves a few ordinary C identifiers. Prefixing only collisions
        # keeps the generated source close to the original C.
        if sview_eq(name, sview("error", 0, -1)):
            return sview("c_error", 0, -1)
        if sview_eq(name, sview("match", 0, -1)):
            return sview("c_match", 0, -1)
        if sview_eq(name, sview("pass", 0, -1)):
            return sview("c_pass", 0, -1)
        if sview_eq(name, sview("return", 0, -1)):
            return sview("c_return", 0, -1)
        if sview_eq(name, sview("new", 0, -1)):
            return sview("c_new", 0, -1)
        if sview_eq(name, sview("null", 0, -1)):
            return sview("c_null", 0, -1)
        return name

    def ast_expr_name(node: JsonValue) -> sview:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("DeclRefExpr", 0, -1)):
            referenced: JsonValue = ast_field(node, sview("referencedDecl", 0, -1))
            name: mutable sview = ast_name(referenced)
            name <- ast_name(node) if name.len == 0
            return name
        if sview_eq(kind, sview("ImplicitCastExpr", 0, -1)) or sview_eq(kind, sview("ParenExpr", 0, -1)) or sview_eq(kind, sview("CStyleCastExpr", 0, -1)) or sview_eq(kind, sview("ConstantExpr", 0, -1)):
            return ast_expr_name(ast_child(node, 0))
        return sview("", 0, 0)

    def ast_unwrapped_type(node: JsonValue) -> sview:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("ImplicitCastExpr", 0, -1)) or sview_eq(kind, sview("ParenExpr", 0, -1)) or sview_eq(kind, sview("ConstantExpr", 0, -1)):
            return ast_unwrapped_type(ast_child(node, 0))
        return ast_qual_type(node)

    def ast_is_empty(node: JsonValue) -> bool:
        return ast_kind(node).len == 0

    def ast_cast_kind(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("castKind", 0, -1)))

    def ast_target_label_id(node: JsonValue) -> sview:
        return ast_string(ast_field(node, sview("targetLabelDeclId", 0, -1)))

    def ast_enum_value(node: JsonValue, fallback: i64) -> i64:
        count: i64 = ast_child_count(node)
        if count > 0:
            child: JsonValue = ast_child(node, 0)
            value: JsonValue = ast_field(child, sview("value", 0, -1))
            value_text: sview = ast_string(value)
            if value_text.len > 0:
                # Clang gives enum values as decimal strings. The source corpus uses
                # only ordinary integer constants, so the small parser below is enough
                # and avoids re-parsing the C spelling.
                result: mutable i64 = 0
                sign: mutable i64 = 1
                start: mutable i64 = 0
                if string_view_index(value_text, 0) == 45:
                    sign <- -1
                    start <- 1
                for index in start..<value_text.len |result, value_text|:
                    digit: i64 = string_view_index(value_text, index) - 48
                    result <- result * 10 + digit if digit >= 0 and digit <= 9
                return result * sign
        return fallback

    # -----------------------------------------------------------------------------
    # Typed lowering IR
    # -----------------------------------------------------------------------------
    #
    # The Clang JSON tree is intentionally not emitted directly. Lowering first
    # produces these flat, index-based nodes. Indexes keep the IR non-recursive,
    # which fits Elisa's value model while still allowing arbitrarily nested C
    # expressions and statements.

    const enum TypedExprKind of i8:
        Invalid
        Integer
        Floating
        String
        Character
        Name
        Binary
        Unary
        ArrayIndex
        Conditional
        Member
        Call
        Sizeof
        Cast
        Aggregate
        Sequence
        Null
        Zeroed

    const enum TypedStmtKind of i8:
        Invalid
        Block
        Return
        Declaration
        If
        Expression
        For
        While
        DoWhile
        Break
        Continue
        Goto
        Label
        Switch
        SwitchBreak
        Null

    const enum TypedBindingKind of i8:
        External
        ExternalGlobal

    const enum TypedTranslationMode of i8:
        Fidelity
        Idiomatic

    struct TypedExpr:
        kind: TypedExprKind
        text: sview
        type_name: sview
        lhs: i64
        rhs: i64
        third: i64
        args_start: i64
        args_count: i64
        value: i64

    struct TypedStmt:
        kind: TypedStmtKind
        expr: i64
        aux: i64
        aux2: i64
        children_start: i64
        children_count: i64
        name: sview
        type_name: sview

    struct TypedParam:
        name: sview
        type_name: sview
        is_mutable: bool

    struct TypedNameAlias:
        source: sview
        suffix: sview

    struct TypedField:
        name: sview
        type_name: sview

    struct TypedRecord:
        name: sview
        fields_start: i64
        fields_count: i64
        comment: sview

    struct TypedEnumConst:
        name: sview
        enum_name: sview
        value: i64

    struct TypedEnum:
        name: sview
        underlying_type: sview

    struct TypedExtern:
        name: sview
        link_name: sview
        return_type: sview
        params_start: i64
        params_count: i64
        variadic: bool

    struct TypedExternGlobal:
        name: sview
        link_name: sview
        type_name: sview

    struct TypedLabel:
        id: sview
        node: JsonValue

    struct TypedGlobal:
        name: sview
        type_name: sview
        initializer: i64
        comment: sview

    struct TypedSwitchCase:
        value: i64
        body: i64
        is_default: bool
        is_constant: bool
        constant_value: i64

    struct TypedFunction:
        name: sview
        return_type: sview
        params_start: i64
        params_count: i64
        body: i64
        variadic: bool
        has_global_effect: bool
        has_unsafe_effect: bool
        has_goto: bool
        label_count: i64
        comment: sview

    const enum TypedFlowTermKind of i8:
        Open
        Jump
        Branch
        Return
        Stop

    struct TypedFlowBlock:
        term_type: mutable sview
        statements_count: mutable i64
        term_expr: mutable i64
        target: mutable i64
        true_target: mutable i64
        false_target: mutable i64
        term_kind: mutable TypedFlowTermKind
        target_is_label: mutable bool

    struct TypedFlowStatement:
        block: i64
        statement: i64

    struct TypedFlowBuilder:
        blocks: mutable darray[TypedFlowBlock]
        statements: mutable darray[TypedFlowStatement]
        label_blocks: mutable darray[i64]
        declarations: mutable darray[i64]
        break_targets: mutable darray[i64]
        continue_targets: mutable darray[i64]
        state_name: sview
        current: mutable i64

    struct TypedDiagnostic:
        category: sview
        kind: sview
        line: i64
        column: i64

    struct TypedDeclInfo:
        id: sview
        is_user: bool
        is_extern: bool

    struct TypedContext:
        exprs: mutable darray[TypedExpr]
        expr_children: mutable darray[i64]
        stmts: mutable darray[TypedStmt]
        stmt_children: mutable darray[i64]
        params: mutable darray[TypedParam]
        current_name_aliases: mutable darray[TypedNameAlias]
        current_nonnull_names: mutable darray[sview]
        current_nonnull_exprs: mutable darray[i64]
        extern_params: mutable darray[TypedParam]
        globals: mutable darray[TypedGlobal]
        functions: mutable darray[TypedFunction]
        user_function_names: mutable darray[sview]
        externs: mutable darray[TypedExtern]
        extern_globals: mutable darray[TypedExternGlobal]
        fields: mutable darray[TypedField]
        records: mutable darray[TypedRecord]
        enums: mutable darray[TypedEnum]
        enum_consts: mutable darray[TypedEnumConst]
        labels: mutable darray[TypedLabel]
        switch_cases: mutable darray[TypedSwitchCase]
        decl_infos: mutable darray[TypedDeclInfo]
        break_scopes: mutable darray[i8]
        switch_depth: mutable i64
        current_for_increment: mutable i64
        current_return_type: mutable sview
        current_has_goto: mutable bool
        current_emit_has_goto: mutable bool
        current_structured_break_label: mutable i64
        current_emit_goto_name: mutable sview
        current_switch_done_name: mutable sview
        current_switch_done_index: mutable i64
        current_function_body: mutable i64
        mode: TypedTranslationMode
        source: cstr
        root: mutable JsonValue
        diagnostics: mutable darray[TypedDiagnostic]

    struct TypedTranslation:
        output: darray[u8]
        diagnostics: darray[TypedDiagnostic]
        failed: bool

    def typed_number(value: JsonValue) -> i64:
        match value:
            JsonValue.Number(number):
                return number.i64()
            _:
                return 0

    def ast_bool(value: JsonValue) -> bool:
        match value:
            JsonValue.Bool(result):
                return result
            _:
                return false
