extend CTranslator:
    def typed_ast_is_loop(node: JsonValue) -> bool:
        kind: sview = ast_kind(node)
        return sview_eq(kind, sview("ForStmt", 0, -1)) or sview_eq(kind, sview("WhileStmt", 0, -1)) or sview_eq(kind, sview("DoStmt", 0, -1))

    def typed_ast_contains_direct_loop_goto(node: JsonValue, label_id: sview) -> bool:
        # A goto nested inside another loop may leave more than one loop. It
        # therefore cannot be represented by a single Elisa `break`; leave the
        # enclosing function on the CFG path in that case.
        return false if typed_ast_is_loop(node)
        if sview_eq(ast_kind(node), sview("GotoStmt", 0, -1)):
            return sview_eq(ast_target_label_id(node), label_id)
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count |node, label_id|:
                return true if typed_ast_contains_direct_loop_goto(ast_child(node, index), label_id)
        return false

    def typed_loop_contains_direct_goto(node: JsonValue, label_id: sview) -> bool:
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count |node, label_id|:
                return true if typed_ast_contains_direct_loop_goto(ast_child(node, index), label_id)
        return false

    def typed_lower_stmt(ctx: mutable TypedContext&, node: JsonValue) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("ReturnStmt", 0, -1)):
            expression: mutable i64 = -1
            if ast_child_count(node) > 0:
                expression <- typed_lower_expr(ctx, ast_child(node, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1 if expression < 0
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Return, expr: expression, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: ctx.current_return_type}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("CompoundStmt", 0, -1)):
            children: mutable darray[i64] = []
            count: i64 = ast_child_count(node)
            if count >= 0:
                for index in 0..<count |ctx, node, children|:
                    child_node: JsonValue = ast_child(node, index)
                    continue if ast_is_comment_node(child_node)
                    structured_label: mutable i64 = -1
                    if typed_ast_is_loop(child_node) and index + 1 < count:
                        next_node: JsonValue = ast_child(node, index + 1)
                        if sview_eq(ast_kind(next_node), sview("LabelStmt", 0, -1)):
                            label_id: sview = ast_string(ast_field(next_node, sview("declId", 0, -1)))
                            candidate: i64 = typed_label_index(ctx, label_id)
                            if candidate >= 0 and typed_loop_contains_direct_goto(child_node, label_id):
                                structured_label <- candidate
                    saved_structured_label: i64 = ctx.current_structured_break_label
                    ctx.current_structured_break_label <- structured_label if structured_label >= 0 else saved_structured_label
                    child_stmt: i64 = typed_lower_stmt(ctx, child_node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    ctx.current_structured_break_label <- saved_structured_label
                    if child_stmt < 0:
                        return -1
                    children.push(child_stmt)
            return typed_make_block(ctx, children) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("DeclStmt", 0, -1)):
            children: mutable darray[i64] = []
            count: i64 = ast_child_count(node)
            if count >= 0:
                for index in 0..<count |ctx, node, children|:
                    child: JsonValue = ast_child(node, index)
                    continue if ast_is_comment_node(child)
                    if ast_is_static_decl(child):
                        continue
                    child_stmt: i64 = typed_lower_declaration(ctx, child) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    if child_stmt < 0:
                        return -1
                    children.push(child_stmt)
            return children[0] if children.count == 1
            return typed_make_block(ctx, children) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("IfStmt", 0, -1)):
            condition_parts: TypedCondition = typed_lower_condition(ctx, ast_child(node, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            condition: mutable i64 = condition_parts.expression
            when_true: i64 = typed_lower_stmt(ctx, ast_child(node, 1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            when_false: mutable i64 = -1
            if ast_child_count(node) > 2:
                when_false <- typed_lower_stmt(ctx, ast_child(node, 2)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            if condition < 0 or when_true < 0 or when_false < -1:
                return -1
            lowered_if: i64 = typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.If, expr: condition, aux: when_true, aux2: when_false, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            if condition_parts.assignment >= 0:
                assignment_stmt: i64 = typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Expression, expr: condition_parts.assignment, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return typed_make_block(ctx, [assignment_stmt, lowered_if]) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return lowered_if
        if sview_eq(kind, sview("WhileStmt", 0, -1)):
            condition_parts: TypedCondition = typed_lower_condition(ctx, ast_child(node, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            condition: mutable i64 = condition_parts.expression
            saved_increment: i64 = ctx.current_for_increment
            ctx.current_for_increment <- -1
            ctx.break_scopes.push(1)
            body: mutable i64 = typed_lower_stmt(ctx, ast_child(node, 1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            _ = ctx.break_scopes.pop()
            ctx.current_for_increment <- saved_increment
            if condition < 0 or body < 0:
                return -1
            if condition_parts.assignment >= 0 and condition_parts.postfix:
                loop_body: mutable darray[i64] = [typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Expression, expr: condition_parts.assignment, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}), body]
                body <- typed_make_block(ctx, loop_body) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            elif condition_parts.assignment >= 0:
                not_condition: i64 = typed_push_expr(ctx, TypedExpr{kind: TypedExprKind.Unary, text: sview("not", 0, -1), type_name: sview("_Bool", 0, -1), lhs: condition, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                break_stmt: i64 = typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Break, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                guard: i64 = typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.If, expr: not_condition, aux: break_stmt, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                loop_body: mutable darray[i64] = [typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Expression, expr: condition_parts.assignment, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}), guard, body]
                body <- typed_make_block(ctx, loop_body) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                condition <- typed_push_expr(ctx, TypedExpr{kind: TypedExprKind.Integer, text: sview("1", 0, -1), type_name: sview("int", 0, -1), lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.While, expr: condition, aux: body, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("DoStmt", 0, -1)):
            ctx.break_scopes.push(1)
            body: mutable i64 = typed_lower_stmt(ctx, ast_child(node, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            _ = ctx.break_scopes.pop()
            condition: mutable i64 = typed_lower_expr(ctx, ast_child(node, 1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            if condition < 0 or body < 0:
                return -1
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.DoWhile, expr: condition, aux: body, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("ForStmt", 0, -1)):
            init: mutable i64 = -1
            if not ast_is_empty(ast_child(node, 0)):
                init <- typed_lower_stmt(ctx, ast_child(node, 0)) if sview_eq(ast_kind(ast_child(node, 0)), sview("DeclStmt", 0, -1)) else typed_lower_stmt(ctx, ast_child(node, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            condition: mutable i64 = -1
            if ast_is_empty(ast_child(node, 2)):
                condition <- typed_push_expr(ctx, TypedExpr{kind: TypedExprKind.Integer, text: sview("1", 0, -1), type_name: sview("int", 0, -1), lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            else:
                condition <- typed_lower_expr(ctx, ast_child(node, 2)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            increment: mutable i64 = -1
            if not ast_is_empty(ast_child(node, 3)):
                increment_expression: i64 = typed_lower_expr(ctx, ast_child(node, 3)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                increment <- typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Expression, expr: increment_expression, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) if increment_expression >= 0
            saved_increment: i64 = ctx.current_for_increment
            ctx.current_for_increment <- increment
            ctx.break_scopes.push(1)
            body: i64 = typed_lower_stmt(ctx, ast_child(node, 4)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            _ = ctx.break_scopes.pop()
            ctx.current_for_increment <- saved_increment
            if condition < 0 or body < 0 or (not ast_is_empty(ast_child(node, 3)) and increment < 0):
                return -1
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.For, expr: condition, aux: body, aux2: increment, children_start: init, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("SwitchStmt", 0, -1)):
            return typed_lower_switch(ctx, node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("BreakStmt", 0, -1)):
            nearest_break_scope: i8 = ctx.break_scopes[(ctx.break_scopes.count - 1).usize()] if ctx.break_scopes.count > 0 else 0
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.SwitchBreak if nearest_break_scope == 2 else TypedStmtKind.Break, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("ContinueStmt", 0, -1)):
            if ctx.current_for_increment >= 0:
                continuation: i64 = typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Continue, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                wrapped: mutable darray[i64] = [ctx.current_for_increment, continuation]
                return typed_make_block(ctx, wrapped) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Continue, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("GotoStmt", 0, -1)):
            target_index: i64 = typed_label_index(ctx, ast_target_label_id(node))
            if target_index < 0:
                typed_record_unsupported(ctx, node, sview("statement", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1
            if target_index == ctx.current_structured_break_label:
                return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Break, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            ctx.current_has_goto <- true
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Goto, expr: -1, aux: target_index, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("LabelStmt", 0, -1)):
            label_index: i64 = typed_label_index(ctx, ast_string(ast_field(node, sview("declId", 0, -1))))
            if label_index < 0:
                typed_record_unsupported(ctx, node, sview("statement", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1
            body: i64 = typed_lower_stmt(ctx, ast_child(node, 0)) if ast_child_count(node) > 0 else typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Null, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return -1 if body < 0
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Label, expr: body, aux: label_index, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if sview_eq(kind, sview("NullStmt", 0, -1)):
            return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Null, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        expression: i64 = typed_lower_expr(ctx, node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if expression < 0:
            return -1
        return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Expression, expr: expression, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_lower_declaration(ctx: mutable TypedContext&, node: JsonValue) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        if not sview_eq(ast_kind(node), sview("VarDecl", 0, -1)):
            typed_record_unsupported(ctx, node, sview("declaration", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return -1
        initialization: mutable i64 = -1
        declaration_type: sview = ast_c_type(node)
        if ast_child_count(node) > 0:
            for child_index in 0..<ast_child_count(node) |ctx, node, initialization|:
                initializer_node: JsonValue = ast_child(node, child_index)
                continue if ast_is_comment_node(initializer_node)
                initialization <- typed_lower_expr(ctx, initializer_node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1 if initialization < 0
                break
        return typed_push_stmt(ctx, TypedStmt{kind: TypedStmtKind.Declaration, expr: initialization, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: safe_identifier(ast_name(node)), type_name: declaration_type}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_collect_globals(ctx: mutable TypedContext&, node: JsonValue) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        if sview_eq(ast_kind(node), sview("VarDecl", 0, -1)) and ast_is_static_decl(node):
            name: sview = safe_identifier(ast_name(node))
            if typed_global_index(ctx, name) < 0:
                initializer: mutable i64 = -1
                if ast_child_count(node) > 0:
                    for child_index in 0..<ast_child_count(node) |ctx, node, initializer|:
                        initializer_node: JsonValue = ast_child(node, child_index)
                        continue if ast_is_comment_node(initializer_node)
                        initializer <- typed_lower_expr(ctx, initializer_node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                        break
                ctx.globals.push(TypedGlobal{name: name, type_name: ast_c_type(node), initializer: initializer, comment: ast_comment_text(node)})
            return
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count |ctx, node|:
                typed_collect_globals(ctx, ast_child(node, index)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    def typed_lower_function(ctx: mutable TypedContext&, node: JsonValue) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        params_start: i64 = ctx.params.count.i64()
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count |ctx, node|:
                parameter: JsonValue = ast_child(node, index)
                if sview_eq(ast_kind(parameter), sview("ParmVarDecl", 0, -1)):
                    parameter_type: sview = ast_c_type(parameter)
                    # A C parameter is a local object even when its pointee is
                    # const; `const T *p` still permits rebinding p.
                    is_mutable: bool = false
                    ctx.params.push(TypedParam{name: safe_identifier(ast_name(parameter)), type_name: parameter_type, is_mutable: is_mutable})
        body_node: JsonValue = ast_find_child(node, sview("CompoundStmt", 0, -1))
        ctx.labels <- []
        typed_collect_labels(ctx, body_node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        saved_return_type: sview = ctx.current_return_type
        saved_has_goto: bool = ctx.current_has_goto
        ctx.current_return_type <- c_function_return_type(ast_c_type(node))
        ctx.current_has_goto <- false
        body: i64 = typed_lower_stmt(ctx, body_node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        has_goto: bool = ctx.current_has_goto
        ctx.current_return_type <- saved_return_type
        ctx.current_has_goto <- saved_has_goto
        if body < 0:
            return -1
        return typed_push_function(ctx, TypedFunction{name: safe_identifier(ast_name(node)), return_type: ast_c_type(node), params_start: params_start, params_count: ctx.params.count.i64() - params_start, body: body, variadic: sview_find_byte(ast_c_type(node), 46) >= 0, has_global_effect: ast_contains_static_decl(body_node), has_unsafe_effect: ast_contains_kind(node, sview("ArraySubscriptExpr", 0, -1)), has_goto: has_goto, label_count: ctx.labels.count.i64(), comment: ast_comment_text(node)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
