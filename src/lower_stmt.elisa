extend CTranslator:
    def typed_collect_discarded_comma_effects[@r](ctx: mutable TypedContext[r]&, index: i64, prelude: mutable darray[i64]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr[r] = typed_expr_at(ctx, index)
        if expression.kind == TypedExprKind.Sequence and expression.value == 0 and sview_eq(expression.text, sview(",", 0, -1)):
            typed_collect_discarded_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            typed_collect_discarded_comma_effects(ctx, expression.rhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return
        typed_collect_nested_comma_effects(ctx, index, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if typed_condition_expr_has_effect(ctx, index):
            prelude.push(typed_push_stmt(ctx, TypedStmt[r]{kind: TypedStmtKind.Expression, expr: index, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)

    # Lift comma prefixes through expression operands that are evaluated
    # unconditionally. A logical RHS and either conditional arm are
    # intentionally excluded: moving their effects into the statement prelude
    # would make a skipped effect run unconditionally.
    def typed_collect_nested_comma_effects[@r](ctx: mutable TypedContext[r]&, index: i64, prelude: mutable darray[i64]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr[r] = typed_expr_at(ctx, index)
        if expression.kind == TypedExprKind.Sequence and expression.value == 0 and sview_eq(expression.text, sview(",", 0, -1)):
            typed_collect_discarded_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            typed_collect_nested_comma_effects(ctx, expression.rhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        elif expression.kind == TypedExprKind.Call:
            typed_collect_nested_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            for offset in 0..<expression.args_count |ctx, expression, prelude|:
                argument: i64 = ctx.expr_children[(expression.args_start + offset).usize()]
                typed_collect_nested_comma_effects(ctx, argument, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        elif expression.kind == TypedExprKind.Binary:
            # Assignment and short-circuit operators have dedicated evaluation
            # rules. Their children require explicit sequencing lowering rather
            # than this eager-operand extraction.
            return if sview_eq(expression.text, sview("<-", 0, -1))
            if sview_eq(expression.text, sview("and", 0, -1)) or sview_eq(expression.text, sview("or", 0, -1)):
                typed_collect_nested_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return
            typed_collect_nested_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            typed_collect_nested_comma_effects(ctx, expression.rhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        elif expression.kind == TypedExprKind.Unary or expression.kind == TypedExprKind.Cast or expression.kind == TypedExprKind.Member:
            typed_collect_nested_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        elif expression.kind == TypedExprKind.ArrayIndex:
            # Incremented subscripts carry their own ordered update edge.
            return if expression.value >= 0
            typed_collect_nested_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            typed_collect_nested_comma_effects(ctx, expression.rhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        elif expression.kind == TypedExprKind.Conditional:
            # The condition always runs; the true/false arms are mutually
            # conditional and must retain their effects within the chosen arm.
            typed_collect_nested_comma_effects(ctx, expression.lhs, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_make_conditional_assignment[@r](ctx: mutable TypedContext[r]&, name: sview, type_name: sview, value: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        target: i64 = typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Name, text: name, type_name: type_name, lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        assignment: i64 = typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Binary, text: sview("<-", 0, -1), type_name: type_name, lhs: target, rhs: value, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        return typed_push_stmt(ctx, TypedStmt[r]{kind: TypedStmtKind.Expression, expr: assignment, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_lower_simple_assignment_with_preludes[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], assignment_node: JsonValueHandle[r], prelude: mutable darray[i64]&, preserve_value: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        lhs: i64 = typed_lower_comma_value(ctx, ast_child(assignment_node, 0), prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        rhs: i64 = typed_lower_comma_value(ctx, ast_child(assignment_node, 1), prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if lhs < 0 or rhs < 0:
            return -1
        value_type: sview = typed_c_type(ctx, node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        assignment: i64 = typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Binary, text: sview("<-", 0, -1), type_name: value_type, lhs: lhs, rhs: rhs, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if preserve_value:
            return typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Sequence, text: sview(",", 0, -1), type_name: value_type, lhs: assignment, rhs: rhs, third: -1, args_start: -1, args_count: 0, value: 5}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        return assignment
    def typed_ast_has_conditional_comma_effect[@r](node: JsonValueHandle[r]) -> bool:
        if sview_eq(ast_kind(node), sview("ConditionalOperator", 0, -1)) and ast_child_count(node) > 2:
            return true if typed_ast_has_effectful_comma(ast_child(node, 1)) or typed_ast_has_effectful_comma(ast_child(node, 2))
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count |node|:
                return true if typed_ast_has_conditional_comma_effect(ast_child(node, index))
        return false
    def typed_ast_callee_function_pointer_variable[@r](node: JsonValueHandle[r]) -> JsonValueHandle[r]:
        callee: mutable JsonValueHandle[r] = ast_strip_condition(node)
        if sview_eq(ast_kind(callee), sview("UnaryOperator", 0, -1)) and ast_child_count(callee) > 0 and sview_eq(ast_string(ast_field(callee, sview("opcode", 0, -1))), sview("*", 0, -1)):
            callee <- ast_strip_condition(ast_child(callee, 0))
        return json_handle_null(callee) if not sview_eq(ast_kind(callee), sview("DeclRefExpr", 0, -1))
        declaration: JsonValueHandle[r] = ast_field(callee, sview("referencedDecl", 0, -1))
        declaration_kind: sview = ast_kind(declaration)
        is_variable: bool = sview_eq(declaration_kind, sview("VarDecl", 0, -1)) or sview_eq(declaration_kind, sview("ParmVarDecl", 0, -1))
        return callee if is_variable and c_type_is_function_pointer(ast_qual_type(callee)) else json_handle_null(callee)
    def typed_materialize_call_argument[@r](ctx: mutable TypedContext[r]&, value: i64, prelude: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        value_type: sview = typed_expr_at(ctx, value).type_name
        generated_name: mutable darray[u8] = []
        append_view(generated_name, sview("__elisa_transpiler_call_argument_", 0, -1))
        append_i64(generated_name, ctx.exprs.count.i64())
        name_storage: cstr = string_view_copy(bytes_view(generated_name)) can Memory.Allocate, Abort.Panic
        name: sview = sview(name_storage, 0, -1)
        prelude.push(typed_push_stmt(ctx, TypedStmt[r]{kind: TypedStmtKind.Declaration, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: name, type_name: value_type}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
        prelude.push(typed_make_conditional_assignment(ctx, name, value_type, value) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
        return typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Name, text: name, type_name: value_type, lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

    # Side-effecting arguments must be evaluated as complete values before the
    # next argument. This selects one order permitted by C and C++17, and keeps
    # C++17's indeterminately sequenced argument evaluations from interleaving.
    # A plain function-pointer variable is captured before its arguments.
    def typed_lower_call_with_argument_preludes[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], call_node: JsonValueHandle[r], prelude: mutable darray[i64]&, handled: mutable bool&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        handled <- false
        return -1 if not sview_eq(ast_kind(call_node), sview("CallExpr", 0, -1)) or ast_child_count(call_node) < 2
        callee_node: JsonValueHandle[r] = ast_child(call_node, 0)
        named_callee: bool = ast_callee_is_named_function(callee_node)
        indirect_callee: bool = not named_callee
        function_pointer_variable: JsonValueHandle[r] = typed_ast_callee_function_pointer_variable(callee_node) if indirect_callee else json_handle_null(callee_node)
        has_argument_effects: mutable bool = false
        for index in 1..<ast_child_count(call_node) |call_node, has_argument_effects|:
            has_argument_effects <- true if typed_ast_expression_has_effect(ast_child(call_node, index))
        return -1 if not has_argument_effects

        callee_name: mutable sview = typed_callee_name(callee_node)
        callee_name <- ast_name(ast_field(function_pointer_variable, sview("referencedDecl", 0, -1))) if indirect_callee and callee_name.len == 0
        return -1 if (callee_name.len == 0 and not indirect_callee) or sview_starts_with(callee_name, sview("__builtin_", 0, -1))
        handled <- true
        callee_type: mutable sview = typed_c_type(ctx, callee_node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        call_callee: mutable i64 = -1
        if indirect_callee:
            # Preserve `(*callback)(...)` through the referenced variable (the
            # dereference has function type, not function-pointer type). Other
            # indirect forms, including a factory call or a struct field, are
            # lowered as values so their own comma/effect preludes are retained.
            callee_value_node: JsonValueHandle[r] = function_pointer_variable if ast_kind(function_pointer_variable).len > 0 else callee_node
            callee_prelude: mutable darray[i64] = []
            call_callee <- typed_lower_comma_value(ctx, callee_value_node, callee_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            if call_callee < 0:
                return -1
            for prelude_index in 0..<callee_prelude.count |prelude, callee_prelude|:
                prelude.push(callee_prelude[prelude_index])
            callee_type <- typed_expr_at(ctx, call_callee).type_name
            if not c_type_is_function_pointer(callee_type):
                typed_record_unsupported(ctx, call_node, sview("indirect call callee type", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1
            generated_name: mutable darray[u8] = []
            append_view(generated_name, sview("__elisa_transpiler_indirect_callee_", 0, -1))
            append_i64(generated_name, ctx.exprs.count.i64())
            generated_name_storage: cstr = string_view_copy(bytes_view(generated_name)) can Memory.Allocate, Abort.Panic
            temp_name: sview = sview(generated_name_storage, 0, -1)
            prelude.push(typed_push_stmt(ctx, TypedStmt[r]{kind: TypedStmtKind.Declaration, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: temp_name, type_name: callee_type}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
            prelude.push(typed_make_conditional_assignment(ctx, temp_name, callee_type, call_callee) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
            call_callee <- typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Name, text: temp_name, type_name: callee_type, lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        header_inline_call: bool = named_callee and ctx.project_mode and ast_callee_is_header_inline(ctx, callee_node, ctx.source)
        lowered_args: mutable darray[i64] = []
        for index in 1..<ast_child_count(call_node) |ctx, call_node, prelude, lowered_args|:
            argument_prelude: mutable darray[i64] = []
            argument: mutable i64 = typed_lower_comma_value(ctx, ast_child(call_node, index), argument_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return -1 if argument < 0
            for prelude_index in 0..<argument_prelude.count |prelude, argument_prelude|:
                prelude.push(argument_prelude[prelude_index])
            if typed_condition_expr_has_effect(ctx, argument) or typed_ast_expression_has_effect(ast_child(call_node, index)):
                argument_type: sview = typed_expr_at(ctx, argument).type_name
                is_record_value: bool = c_type_pointer_count(argument_type) == 0 and typed_record_index(ctx, argument_type) >= 0
                if c_type_is_array(argument_type) or c_type_reference_count(argument_type) > 0 or is_record_value:
                    typed_record_unsupported(ctx, ast_child(call_node, index), sview("sequencing effectful aggregate call argument", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                    return -1
                argument <- typed_materialize_call_argument(ctx, argument, prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            lowered_args.push(argument)
        if named_callee:
            typed_add_external(ctx, callee_name, callee_type, ast_callee_referenced_decl(callee_node)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        args_start: i64 = ctx.expr_children.count.i64()
        for index in 0..<lowered_args.count |ctx, lowered_args|:
            ctx.expr_children.push(lowered_args[index])
        result_type: sview = typed_c_type(ctx, node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        return typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Call, text: safe_identifier(callee_name), type_name: result_type, lhs: call_callee, rhs: -1, third: -1, args_start: args_start, args_count: lowered_args.count.i64(), value: 1 if indirect_callee else (2 if header_inline_call else 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_lower_comma_conditional[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], conditional: JsonValueHandle[r], prelude: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        expression_start: usize = ctx.exprs.count
        child_start: usize = ctx.expr_children.count
        condition: i64 = typed_lower_expr(ctx, ast_child(conditional, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        return -1 if condition < 0
        condition_prelude: mutable darray[i64] = []
        typed_collect_nested_comma_effects(ctx, condition, condition_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        constant: mutable i64 = 0
        if condition_prelude.count == 0 and typed_eval_integer_constant(ctx, condition, constant):
            typed_rewrite_conditional_prunes <- typed_rewrite_conditional_prunes + 1
            if typed_rewrite_explanations_enabled:
                cli_emit_rewrite_event_node(ctx, conditional, sview("conditional-arm-pruning", 0, -1), sview("applied", 0, -1), sview("proof", 0, -1), sview("target-abi-integer-constant-condition", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            typed_truncate_exprs(ctx, expression_start)
            ctx.expr_children.count <- child_start
            selected: i64 = 1 if constant != 0 else 2
            return typed_lower_comma_value(ctx, ast_child(conditional, selected), prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console

        value_type: sview = typed_c_type(ctx, node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        when_true_prelude: mutable darray[i64] = []
        when_false_prelude: mutable darray[i64] = []
        when_true: i64 = typed_lower_comma_value(ctx, ast_child(conditional, 1), when_true_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        when_false: i64 = typed_lower_comma_value(ctx, ast_child(conditional, 2), when_false_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        if when_true < 0 or when_false < 0:
            return -1
        if when_true_prelude.count > 0 or when_false_prelude.count > 0:
            value_category: sview = ast_string(ast_field(conditional, sview("valueCategory", 0, -1)))
            if value_category.len > 0 and not sview_eq(value_category, sview("prvalue", 0, -1)):
                typed_record_unsupported(ctx, conditional, sview("comma effects in non-prvalue conditional", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1
            if typed_record_index(ctx, value_type) >= 0:
                typed_record_unsupported(ctx, conditional, sview("comma effects in record-valued conditional", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1
        for index in 0..<condition_prelude.count |prelude, condition_prelude|:
            prelude.push(condition_prelude[index])
        if when_true_prelude.count == 0 and when_false_prelude.count == 0:
            result: i64 = typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Conditional, text: sview("", 0, 0), type_name: value_type, lhs: condition, rhs: when_true, third: when_false, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            # The comma-aware constructor bypasses the expression-origin wrapper.
            typed_set_expr_source_origin(ctx, result, conditional, sview("", 0, 0))
            return result

        # A statement prelude in either arm cannot be hoisted without changing
        # C's conditional evaluation. Materialize the value, then keep each
        # arm's effects and assignment under the same branch as the source.
        generated_name: mutable darray[u8] = []
        append_view(generated_name, sview("__elisa_transpiler_conditional_value_", 0, -1))
        append_i64(generated_name, ctx.exprs.count.i64())
        generated_name_storage: cstr = string_view_copy(bytes_view(generated_name)) can Memory.Allocate, Abort.Panic
        temp_name: sview = sview(generated_name_storage, 0, -1)
        temp_decl: i64 = typed_push_stmt(ctx, TypedStmt[r]{kind: TypedStmtKind.Declaration, expr: -1, aux: -1, aux2: -1, children_start: -1, children_count: 0, name: temp_name, type_name: value_type}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        prelude.push(temp_decl)
        when_true_prelude.push(typed_make_conditional_assignment(ctx, temp_name, value_type, when_true) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
        when_false_prelude.push(typed_make_conditional_assignment(ctx, temp_name, value_type, when_false) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
        when_true_stmt: i64 = typed_make_block(ctx, when_true_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        when_false_stmt: i64 = typed_make_block(ctx, when_false_prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        prelude.push(typed_push_stmt(ctx, TypedStmt[r]{kind: TypedStmtKind.If, expr: condition, aux: when_true_stmt, aux2: when_false_stmt, children_start: -1, children_count: 0, name: sview("", 0, 0), type_name: sview("", 0, 0)}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console)
        return typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Name, text: temp_name, type_name: value_type, lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_lower_comma_value[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], prelude: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("ParenExpr", 0, -1)) or sview_eq(kind, sview("ConstantExpr", 0, -1)):
            return typed_lower_comma_value(ctx, ast_child(node, 0), prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console if ast_child_count(node) > 0
        if sview_eq(kind, sview("ImplicitCastExpr", 0, -1)) or sview_eq(kind, sview("CStyleCastExpr", 0, -1)) or sview_eq(kind, sview("CXXStaticCastExpr", 0, -1)):
            cast_kind: sview = ast_cast_kind(node)
            value_type: sview = typed_c_type(ctx, node) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            if sview_eq(cast_kind, sview("NullToPointer", 0, -1)):
                return typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Null, text: sview("", 0, 0), type_name: value_type, lhs: -1, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return -1 if ast_child_count(node) == 0
            operand: i64 = typed_lower_comma_value(ctx, ast_child(node, 0), prelude) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return -1 if operand < 0
            if sview_eq(cast_kind, sview("BitCast", 0, -1)) or sview_eq(cast_kind, sview("PointerToIntegral", 0, -1)) or sview_eq(cast_kind, sview("IntegralToPointer", 0, -1)) or sview_eq(cast_kind, sview("NoOp", 0, -1)):
                return typed_push_expr(ctx, TypedExpr[r]{kind: TypedExprKind.Cast, text: value_type, type_name: value_type, lhs: operand, rhs: -1, third: -1, args_start: -1, args_count: 0, value: 0}) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
            return operand
        stripped: JsonValueHandle[r] = ast_strip_condition(node)
        if sview_eq(ast_kind(stripped), sview("BinaryOperator", 0, -1)) and ast_child_count(stripped) > 1 and sview_eq(ast_string(ast_field(stripped, sview("opcode", 0, -1))), sview(",", 0, -1)):
            if typed_ast_expression_has_volatile_access(ast_child(stripped, 0)):
                typed_record_unsupported(ctx, stripped, sview("volatile comma operand sequencing", 0, -1)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
                return -1
