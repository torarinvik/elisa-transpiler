extend CTranslator:
    struct TypedDiagnostic:
        category: sview
        kind: sview
        subject_type: sview
        required_capability: sview
        # Canonical source file whose Clang invocation owns this diagnostic.
        # This is distinct from `source`, which may be a shared header or a
        # macro spelling/expansion location.
        translation_unit: sview
        translation_unit_content_hash: TypedContentHash
        source: sview
        canonical_source: sview
        source_content_hash: TypedContentHash
        spelling_source: sview
        spelling_canonical_source: sview
        spelling_source_content_hash: TypedContentHash
        spelling_included_from: sview
        spelling_included_from_canonical: sview
        spelling_included_from_content_hash: TypedContentHash
        expansion_source: sview
        expansion_canonical_source: sview
        expansion_source_content_hash: TypedContentHash
        expansion_included_from: sview
        expansion_included_from_canonical: sview
        expansion_included_from_content_hash: TypedContentHash
        range_start_offset: i64
        range_end_offset: i64
        line: i64
        column: i64
        spelling_line: i64
        spelling_column: i64
        expansion_line: i64
        expansion_column: i64

    struct TypedSourceHashEntry[@r]:
        canonical_path: sview @r
        hash: TypedContentHash
