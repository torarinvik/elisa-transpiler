extend CTranslator:
    # Flow facts are kept separate from expression spelling so every emitter
    # can use the same place identity and C NULL classification.
    def typed_name_is_currently_nonnull(ctx: TypedContext&, index: i64) -> bool:
        return false if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr = typed_expr_at(ctx, index)
        return true if c_type_is_array(expression.type_name) or expression.kind == TypedExprKind.String
        if expression.kind == TypedExprKind.Cast and expression.lhs >= 0:
            return true if c_type_is_array(typed_expr_at(ctx, expression.lhs).type_name)
        return false if not c_type_pointer_optional(expression.type_name)
        for fact_index in 0..<ctx.current_nonnull_exprs.count |ctx, index|:
            return true if typed_expr_is_same_place(ctx, index, ctx.current_nonnull_exprs[fact_index])
        return false if expression.kind != TypedExprKind.Name
        for offset in 0..<ctx.current_nonnull_names.count |ctx, expression|:
            return true if sview_eq(ctx.current_nonnull_names[offset.usize()], expression.text)
        return false

    def typed_expr_is_same_place(ctx: TypedContext&, left_index: i64, right_index: i64) -> bool:
        return false if left_index < 0 or right_index < 0 or left_index >= ctx.exprs.count.i64() or right_index >= ctx.exprs.count.i64()
        left: TypedExpr = typed_expr_at(ctx, left_index)
        right: TypedExpr = typed_expr_at(ctx, right_index)
        return typed_expr_is_same_place(ctx, left.lhs, right_index) if left.kind == TypedExprKind.Cast
        return typed_expr_is_same_place(ctx, left_index, right.lhs) if right.kind == TypedExprKind.Cast
        return typed_expr_is_same_place(ctx, left.lhs, right.lhs) if left.kind == TypedExprKind.Unary and right.kind == TypedExprKind.Unary and sview_eq(left.text, sview("&", 0, -1)) and sview_eq(right.text, sview("&", 0, -1))
        return sview_eq(left.text, right.text) if left.kind == TypedExprKind.Name and right.kind == TypedExprKind.Name
        return left.kind == TypedExprKind.Member and right.kind == TypedExprKind.Member and sview_eq(left.text, right.text) and typed_expr_is_same_place(ctx, left.lhs, right.lhs)
        return left.kind == TypedExprKind.ArrayIndex and right.kind == TypedExprKind.ArrayIndex and typed_expr_is_same_place(ctx, left.lhs, right.lhs) and typed_expr_is_same_place(ctx, left.rhs, right.rhs)
        return false

    def typed_expr_is_null_value(ctx: TypedContext&, index: i64) -> bool:
        return false if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr = typed_expr_at(ctx, index)
        return true if expression.kind == TypedExprKind.Null
        # Clang commonly lowers the C `NULL` macro as a zero integer wrapped in
        # one or more pointer casts. Treat that canonical null pointer constant
        # as null all the way through the cast chain.
        if expression.kind == TypedExprKind.Cast:
            constant: mutable i64 = 0
            if (sview_find_byte(expression.type_name, 42) >= 0 or c_type_is_function_pointer(expression.type_name)) and typed_eval_integer_constant(ctx, index, constant) and constant == 0:
                return true
            return expression.lhs >= 0 and typed_expr_is_null_value(ctx, expression.lhs)
        return false

    def typed_null_guard_name(ctx: TypedContext&, index: i64, wants_nonnull: bool) -> sview:
        return sview("", 0, 0) if index < 0 or index >= ctx.exprs.count.i64()
        expression: TypedExpr = typed_expr_at(ctx, index)
        return sview("", 0, 0) if expression.kind != TypedExprKind.Binary
        expected_opcode: sview = sview("!=", 0, -1) if wants_nonnull else sview("==", 0, -1)
        return sview("", 0, 0) if not sview_eq(expression.text, expected_opcode)
        lhs: TypedExpr = typed_expr_at(ctx, expression.lhs)
        rhs: TypedExpr = typed_expr_at(ctx, expression.rhs)
        if lhs.kind == TypedExprKind.Name and c_type_pointer_optional(lhs.type_name) and typed_expr_is_null_value(ctx, expression.rhs):
            return lhs.text
        if rhs.kind == TypedExprKind.Name and c_type_pointer_optional(rhs.type_name) and typed_expr_is_null_value(ctx, expression.lhs):
            return rhs.text
        return sview("", 0, 0)
