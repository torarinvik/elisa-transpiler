                candidate <- index
        return candidate
    def typed_external_global_index[@r](ctx: TypedContext[r]&, name: sview) -> i64:
        for index in 0..<ctx.extern_globals.count |ctx, name|:
            if sview_eq(ctx.extern_globals[index].name, name) or sview_eq(ctx.extern_globals[index].link_name, name):
                return index
        return -1

    def external_runtime_collision_name(name: sview) -> sview:
        # Keep this policy in one resolver. The runtime currently owns the
        # `memset` ABI; more runtime-owned names can be added here without
        # scattering special cases through expression lowering.
        return sview("c_memset", 0, -1) if sview_eq(name, sview("memset", 0, -1)) else sview("", 0, 0)

    def external_link_name(name: sview) -> sview:
        # Clang exposes calls synthesized by libc/libc++ headers under
        # implementation spellings such as `__builtin_sinf` and
        # `__libcpp_wcschr`. Those are wrappers around ordinary C library
        # symbols, not symbols that a linker can resolve literally. Keep true
        # compiler intrinsics out of this normalization list: they are lowered
        # as expressions or need a dedicated compatibility implementation.
        return name if sview_eq(name, sview("__builtin_expect", 0, -1)) or sview_eq(name, sview("__builtin_object_size", 0, -1)) or sview_eq(name, sview("__builtin_add_overflow", 0, -1)) or sview_eq(name, sview("__builtin_mul_overflow", 0, -1)) or sview_eq(name, sview("__builtin_bswap32", 0, -1)) or sview_eq(name, sview("__builtin_clz", 0, -1)) else string_view_suffix(name, 10) if sview_starts_with(name, sview("__builtin_", 0, -1)) else string_view_suffix(name, 9) if sview_starts_with(name, sview("__libcpp_", 0, -1)) else name

    def external_binding_name(name: sview) -> sview:
        runtime_name: sview = external_runtime_collision_name(name)
        return runtime_name if runtime_name.len > 0 else safe_identifier(name)
    def external_declaration_link_name[@r](name: sview, declaration: JsonValueHandle[r]) -> sview @r:
        return external_link_name(name) if sview_starts_with(name, sview("__builtin_", 0, -1)) or sview_starts_with(name, sview("__libcpp_", 0, -1))
        declared_link_name: sview = ast_function_link_name(declaration)
        return declared_link_name if declared_link_name.len > 0 else external_link_name(name)
    def typed_add_external_global[@r](ctx: mutable TypedContext[r]&, name: sview, type_name: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        return if name.len == 0 or typed_external_global_index(ctx, name) >= 0
        binding_name: sview = external_global_binding_name(name) can Memory.Allocate
        ctx.extern_globals.push(TypedExternGlobal[r]{name: binding_name, link_name: name, type_name: type_name, is_mutable: not c_type_is_const_object(type_name)})
