                break if fallback_ordinal == 0 and sview_eq(c_trim_spaces(parameter_type), sview("void", 0, -1))
                ctx.extern_params.push(TypedParam[r]{name: external_parameter_name(fallback_ordinal), type_name: parameter_type, is_mutable: (c_type_pointer_count(parameter_type) > 0 or c_type_reference_count(parameter_type) > 0) and c_type_pointer_can_write(parameter_type)})
                fallback_ordinal <- fallback_ordinal + 1
        variadic: bool = ast_bool(ast_field(declaration, sview("variadic", 0, -1))) if not json_handle_is_null(declaration) else sview_find_byte(function_type, 46) >= 0
        result_type: sview = typed_resolve_type_aliases(ctx, c_function_return_type(function_type)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        ctx.externs.push(TypedExtern[r]{name: external_binding_name(name), link_name: external_declaration_link_name(name, declaration), declaration_id: declaration_id, return_type: function_type, result_type: result_type, params_start: params_start, params_count: ctx.extern_params.count.i64() - params_start, variadic: variadic})
