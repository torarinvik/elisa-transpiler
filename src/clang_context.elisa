        declaration_id: sview = typed_decl_identity(ctx, referenced)
        resolved: JsonValueHandle[r] = typed_decl_lookup(ctx, referenced_id) if referenced_id.len > 0 else json_handle_null(ctx.root)
        declaration <- resolved if not json_handle_is_null(resolved)
        declaration <- ast_find_function_with_named_parameters(ctx.root, name) if json_handle_is_null(declaration)
