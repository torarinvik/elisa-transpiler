        return false

    def external_parameter_name(ordinal: i64) -> sview:
        return sview("parameter_1", 0, -1) if ordinal == 0
        return sview("parameter_2", 0, -1) if ordinal == 1
        return sview("parameter_3", 0, -1) if ordinal == 2
        return sview("parameter_4", 0, -1) if ordinal == 3
        return sview("parameter_5", 0, -1) if ordinal == 4
        return sview("parameter_6", 0, -1) if ordinal == 5
        return sview("parameter_7", 0, -1) if ordinal == 6
        return sview("parameter_8", 0, -1) if ordinal == 7
        return sview("parameter_9", 0, -1) if ordinal == 8
        return sview("parameter_10", 0, -1) if ordinal == 9
        return sview("parameter", 0, -1)

    def typed_surface_opcode(opcode: sview) -> sview:
        return sview("and", 0, -1) if sview_eq(opcode, sview("&&", 0, -1))
        return sview("or", 0, -1) if sview_eq(opcode, sview("||", 0, -1))
        return opcode
    def typed_callee_name[@r](node: JsonValueHandle[r]) -> sview @r:
        return ast_expr_name(node)
    def ast_callee_is_named_function[@r](node: JsonValueHandle[r]) -> bool:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("DeclRefExpr", 0, -1)):
            referenced: JsonValueHandle[r] = ast_field(node, sview("referencedDecl", 0, -1))
            return sview_eq(ast_kind(referenced), sview("FunctionDecl", 0, -1))
        if sview_eq(kind, sview("ImplicitCastExpr", 0, -1)) or sview_eq(kind, sview("ParenExpr", 0, -1)) or sview_eq(kind, sview("CStyleCastExpr", 0, -1)) or sview_eq(kind, sview("ConstantExpr", 0, -1)):
            return ast_child_count(node) > 0 and ast_callee_is_named_function(ast_child(node, 0))
        return false
    def ast_callee_referenced_decl[@r](node: JsonValueHandle[r]) -> JsonValueHandle[r]:
        kind: sview = ast_kind(node)
        if sview_eq(kind, sview("DeclRefExpr", 0, -1)):
            return ast_field(node, sview("referencedDecl", 0, -1))
        if sview_eq(kind, sview("ImplicitCastExpr", 0, -1)) or sview_eq(kind, sview("ParenExpr", 0, -1)) or sview_eq(kind, sview("CStyleCastExpr", 0, -1)) or sview_eq(kind, sview("ConstantExpr", 0, -1)):
            return ast_callee_referenced_decl(ast_child(node, 0)) if ast_child_count(node) > 0 else json_handle_null(node)
        return json_handle_null(node)
    def ast_callee_is_header_inline[@r](ctx: TypedContext[r]&, node: JsonValueHandle[r], source: cstr) -> bool:
        referenced: JsonValueHandle[r] = ast_callee_referenced_decl(node)
        identifier: sview = ast_string(ast_field(referenced, sview("id", 0, -1)))
        declaration: JsonValueHandle[r] = typed_decl_lookup(ctx, identifier)
        return not json_handle_is_null(declaration) and not ast_is_static_decl(declaration) and ast_is_header_inline_definition(declaration, source)
    def ast_find_function[@r](node: JsonValueHandle[r], wanted: sview) -> JsonValueHandle[r]:
        if sview_eq(ast_kind(node), sview("FunctionDecl", 0, -1)) and sview_eq(ast_name(node), wanted):
            return node
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                found: JsonValueHandle[r] = ast_find_function(ast_child(node, index), wanted)
                return found if not json_handle_is_null(found)
        return json_handle_null(node)
    def ast_function_has_named_parameters[@r](node: JsonValueHandle[r]) -> bool:
        return false if not sview_eq(ast_kind(node), sview("FunctionDecl", 0, -1))
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                parameter: JsonValueHandle[r] = ast_child(node, index)
                return true if sview_eq(ast_kind(parameter), sview("ParmVarDecl", 0, -1)) and ast_name(parameter).len > 0
        return false
    def ast_find_function_with_named_parameters[@r](node: JsonValueHandle[r], wanted: sview) -> JsonValueHandle[r]:
        if sview_eq(ast_kind(node), sview("FunctionDecl", 0, -1)) and sview_eq(ast_name(node), wanted) and ast_function_has_named_parameters(node):
            return node
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count:
                found: JsonValueHandle[r] = ast_find_function_with_named_parameters(ast_child(node, index), wanted)
                return found if not json_handle_is_null(found)
        return json_handle_null(node)
    def typed_external_index[@r](ctx: TypedContext[r]&, name: sview) -> i64:
        for index in 0..<ctx.externs.count |ctx, name|:
            if sview_eq(ctx.externs[index].name, name) or sview_eq(ctx.externs[index].link_name, name):
                return index
        return -1
    def typed_external_signature_index[@r](ctx: TypedContext[r]&, name: sview, function_type: sview, declaration_id: sview) -> i64:
        return -1 if name.len == 0 or function_type.len == 0
        if declaration_id.len > 0:
            for index in 0..<ctx.externs.count.i64() |ctx, declaration_id|:
                return index if sview_eq(ctx.externs[index.usize()].declaration_id, declaration_id)
            return -1
        normalized: sview = c_type_without_qualifiers(function_type)
        binding_name: sview = external_binding_name(name)
        candidate: mutable i64 = -1
        for index in 0..<ctx.externs.count |ctx, name, normalized, binding_name|:
            external: TypedExtern[r] = ctx.externs[index.usize()]
            if (sview_eq(external.name, binding_name) or sview_eq(external.link_name, name)) and sview_eq(c_type_without_qualifiers(external.return_type), normalized):
