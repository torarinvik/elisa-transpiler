        for index in 0..<ctx.enum_consts.count |ctx, name|:
            constant: TypedEnumConst[r] = ctx.enum_consts[index]
            if sview_eq(constant.name, name):
                return safe_identifier(constant.enum_name)
        return sview("", 0, 0)
    def typed_enum_const_value[@r](ctx: TypedContext[r]&, name: sview) -> i64:
        for index in 0..<ctx.enum_consts.count |ctx, name|:
            constant: TypedEnumConst[r] = ctx.enum_consts[index]
            if sview_eq(constant.name, name):
