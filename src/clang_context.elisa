                parameter: JsonValueHandle[r] = ast_child(declaration, index)
                if sview_eq(ast_kind(parameter), sview("ParmVarDecl", 0, -1)):
                    parameter_name: mutable sview = safe_identifier(ast_name(parameter))
                    if parameter_name.len == 0:
                        parameter_name <- external_parameter_name(ordinal)
                    if ast_name(parameter).len == 0 or sview_eq(parameter_name, sview("arg", 0, -1)):
