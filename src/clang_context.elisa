extend CTranslator:
    def typed_decl_index_empty_slot[@r](owner: JsonValueHandle[r]) -> TypedDeclIndexSlot[r]:
        return TypedDeclIndexSlot[r]{id: sview("", 0, 0), previous_id: sview("", 0, 0), canonical_id: sview("", 0, 0), declaration: json_handle_null(owner), complete_record: json_handle_null(owner)}
    def typed_decl_index_place[@r](ctx: mutable TypedContext[r]&, entry: TypedDeclIndexSlot[r]) -> void:
        capacity: usize = ctx.declaration_index.count.usize()
        return if capacity == 0 or entry.id.len == 0
        mask: usize = capacity - 1.usize()
        slot: mutable usize = hash_sview(entry.id).usize() & mask
        remaining: mutable usize = capacity
        while remaining > 0:
            existing: mutable TypedDeclIndexSlot[r] = ctx.declaration_index[slot]
            if existing.id.len == 0:
                ctx.declaration_index[slot] <- entry
                ctx.declaration_index_count <- ctx.declaration_index_count + 1
                return
            if sview_eq(existing.id, entry.id):
                if json_handle_is_null(existing.complete_record) and not json_handle_is_null(entry.complete_record):
                    existing.complete_record <- entry.complete_record
                    ctx.declaration_index[slot] <- existing
                return
            slot <- (slot + 1.usize()) & mask
            remaining <- remaining - 1.usize()
    def typed_decl_index_grow[@r](ctx: mutable TypedContext[r]&) -> void can[Memory.Allocate, Abort.Panic]:
        old_entries: mutable darray[TypedDeclIndexSlot[r]] = ctx.declaration_index
        old_capacity: usize = old_entries.count.usize()
        new_capacity: usize = 64.usize() if old_capacity == 0 else old_capacity * 2.usize()
        ctx.declaration_index <- []
        for index in 0..<new_capacity |ctx|:
            ctx.declaration_index.push(typed_decl_index_empty_slot(ctx.root))
        ctx.declaration_index_count <- 0
        if old_capacity > 0:
            for index in 0..<old_capacity |ctx, old_entries|:
                entry: TypedDeclIndexSlot[r] = old_entries[index]
                typed_decl_index_place(ctx, entry) if entry.id.len > 0
    def typed_decl_index_find_slot[@r](ctx: TypedContext[r]&, wanted: sview) -> i64:
        capacity: usize = ctx.declaration_index.count.usize()
        return -1 if capacity == 0 or wanted.len == 0
        mask: usize = capacity - 1.usize()
        slot: mutable usize = hash_sview(wanted).usize() & mask
        remaining: mutable usize = capacity
        while remaining > 0:
            entry: TypedDeclIndexSlot[r] = ctx.declaration_index[slot]
            return -1 if entry.id.len == 0
            return slot.i64() if sview_eq(entry.id, wanted)
            slot <- (slot + 1.usize()) & mask
            remaining <- remaining - 1.usize()
        return -1
    def typed_decl_index_add[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r]) -> void can[Memory.Allocate, Abort.Panic]:
        identifier: sview = ast_string(ast_field(node, sview("id", 0, -1)))
        return if identifier.len == 0
        capacity: usize = ctx.declaration_index.count.usize()
        typed_decl_index_grow(ctx) can Memory.Allocate, Abort.Panic if capacity == 0 or (ctx.declaration_index_count + 1).usize() * 2.usize() >= capacity
        previous_id: sview = ast_string(ast_field(node, sview("previousDecl", 0, -1)))
        canonical_id: mutable sview = identifier
        previous_slot: i64 = typed_decl_index_find_slot(ctx, previous_id) if previous_id.len > 0 else -1
        if previous_slot >= 0:
            previous: TypedDeclIndexSlot[r] = ctx.declaration_index[previous_slot.usize()]
            canonical_id <- previous.canonical_id if previous.canonical_id.len > 0
        elif previous_id.len > 0:
            canonical_id <- previous_id
        kind: sview = ast_kind(node)
        is_record: bool = sview_eq(kind, sview("RecordDecl", 0, -1)) or sview_eq(kind, sview("CXXRecordDecl", 0, -1)) or sview_eq(kind, sview("ClassTemplateSpecializationDecl", 0, -1))
        complete_record: JsonValueHandle[r] = node if is_record and ast_child_count(node) > 0 else json_handle_null(node)
        typed_decl_index_place(ctx, TypedDeclIndexSlot[r]{id: identifier, previous_id: previous_id, canonical_id: canonical_id, declaration: node, complete_record: complete_record})
    def typed_decl_index_collect[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r]) -> void can[Memory.Allocate, Abort.Panic]:
        typed_decl_index_add(ctx, node) can Memory.Allocate, Abort.Panic
        count: i64 = ast_child_count(node)
        if count >= 0:
            for index in 0..<count |ctx, node|:
                typed_decl_index_collect(ctx, ast_child(node, index)) can Memory.Allocate, Abort.Panic
    def typed_decl_index_build[@r](ctx: mutable TypedContext[r]&, root: JsonValueHandle[r]) -> void can[Memory.Allocate, Abort.Panic]:
        typed_decl_index_grow(ctx) can Memory.Allocate, Abort.Panic
        typed_decl_index_collect(ctx, root) can Memory.Allocate, Abort.Panic
        # Resolve links whose preceding declaration was not in traversal order.
        for index in 0..<ctx.declaration_index.count.i64() |ctx|:
            entry: mutable TypedDeclIndexSlot[r] = ctx.declaration_index[index.usize()]
            continue if entry.id.len == 0 or entry.previous_id.len == 0
            previous_slot: i64 = typed_decl_index_find_slot(ctx, entry.previous_id)
            if previous_slot >= 0:
                previous: TypedDeclIndexSlot[r] = ctx.declaration_index[previous_slot.usize()]
                entry.canonical_id <- previous.canonical_id if previous.canonical_id.len > 0
                ctx.declaration_index[index.usize()] <- entry
    def typed_decl_lookup[@r](ctx: TypedContext[r]&, wanted: sview) -> JsonValueHandle[r]:
        slot: i64 = typed_decl_index_find_slot(ctx, wanted)
        return json_handle_null(ctx.root) if slot < 0
        return ctx.declaration_index[slot.usize()].declaration
    def typed_record_lookup[@r](ctx: TypedContext[r]&, wanted: sview) -> JsonValueHandle[r]:
        slot: i64 = typed_decl_index_find_slot(ctx, wanted)
        return json_handle_null(ctx.root) if slot < 0
        return ctx.declaration_index[slot.usize()].complete_record
    def typed_decl_canonical_id[@r](ctx: TypedContext[r]&, wanted: sview) -> sview @r:
        slot: i64 = typed_decl_index_find_slot(ctx, wanted)
        return sview("", 0, 0) if slot < 0
        return ctx.declaration_index[slot.usize()].canonical_id
    def typed_decl_identity[@r](ctx: TypedContext[r]&, node: JsonValueHandle[r]) -> sview @r:
        identifier: sview = ast_string(ast_field(node, sview("id", 0, -1)))
        return sview("", 0, 0) if identifier.len == 0
        canonical: sview = typed_decl_canonical_id(ctx, identifier)
        return canonical if canonical.len > 0 else identifier
    def typed_find_type_decl_id_through_alias[@r](ctx: TypedContext[r]&, node: JsonValueHandle[r], wanted: sview) -> sview @r:
        direct: sview = ast_find_type_decl_id(node, wanted)
        return direct if direct.len > 0
        type_view: ClangTypeView[r] = clang_type_view_of_decl(node)
        alias_id: sview = type_view.type_alias_decl_id
        return sview("", 0, 0) if alias_id.len == 0
        alias: JsonValueHandle[r] = typed_decl_lookup(ctx, alias_id)
        return sview("", 0, 0) if json_handle_is_null(alias)
        return typed_find_type_decl_id_through_alias(ctx, alias, wanted)
    def ast_is_extern_decl[@r](node: JsonValueHandle[r]) -> bool:
        return sview_eq(ast_string(ast_field(node, sview("storageClass", 0, -1))), sview("extern", 0, -1))
    def ast_location_line[@r](node: JsonValueHandle[r]) -> i64:
        location: JsonValueHandle[r] = ast_field(node, sview("loc", 0, -1))
        line: mutable i64 = typed_number(ast_field(location, sview("line", 0, -1)))
        return line if line > 0
        range: JsonValueHandle[r] = ast_field(node, sview("range", 0, -1))
        begin: JsonValueHandle[r] = ast_field(range, sview("begin", 0, -1))
        line <- typed_number(ast_field(ast_field(begin, sview("expansionLoc", 0, -1)), sview("line", 0, -1)))
        return line if line > 0
        line <- typed_number(ast_field(ast_field(begin, sview("spellingLoc", 0, -1)), sview("line", 0, -1)))
        return line if line > 0
        return typed_number(ast_field(begin, sview("line", 0, -1)))
    def ast_location_column[@r](node: JsonValueHandle[r]) -> i64:
        location: JsonValueHandle[r] = ast_field(node, sview("loc", 0, -1))
        column: mutable i64 = typed_number(ast_field(location, sview("col", 0, -1)))
        return column if column > 0
        range: JsonValueHandle[r] = ast_field(node, sview("range", 0, -1))
        begin: JsonValueHandle[r] = ast_field(range, sview("begin", 0, -1))
        column <- typed_number(ast_field(ast_field(begin, sview("expansionLoc", 0, -1)), sview("col", 0, -1)))
        return column if column > 0
        column <- typed_number(ast_field(ast_field(begin, sview("spellingLoc", 0, -1)), sview("col", 0, -1)))
        return column if column > 0
        return typed_number(ast_field(begin, sview("col", 0, -1)))

    def typed_diagnostic_source_identity_equal(left: sview, left_canonical: sview, right: sview, right_canonical: sview) -> bool:
        return sview_eq(left_canonical, right_canonical) if left_canonical.len > 0 and right_canonical.len > 0
        return sview_eq(left, right)

    def typed_record_diagnostic_with_capability[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], category: sview, kind: sview, required_capability: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        range_start_offset: i64 = ast_range_endpoint_offset(node, sview("begin", 0, -1), false)
        line: mutable i64 = ast_location_line(node)
        line_source_view: mutable sview = ast_location_source_file(node)
        line_source_view <- ctx.current_function_source if line_source_view.len == 0 and ctx.current_function_source.len > 0
        line_source_view <- sview(ctx.source, 0, -1) if line_source_view.len == 0
        if line <= 0 and range_start_offset >= 0:
            line <- typed_source_line_for_offset(ctx, line_source_view, range_start_offset) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast
        column: i64 = ast_location_column(node)
        subject_type_view: sview = ast_qual_type(node)
        spelling_line: i64 = ast_macro_origin_coordinate(node, sview("spellingLoc", 0, -1), sview("line", 0, -1))
        spelling_column: i64 = ast_macro_origin_coordinate(node, sview("spellingLoc", 0, -1), sview("col", 0, -1))
        expansion_line: i64 = ast_macro_origin_coordinate(node, sview("expansionLoc", 0, -1), sview("line", 0, -1))
        expansion_column: i64 = ast_macro_origin_coordinate(node, sview("expansionLoc", 0, -1), sview("col", 0, -1))
        range_end_offset: i64 = ast_range_endpoint_offset(node, sview("end", 0, -1), true)
        spelling_origin: JsonValueHandle[r] = ast_macro_origin_location(node, sview("spellingLoc", 0, -1))
        expansion_origin: JsonValueHandle[r] = ast_macro_origin_location(node, sview("expansionLoc", 0, -1))
        translation_source_view: sview = sview(ctx.source, 0, -1)
        source_view: mutable sview = ast_location_source_file(node)
        source_view <- ctx.current_function_source if source_view.len == 0 and ctx.current_function_source.len > 0
        source_view <- translation_source_view if source_view.len == 0
        spelling_source_view: mutable sview = ast_string(ast_field(spelling_origin, sview("file", 0, -1)))
        expansion_source_view: mutable sview = ast_string(ast_field(expansion_origin, sview("file", 0, -1)))
        spelling_included_from_view: sview = ast_macro_origin_included_from(node, sview("spellingLoc", 0, -1))
        expansion_included_from_view: sview = ast_macro_origin_included_from(node, sview("expansionLoc", 0, -1))
        spelling_source_view <- source_view if spelling_source_view.len == 0 and spelling_line > 0
        expansion_source_view <- source_view if expansion_source_view.len == 0 and expansion_line > 0
        primary_source_view: sview = expansion_source_view if expansion_line > 0 and expansion_source_view.len > 0 else source_view
        spelling_canonical_view: mutable sview = sview("", 0, 0)
        expansion_canonical_view: mutable sview = sview("", 0, 0)
        source_canonical_view: mutable sview = sview("", 0, 0)
        spelling_included_from_canonical_view: mutable sview = sview("", 0, 0)
        expansion_included_from_canonical_view: mutable sview = sview("", 0, 0)
        source_canonical_view <- ctx.canonical_source if source_view.len > 0 and sview_eq(source_view, translation_source_view)
        spelling_canonical_view <- ctx.canonical_source if spelling_source_view.len > 0 and sview_eq(spelling_source_view, translation_source_view)
        expansion_canonical_view <- ctx.canonical_source if expansion_source_view.len > 0 and sview_eq(expansion_source_view, translation_source_view)
        spelling_included_from_canonical_view <- ctx.canonical_source if spelling_included_from_view.len > 0 and sview_eq(spelling_included_from_view, translation_source_view)
        expansion_included_from_canonical_view <- ctx.canonical_source if expansion_included_from_view.len > 0 and sview_eq(expansion_included_from_view, translation_source_view)
        for existing in ctx.diagnostics |ctx, source_view, source_canonical_view, spelling_source_view, expansion_source_view, spelling_canonical_view, expansion_canonical_view, spelling_included_from_view, expansion_included_from_view, spelling_included_from_canonical_view, expansion_included_from_canonical_view|:
            if source_canonical_view.len == 0 and source_view.len > 0:
                if sview_eq(existing.source, source_view):
                    source_canonical_view <- existing.canonical_source
                elif sview_eq(existing.spelling_source, source_view):
                    source_canonical_view <- existing.spelling_canonical_source
                elif sview_eq(existing.expansion_source, source_view):
                    source_canonical_view <- existing.expansion_canonical_source
            if spelling_canonical_view.len == 0 and spelling_source_view.len > 0:
                if sview_eq(existing.spelling_source, spelling_source_view):
                    spelling_canonical_view <- existing.spelling_canonical_source
                elif sview_eq(existing.expansion_source, spelling_source_view):
                    spelling_canonical_view <- existing.expansion_canonical_source
                elif sview_eq(existing.source, spelling_source_view):
                    spelling_canonical_view <- existing.canonical_source
            if expansion_canonical_view.len == 0 and expansion_source_view.len > 0:
                if sview_eq(existing.spelling_source, expansion_source_view):
                    expansion_canonical_view <- existing.spelling_canonical_source
                elif sview_eq(existing.expansion_source, expansion_source_view):
                    expansion_canonical_view <- existing.expansion_canonical_source
                elif sview_eq(existing.source, expansion_source_view):
                    expansion_canonical_view <- existing.canonical_source
            if spelling_included_from_canonical_view.len == 0 and spelling_included_from_view.len > 0:
                if sview_eq(existing.spelling_included_from, spelling_included_from_view):
                    spelling_included_from_canonical_view <- existing.spelling_included_from_canonical
                elif sview_eq(existing.expansion_included_from, spelling_included_from_view):
                    spelling_included_from_canonical_view <- existing.expansion_included_from_canonical
                elif sview_eq(existing.spelling_source, spelling_included_from_view):
                    spelling_included_from_canonical_view <- existing.spelling_canonical_source
                elif sview_eq(existing.expansion_source, spelling_included_from_view):
                    spelling_included_from_canonical_view <- existing.expansion_canonical_source
                elif sview_eq(existing.source, spelling_included_from_view):
                    spelling_included_from_canonical_view <- existing.canonical_source
            if expansion_included_from_canonical_view.len == 0 and expansion_included_from_view.len > 0:
                if sview_eq(existing.spelling_included_from, expansion_included_from_view):
                    expansion_included_from_canonical_view <- existing.spelling_included_from_canonical
                elif sview_eq(existing.expansion_included_from, expansion_included_from_view):
                    expansion_included_from_canonical_view <- existing.expansion_included_from_canonical
                elif sview_eq(existing.spelling_source, expansion_included_from_view):
                    expansion_included_from_canonical_view <- existing.spelling_canonical_source
                elif sview_eq(existing.expansion_source, expansion_included_from_view):
                    expansion_included_from_canonical_view <- existing.expansion_canonical_source
                elif sview_eq(existing.source, expansion_included_from_view):
                    expansion_included_from_canonical_view <- existing.canonical_source
        # Reuse a canonical identity already computed for an equal path before
        # asking the filesystem resolver to canonicalize it again.
        source_canonical_view <- typed_canonical_source_path(source_view, ctx.source_working_directory) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast if source_view.len > 0 and source_canonical_view.len == 0
        spelling_canonical_view <- typed_canonical_source_path(spelling_source_view, ctx.source_working_directory) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast if spelling_source_view.len > 0 and spelling_canonical_view.len == 0
        expansion_canonical_view <- typed_canonical_source_path(expansion_source_view, ctx.source_working_directory) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast if expansion_source_view.len > 0 and expansion_canonical_view.len == 0
        spelling_included_from_canonical_view <- typed_canonical_source_path(spelling_included_from_view, ctx.source_working_directory) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast if spelling_included_from_view.len > 0 and spelling_included_from_canonical_view.len == 0
        expansion_included_from_canonical_view <- typed_canonical_source_path(expansion_included_from_view, ctx.source_working_directory) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast if expansion_included_from_view.len > 0 and expansion_included_from_canonical_view.len == 0
        primary_canonical_view: sview = expansion_canonical_view if expansion_line > 0 and expansion_source_view.len > 0 else source_canonical_view
        hashes: TypedDiagnosticHashes = typed_cached_diagnostic_hashes(ctx, ctx.canonical_source, primary_source_view, spelling_source_view, spelling_included_from_view, expansion_source_view, expansion_included_from_view) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
        for existing in ctx.diagnostics |ctx, category, kind, subject_type_view, required_capability, range_start_offset, range_end_offset, line, column, spelling_source_view, expansion_source_view, primary_source_view, spelling_included_from_view, expansion_included_from_view, hashes|:
            same_primary: bool = typed_diagnostic_source_identity_equal(existing.source, existing.canonical_source, primary_source_view, primary_canonical_view)
            same_spelling: bool = typed_diagnostic_source_identity_equal(existing.spelling_source, existing.spelling_canonical_source, spelling_source_view, spelling_canonical_view)
            same_expansion: bool = typed_diagnostic_source_identity_equal(existing.expansion_source, existing.expansion_canonical_source, expansion_source_view, expansion_canonical_view)
            same_spelling_include: bool = typed_diagnostic_source_identity_equal(existing.spelling_included_from, existing.spelling_included_from_canonical, spelling_included_from_view, spelling_included_from_canonical_view)
            same_expansion_include: bool = typed_diagnostic_source_identity_equal(existing.expansion_included_from, existing.expansion_included_from_canonical, expansion_included_from_view, expansion_included_from_canonical_view)
            return if sview_eq(existing.category, category) and sview_eq(existing.kind, kind) and sview_eq(existing.subject_type, subject_type_view) and sview_eq(existing.required_capability, required_capability) and sview_eq(existing.translation_unit, ctx.canonical_source) and typed_content_hash_equal(existing.translation_unit_content_hash, hashes.translation_unit) and typed_content_hash_equal(existing.source_content_hash, hashes.source) and typed_content_hash_equal(existing.spelling_source_content_hash, hashes.spelling_source) and typed_content_hash_equal(existing.spelling_included_from_content_hash, hashes.spelling_included_from) and typed_content_hash_equal(existing.expansion_source_content_hash, hashes.expansion_source) and typed_content_hash_equal(existing.expansion_included_from_content_hash, hashes.expansion_included_from) and existing.range_start_offset == range_start_offset and existing.range_end_offset == range_end_offset and same_primary and same_spelling and same_expansion and same_spelling_include and same_expansion_include and existing.line == line and existing.column == column and existing.spelling_line == spelling_line and existing.spelling_column == spelling_column and existing.expansion_line == expansion_line and existing.expansion_column == expansion_column
        category_copy: sview @r = typed_copy_view_to_region(category) can Memory.Allocate, Abort.Panic
        kind_copy: sview @r = typed_copy_view_to_region(kind) can Memory.Allocate, Abort.Panic
        subject_type_copy: sview @r = typed_copy_view_to_region(subject_type_view) can Memory.Allocate, Abort.Panic
        required_capability_copy: sview @r = typed_copy_view_to_region(required_capability) can Memory.Allocate, Abort.Panic
        source_copy: sview @r = typed_copy_view_to_region(primary_source_view) can Memory.Allocate, Abort.Panic
        canonical_source_copy: sview @r = typed_copy_view_to_region(primary_canonical_view) can Memory.Allocate, Abort.Panic
        spelling_source_copy: sview @r = typed_copy_view_to_region(spelling_source_view) can Memory.Allocate, Abort.Panic
        spelling_canonical_source_copy: sview @r = typed_copy_view_to_region(spelling_canonical_view) can Memory.Allocate, Abort.Panic
        spelling_included_from_copy: sview @r = typed_copy_view_to_region(spelling_included_from_view) can Memory.Allocate, Abort.Panic
        spelling_included_from_canonical_copy: sview @r = typed_copy_view_to_region(spelling_included_from_canonical_view) can Memory.Allocate, Abort.Panic
        expansion_source_copy: sview @r = typed_copy_view_to_region(expansion_source_view) can Memory.Allocate, Abort.Panic
        expansion_canonical_source_copy: sview @r = typed_copy_view_to_region(expansion_canonical_view) can Memory.Allocate, Abort.Panic
        expansion_included_from_copy: sview @r = typed_copy_view_to_region(expansion_included_from_view) can Memory.Allocate, Abort.Panic
        expansion_included_from_canonical_copy: sview @r = typed_copy_view_to_region(expansion_included_from_canonical_view) can Memory.Allocate, Abort.Panic
        translation_unit_copy: sview @r = typed_copy_view_to_region(ctx.canonical_source) can Memory.Allocate, Abort.Panic
        ctx.diagnostics.push(TypedDiagnostic{category: category_copy, kind: kind_copy, subject_type: subject_type_copy, required_capability: required_capability_copy, translation_unit: translation_unit_copy, translation_unit_content_hash: hashes.translation_unit, source: source_copy, canonical_source: canonical_source_copy, source_content_hash: hashes.source, spelling_source: spelling_source_copy, spelling_canonical_source: spelling_canonical_source_copy, spelling_source_content_hash: hashes.spelling_source, spelling_included_from: spelling_included_from_copy, spelling_included_from_canonical: spelling_included_from_canonical_copy, spelling_included_from_content_hash: hashes.spelling_included_from, expansion_source: expansion_source_copy, expansion_canonical_source: expansion_canonical_source_copy, expansion_source_content_hash: hashes.expansion_source, expansion_included_from: expansion_included_from_copy, expansion_included_from_canonical: expansion_included_from_canonical_copy, expansion_included_from_content_hash: hashes.expansion_included_from, range_start_offset: range_start_offset, range_end_offset: range_end_offset, line: line, column: column, spelling_line: spelling_line, spelling_column: spelling_column, expansion_line: expansion_line, expansion_column: expansion_column})
    def typed_record_diagnostic[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], category: sview, kind: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        typed_record_diagnostic_with_capability(ctx, node, category, kind, sview("", 0, 0)) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_record_unsupported[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], requested_capability: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        kind: sview = ast_kind(node)
        semantic_category: sview = typed_diagnostic_semantic_category(kind)
        capability: sview = sview("", 0, 0) if sview_eq(requested_capability, sview("expression", 0, -1)) or sview_eq(requested_capability, sview("statement", 0, -1)) or sview_eq(requested_capability, sview("declaration", 0, -1)) else requested_capability
        typed_record_diagnostic_with_capability(ctx, node, semantic_category, kind, capability) can Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console
    def typed_record_missing_declaration_dependency[@r](ctx: mutable TypedContext[r]&, node: JsonValueHandle[r], name: sview) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
        kind: mutable darray[u8] = []
        append_view(&kind, sview("missing-declaration-dependency:", 0, -1))
        if ctx.current_function_name.len > 0:
